---
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
import CustomCursor from '../components/CustomCursor.astro';
import LenisSmoothScroll from '../components/LenisSmoothScroll.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import { getCollection } from 'astro:content';

const siteContent = (await getCollection('site'))[0]?.data;

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content="Mihail Mihaylov — director and editor based in Sofia, Bulgaria. DaVinci Resolve post-production, camera work, and documentary filmmaking.">
<!-- Google tag (gtag.js) --><script async src="https://www.googletagmanager.com/gtag/js?id=G-GZMPLW7CNY"></script>
<script>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-GZMPLW7CNY');</script>
<ClientRouter />
<link rel="icon" type="image/png" href="/logo.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800;900&family=Newsreader:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style is:global>

  :root{
    --ink:#1C1614;
    --ink-2:#251E1A;
    --oxblood:#B23A2E;
    --oxblood-dim:#7A2A21;
    --brass:#D4A24C;
    --ecru:#EFE6D8;
    --ash:#A99C8F;

    --font-display:'Unbounded', system-ui, sans-serif;
    --font-body:'Newsreader', Georgia, serif;
    --font-mono:'IBM Plex Mono', 'SFMono-Regular', Menlo, monospace;

    --sp-1:.5rem; --sp-2:1rem; --sp-3:1.75rem; --sp-4:3rem; --sp-5:5rem; --sp-6:7.5rem;
  }

  *,*::before,*::after{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0; background:var(--ink); color:var(--ecru);
    font-family:var(--font-body); font-size:1rem; line-height:1.65;
    -webkit-font-smoothing:antialiased;
    position: relative;
  }
  /* grain — subtle film texture (REVERT: opacity 0.035, single layer) */
  body::before{
    content:"";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.028;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }
  /* experimental second grain layer — faint halftone dots, remove to revert */
  body::after{
    content:"";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.032;
    background:
      radial-gradient(ellipse at 50% 0%, transparent 58%, rgba(0,0,0,0.22) 100%),
      radial-gradient(circle at 1px 1px, rgba(239,230,216,0.045) 1px, transparent 0);
    background-size: 100% 100%, 22px 22px;
  }
  main, header, footer { position: relative; z-index: 2; }

  img{max-width:100%; display:block;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none; margin:0; padding:0;}
  h1,h2,h3{margin:0;}
  p{margin:0;}
  :focus-visible{outline:2px solid var(--brass); outline-offset:3px;}

  .container{max-width:1180px; margin-inline:auto; padding-inline:clamp(1.25rem,5vw,3rem);}
  .section{padding-block:var(--sp-6);}
  @media (max-width:480px){ .section{padding-block:var(--sp-4); padding-inline:1rem;} }

  .eyebrow{
    font-family:var(--font-mono); text-transform:uppercase; letter-spacing:.16em;
    font-size:.78rem; color:var(--brass); margin-bottom:var(--sp-2); display:block;
  }
  .section h2{
    font-family:var(--font-display); font-weight:800; letter-spacing:-.02em;
    font-size:clamp(1.9rem,4.4vw,2.9rem); line-height:1.08; max-width:16ch;
    margin-bottom:var(--sp-4); color:var(--ecru);
  }

  /* reveal-on-scroll — now driven by GSAP; keep CSS fallback for no-JS */
  .reveal-pending{opacity:0; transform:translateY(22px); transition:opacity .7s ease, transform .7s ease;}
  .reveal-visible{opacity:1; transform:translateY(0);}
  /* GSAP will set autoAlpha; ensure no FOUC */
  [data-reveal]{ will-change: transform, opacity; }

  /* ---------- header ---------- */
  header{
    position:sticky; top:0; z-index:50;
    background:rgba(28,22,20,.84); backdrop-filter:blur(10px) saturate(1.15);
    border-bottom:1px solid rgba(239,230,216,.1);
  }
  .nav-inner{display:flex; align-items:center; justify-content:space-between; padding-block:1.1rem; flex-wrap:wrap; gap:.75rem;}
  .nav-actions{display:flex; align-items:center; gap:0.75rem;}
  
  .brand-logo { height: 64px; width: auto; object-fit: contain; }
  .footer-logo { height: 48px; width: auto; object-fit: contain; }

  nav[aria-label="Primary"]{display:flex; gap:clamp(1rem,3vw,1.9rem); flex-wrap:wrap;}
  nav[aria-label="Primary"] a{
    font-family:var(--font-mono); font-size:.78rem; letter-spacing:.1em; text-transform:uppercase;
    color:var(--ash); border-bottom:1px solid transparent; padding-bottom:2px; transition:color .2s, border-color .2s;
    position: relative;
  }
  nav[aria-label="Primary"] a::after{
    content:"";
    position: absolute;
    left:0; right:0; bottom:-2px;
    height: 1px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  nav[aria-label="Primary"] a:hover::after{ transform: scaleX(1); transform-origin: left; }
  nav[aria-label="Primary"] a:hover, nav[aria-label="Primary"] a:focus-visible{color:var(--ecru); border-color:transparent;}

  /* ---------- splice strip (signature motif) ---------- */
  .splice-strip{
    display:flex; align-items:center; justify-content:space-between;
    height:26px; overflow:hidden; padding-inline:clamp(1.25rem,5vw,3rem);
    border-block: 1px solid rgba(239,230,216,0.06);
  }
  .splice-strip .cell{flex-shrink:0;}
  .splice-strip .diamond{width:7px; height:7px; background:var(--oxblood); transform:rotate(45deg);}
  .splice-strip .dot{width:4px; height:4px; border-radius:50%; background:var(--brass);}

  /* ---------- hero — interesting per-section wash (revert to transparent to flatten) ---------- */
  .hero{
    position:relative; min-height:92vh; display:flex; flex-direction:column; justify-content:center;
    background:
      radial-gradient(ellipse 820px 420px at 76% 18%, rgba(212,162,76,0.16), transparent 58%),
      radial-gradient(ellipse 620px 380px at 14% 82%, rgba(178,58,46,0.14), transparent 60%),
      radial-gradient(ellipse at 72% 22%, rgba(178,58,46,.12), transparent 58%),
      var(--ink);
    overflow:hidden;
    isolation: isolate;
  }
  .hero::before{
    content:"";
    position:absolute;
    width: 760px; height: 520px;
    left: 62%; top: -10%;
    background: radial-gradient(circle at 50% 50%, rgba(212,162,76,0.19) 0%, rgba(212,162,76,0) 68%);
    filter: blur(18px);
    pointer-events:none;
    z-index:0;
    animation: orbDrift1 18s ease-in-out infinite alternate;
  }
  .hero::after{
    content:"";
    position:absolute;
    width: 680px; height: 680px;
    left: -10%; bottom: -26%;
    background: radial-gradient(circle at 50% 50%, rgba(178,58,46,0.17) 0%, transparent 70%);
    filter: blur(22px);
    pointer-events:none;
    z-index:0;
    animation: orbDrift2 22s ease-in-out infinite alternate;
  }
  @keyframes orbDrift1{ from{ transform: translate(0,0) scale(1)} to{ transform: translate(-28px,16px) scale(1.05)} }
  @keyframes orbDrift2{ from{ transform: translate(0,0) scale(1)} to{ transform: translate(22px,-14px) scale(1.04)} }
  .hero-inner{padding-block:var(--sp-5); position: relative; z-index: 1;}
  .hero .eyebrow{font-size:.85rem; letter-spacing: 0.2em;}
  .hero h1{
    font-family:var(--font-display); font-weight:900; text-transform:uppercase;
    font-size:clamp(3.2rem,11.5vw,8.2rem); line-height:.86; letter-spacing:-.03em; color:var(--ecru);
    margin-block:.32em .42em;
    overflow: clip;
  }
  .hero h1 .line{ display:block; overflow: clip; }
  .hero h1 .line span{ display:block; }
  .hero-sub{
    max-width:48ch; font-size:clamp(1.05rem,2vw,1.28rem); color:var(--ecru); font-style:italic;
    margin-bottom:var(--sp-3);
    border-left: 2px solid var(--oxblood);
    padding-left: 1rem;
  }
  .hero-meta{font-family:var(--font-mono); font-size:.8rem; letter-spacing:.06em; color:var(--ash); text-transform:uppercase;}
  .hero-meta em{ color: var(--brass); font-style: normal; }
  .scroll-cue{position:absolute; bottom:2.2rem; left:clamp(1.25rem,5vw,3rem); width:1px; height:52px; background:rgba(239,230,216,.28);}
  .scroll-cue span{position:absolute; top:0; left:-2px; width:5px; height:5px; border-radius:50%; background:var(--brass); animation:scrollDot 2.4s ease-in-out infinite;}
  @keyframes scrollDot{0%{top:0; opacity:1;} 85%{opacity:1;} 100%{top:47px; opacity:0;}}

  /* velocity marquee — Lando inspired */
  .velocity-bar{
    position: relative;
    overflow: hidden;
    white-space: nowrap;
    border-block: 1px solid rgba(239,230,216,0.08);
    background: var(--ink-2);
    padding-block: 0.9rem;
  }
  .velocity-track{
    display: inline-flex;
    gap: 2.2rem;
    animation: marquee 28s linear infinite;
    will-change: transform;
  }
  .velocity-track span{
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(239,230,216,0.56);
  }
  .velocity-track span b{ color: var(--brass); font-weight: 900; }
  .velocity-track span i{ color: var(--oxblood); font-style: normal; }
  @keyframes marquee{
    from{ transform: translateX(0); }
    to{ transform: translateX(-50%); }
  }

  /* ---------- about — interesting wash ---------- */
  .about-section{
    position:relative; overflow:clip;
    padding-block: calc(var(--sp-6) + 0.5rem);
    background:
      radial-gradient(ellipse 720px 380px at 18% 12%, rgba(212,162,76,0.045), transparent 58%),
      radial-gradient(ellipse 560px 360px at 88% 86%, rgba(178,58,46,0.04), transparent 60%),
      var(--ink);
  }
  .about-section::before{
    content:"ABOUT";
    position:absolute;
    left: 50%; top: 46%;
    transform: translate(-50%,-50%) rotate(-4deg);
    font-family: var(--font-display); font-weight: 900;
    font-size: clamp(6rem, 18vw, 16rem);
    line-height:1; letter-spacing: -0.05em;
    color: transparent; -webkit-text-stroke: 1px rgba(239,230,216,0.045);
    pointer-events:none; user-select:none; white-space:nowrap;
  }
  .about-header{ position:relative; z-index:1; margin-bottom: var(--sp-4); }
  .about-header .eyebrow{ letter-spacing: 0.18em; }
  .about-header h2{
    font-family: var(--font-display); font-weight: 900;
    font-size: clamp(2.6rem, 6.8vw, 5.1rem);
    line-height: 0.88; letter-spacing: -0.04em; text-transform: uppercase;
    color: var(--ecru); max-width: none; margin: 0;
  }
  .about-header h2 span{ display:block; }
  .about-header h2 em{
    font-family: var(--font-body); font-style: italic; font-weight: 400;
    text-transform: none; letter-spacing: -0.02em; color: var(--brass);
    font-size: 0.82em; display:block; margin-top: 0.1em;
  }
  .about-grid{display:grid; grid-template-columns:1.15fr 0.95fr; gap:clamp(2rem,5vw,4rem); align-items:start; position:relative; z-index:1;}
  @media (max-width:480px){ .about-grid{grid-template-columns:1fr; gap:1.5rem;} }
  .about-copy p{margin-bottom:1.15em; max-width:56ch; color:var(--ecru); line-height:1.68;}
  .about-copy p:last-of-type{margin-bottom:0;}
  .about-lead{
    font-size: clamp(1.08rem, 2.1vw, 1.32rem);
    line-height: 1.48; color: var(--ecru); font-style: italic;
    border-left: 3px solid var(--oxblood); padding-left: 1rem;
    margin-bottom: 1.25rem; max-width: 48ch;
  }
  .about-stats{
    display:grid; grid-template-columns: 1.45fr 1fr 1fr;
    gap: 1.2rem; margin-top: var(--sp-3);
    border-top: 1px solid rgba(239,230,216,0.08);
    padding-top: 1rem;
    align-items: end;
  }
  .stat{ border-left: 1px solid var(--oxblood-dim); padding-left: 0.85rem; }
  .stat:first-child{ border-left:none; padding-left:0; }
  .stat:first-child b{
    font-size: clamp(2.0rem, 4vw, 2.7rem); letter-spacing:-0.03em;
  }
  .stat:first-child span{ color: var(--ecru); }
  .stat b{
    display:block; font-family: var(--font-display); font-weight: 800;
    font-size: clamp(1.35rem, 2.6vw, 1.9rem); line-height:1; color: var(--brass); letter-spacing: -0.02em;
  }
  .stat span{
    display:block; margin-top: 0.3rem;
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ash);
  }
  .about-stats-footnote{
    grid-column: 1 / -1;
    margin-top: .6rem; padding-top:.6rem;
    border-top:1px dashed rgba(239,230,216,.08);
    font-family:var(--font-mono); font-size:.64rem; letter-spacing:.06em; text-transform:uppercase; color:var(--ash);
  }
  .about-stats-footnote b{ color:var(--brass); font-weight:700; }
  @media (max-width:560px){ .about-stats{ gap:0.7rem; } .stat b{ font-size: clamp(1.15rem, 4vw, 1.5rem); } .stat span{ font-size:0.60rem; } }
  @media (max-width:380px){ .about-stats{ gap:0.6rem; } .stat{ padding-left:0.6rem; } }
  .about-lang{
    display:inline-flex; align-items:center; gap:0.4rem;
    margin-top:var(--sp-3); font-family:var(--font-mono); font-size:.72rem;
    letter-spacing:.1em; text-transform:uppercase; color:var(--ash);
    border:1px solid var(--oxblood-dim); background: rgba(239,230,216,0.03);
    padding:.45rem .7rem;
  }
  .portrait-panel{
    position:relative; aspect-ratio:4/5; background:var(--ink-2);
    border:1px solid var(--oxblood-dim);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.9rem;
    clip-path:polygon(0 0,100% 0,100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
    overflow:hidden;
  }
  .portrait-panel::after{
    content:"SOFIA • NBU • 2026";
    position:absolute; bottom:10px; right:14px;
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em;
    color: rgba(239,230,216,0.72); background: rgba(28,22,20,0.78);
    border:1px solid rgba(239,230,216,0.12); padding: 2px 6px;
    backdrop-filter: blur(4px);
  }

  /* ---------- work / case card ---------- */
  .case-card{
    background:var(--ink-2); border:1px solid var(--oxblood-dim); padding:clamp(1.5rem,4vw,var(--sp-4));
    clip-path:polygon(0 0,100% 0,100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%);
    margin-bottom: var(--sp-4);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .case-card:hover {
    transform: translateY(-4px);
    border-color: var(--brass);
  }
  
  .case-kicker{font-family:var(--font-mono); font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; color:var(--brass); display:block; margin-bottom:.6rem;}
  .case-title{font-family:var(--font-display); font-weight:700; font-size:clamp(1.5rem,3.6vw,2.2rem); color:var(--ecru); line-height:1.15;}
  .case-title a:hover {color:var(--brass);} 
  .case-title-bg{font-family:var(--font-body); font-style:italic; color:var(--ash); font-size:1rem; margin-top:.3rem;}
  .case-grid{display:grid; grid-template-columns:1fr 1fr; gap:var(--sp-4); margin-top:var(--sp-3); align-items:start;}
  @media (max-width:480px){ .case-grid{grid-template-columns:1fr; gap:1.5rem;} }
  
  .reel-frame{
    position:relative; aspect-ratio:16/9; background:var(--ink);
    border:1px solid rgba(239,230,216,.15);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.85rem;
    overflow:hidden;
  }
  
  .reel-frame img { transition: transform 0.7s cubic-bezier(0.16,1,0.3,1); }
  .case-card:hover .reel-frame img { transform: scale(1.04); }
  .reel-label{font-family:var(--font-mono); font-size:.68rem; letter-spacing:.08em; text-transform:uppercase; color:var(--ash);}
  .case-synopsis{color:var(--ecru); margin-bottom:1.2rem;}

  /* ---------- THE SPLIT (NARRATIVE / COMMERCIAL) ---------- */
  .split-section{
    position: relative;
    padding-block: var(--sp-6);
    border-top: 1px solid rgba(239,230,216,0.08);
  }
  #narrative{
    background:
      linear-gradient(180deg, rgba(212,162,76,0.032), transparent 16%),
      repeating-linear-gradient(90deg, transparent 0 22px, rgba(239,230,216,0.012) 22px 23px),
      var(--ink);
  }
  #commercial{
    background:
      radial-gradient(ellipse 720px 360px at 20% 4%, rgba(212,162,76,0.055), transparent 58%),
      radial-gradient(ellipse 560px 420px at 92% 88%, rgba(178,58,46,0.05), transparent 60%),
      var(--ink) !important;
  }
  #archive .horizontal-section,
  #archive .gallery-stage{
    background: var(--ink) !important;
  }
  #craft{
    background:
      radial-gradient(ellipse 560px 280px at 12% 14%, rgba(212,162,76,0.048), transparent 58%),
      repeating-linear-gradient(-8deg, transparent 0 18px, rgba(239,230,216,0.012) 18px 19px),
      var(--ink);
    border-top: 1px solid rgba(239,230,216,0.07);
  }
  #craft .craft-primary{
    background: rgba(37,30,26,0.72);
    backdrop-filter: blur(6px);
  }
  #contact{
    background:
      radial-gradient(ellipse 820px 420px at 88% 18%, rgba(178,58,46,0.11), transparent 58%),
      radial-gradient(ellipse 600px 320px at 8% 88%, rgba(212,162,76,0.072), transparent 60%),
      radial-gradient(ellipse at 50% 100%, rgba(239,230,216,0.04), transparent 45%),
      var(--ink);
    border-top: 1px solid rgba(239,230,216,0.07);
  }
  #contact h2{
    text-shadow: 0 0 32px rgba(178,58,46,0.18);
  }
  .split-label{
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: var(--sp-4);
    border-bottom: 1px solid rgba(239,230,216,0.12);
    padding-bottom: 1rem;
  }
  .split-label h2{
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    letter-spacing: -0.03em;
    line-height: 0.9;
    text-transform: uppercase;
    margin: 0;
    flex: 1;
  }
  .split-label h2 em{
    font-style: normal;
    color: var(--oxblood);
  }
  .split-count{
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .split-count b{ color: var(--brass); }

  .narrative-list{
    display: grid;
    gap: var(--sp-2);
  }
  .narrative-row{
    display: grid;
    grid-template-columns: 88px 1fr auto;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: start;
    padding: var(--sp-3) var(--sp-2);
    background: var(--ink-2);
    border: 1px solid var(--oxblood-dim);
    border-radius: 0;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
    transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    cursor: pointer;
  }
  .narrative-row:hover{
    border-color: var(--brass);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.3), 0 0 0 1px rgba(212,162,76,0.15);
    background: rgba(37,30,26,0.95);
  }
  .narrative-row:last-child{ border-bottom: 1px solid var(--oxblood-dim); }
  .narrative-row:has(.narrative-thumb:hover){
    transform: none;
    box-shadow: none;
  }

  .narrative-index{
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash);
    letter-spacing: 0.1em;
  }
  .narrative-index b{
    display: block;
    font-size: 1.45rem;
    color: var(--brass);
    line-height: 1;
    margin-bottom: 0.25rem;
  }
  .narrative-main h3{
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--ecru);
  }
  .narrative-main h3 a:hover{ color: var(--brass); }
  .narrative-meta{
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
    margin-top: 0.35rem;
  }
  .narrative-meta b{ color: var(--brass); font-weight: 500; }
  .narrative-thumb{
    width: clamp(210px, 22vw, 300px); aspect-ratio: 16/9; overflow: hidden;
    border: 1px solid rgba(239,230,216,0.14);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
    position: relative;
    background: var(--ink-2);
    flex-shrink: 0;
    z-index: 2;
  }
  .narrative-thumb img{
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), filter 0.4s ease;
    filter: saturate(0.9) contrast(1.05);
  }
  .narrative-row:hover .narrative-thumb img{ transform: scale(1.04); }
  .narrative-thumb:hover img{ transform: scale(1.08); filter: saturate(1) contrast(1.1); }
  .narrative-thumb:hover{ border-color: var(--brass); z-index: 3; }
  
  .play-overlay{
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    background: rgba(28,22,20,0.5);
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .narrative-thumb:hover .play-overlay{ opacity: 1; }
  .play-overlay svg{ transform: scale(0.9); transition: transform 0.3s cubic-bezier(0.16,1,0.3,1); }
  .narrative-thumb:hover .play-overlay svg{ transform: scale(1); }
  @media (max-width: 880px){
    .narrative-thumb{ width: clamp(170px, 28vw, 240px); }
  }
  @media (max-width: 640px){
    .narrative-row{ grid-template-columns: 64px 1fr auto; gap:0.9rem; padding:1rem 0.9rem; }
    .narrative-thumb{ width: 120px; }
    .narrative-main h3{ font-size: clamp(1.15rem, 4vw, 1.5rem); }
  }
  @media (max-width: 440px){
    .narrative-row{ gap:0.4rem; padding:0.6rem 0.5rem; }
    .narrative-thumb{ width:60px; }
    .narrative-index b{ font-size:0.88rem; }
  }

  .commercial-grid{
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--sp-4);
    align-items: stretch;
  }
  @media (max-width: 480px){ .commercial-grid{ grid-template-columns: 1fr; gap:1.5rem; } }

  .commercial-card{
    display: flex;
    flex-direction: column;
    background: var(--ink-2);
    border: 1px solid var(--oxblood-dim);
    padding: clamp(1.4rem, 3vw, 2rem);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .commercial-card:hover{ border-color: var(--brass); transform: translateY(-3px); }
  .commercial-card h3{
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--ecru);
    line-height: 1.1;
  }
  .commercial-card .role{
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass);
    margin: 0.35rem 0 1rem;
    display: block;
  }
  .commercial-card .desc{
    color: var(--ash);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 38ch;
    flex: 0 0 auto;
  }
  .commercial-card .mini-grid{
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(148px, 1fr));
    gap: 0.8rem;
    margin-top: auto;
    padding-top: 1.2rem;
    align-items: start;
  }
  /* When 3 items (7Arts) — force 3-col on wide, no orphan half-cell */
  @media (min-width: 520px){
    .commercial-card .mini-grid:has(> :nth-child(3):last-child){
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .commercial-card .mini-item{ display:flex; flex-direction:column; min-width:0; }
  .commercial-card .mini-thumb{
    aspect-ratio: 16/10; overflow: hidden;
    border: 1px solid rgba(239,230,216,0.14);
    position: relative;
  }
  .commercial-card .mini-thumb.is-vertical{ aspect-ratio: 9/16; }
  .commercial-card .mini-thumb img{
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.55s cubic-bezier(0.16,1,0.3,1);
  }
  .commercial-card .mini-thumb:hover img{ transform: scale(1.05); }
  .commercial-card .mini-label{
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    margin-top: 0.35rem;
    display: block;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* ---------- work experience / slides ---------- */
  .exp-card {
    background: var(--ink-2);
    border: 1px solid var(--oxblood-dim);
    padding: clamp(1.5rem, 4vw, var(--sp-4));
    margin-bottom: var(--sp-4);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 30px), calc(100% - 30px) 100%, 0 100%);
  }
  .exp-header {
    display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;
    margin-bottom: var(--sp-3); gap: 1rem; border-bottom: 1px solid rgba(239,230,216,.1); padding-bottom: 1rem;
  }
  .exp-title {
    font-family: var(--font-display); font-size: clamp(1.4rem, 3.2vw, 2rem); font-weight: 700; color: var(--ecru); margin: 0;
  }
  .exp-meta {
    font-family: var(--font-mono); font-size: 0.85rem; color: var(--brass); text-transform: uppercase; letter-spacing: 0.1em; text-align: right;
  }
  .exp-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;
  }
  .exp-thumb {
    position: relative; aspect-ratio: 16/9; overflow: hidden; border: 1px solid rgba(239,230,216,.15);
    transition: transform 0.3s ease, border-color 0.3s ease; display: block;
  }
  .exp-thumb-vertical {
    position: relative; aspect-ratio: 9/16; overflow: hidden; border: 1px solid rgba(239,230,216,.15);
    transition: transform 0.3s ease, border-color 0.3s ease; display: block;
  }
  .exp-thumb:hover, .exp-thumb-vertical:hover { transform: translateY(-4px); border-color: var(--brass); }
  .exp-thumb img, .exp-thumb-vertical img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .exp-thumb:hover img, .exp-thumb-vertical:hover img { transform: scale(1.04); }
  .exp-label {
    font-family: var(--font-body); font-style: italic; font-size: 0.95rem; color: var(--ash); margin-top: 0.6rem; 
    display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: center;
  }

  /* ---------- credits list ---------- */
  .credits-block{margin-top:var(--sp-5);}
  .credit-row{
    display:flex; justify-content:space-between; gap:1.5rem; padding:var(--sp-2) 0;
    border-bottom:1px solid rgba(239,230,216,.12); flex-wrap:wrap;
  }
  .credit-org{font-family:var(--font-mono); font-size:.85rem; letter-spacing:.03em; color:var(--ecru);}
  .credit-role{color:var(--ash); font-size:.92rem; text-align:right;}
  .credit-role em{color:var(--brass); font-style:normal;}

  /* ---------- craft ---------- */
  .craft-grid{display:grid; grid-template-columns:1.1fr 1fr; gap:var(--sp-4);}
  @media (max-width:480px){ .craft-grid{grid-template-columns:1fr; gap:1.5rem;} }
  .craft-primary, .craft-secondary{border:1px solid rgba(239,230,216,.12); padding:var(--sp-3);}
  .craft-primary h3{font-family:var(--font-display); font-weight:700; font-size:clamp(1.6rem,3.4vw,2.1rem); color:var(--ecru); margin:.5rem 0 var(--sp-2);}
  .tag-row{display:flex; flex-wrap:wrap; gap:.6rem;}
  .tag{
    border:1px solid var(--oxblood-dim); padding:.4rem .8rem; font-family:var(--font-mono);
    font-size:.75rem; letter-spacing:.05em; text-transform:uppercase; color:var(--ecru);
  }
  .craft-secondary p{margin-top:var(--sp-3); color:var(--ash); font-size:.95rem; max-width:38ch;}

  /* ---------- contact ---------- */
  .contact-lede{max-width:48ch; color:var(--ecru); font-size:1.1rem; margin-bottom:var(--sp-3);}
  .contact-links{display:flex; flex-wrap:wrap; gap:clamp(1.2rem,4vw,2.4rem);}
  .contact-link{
    font-family:var(--font-mono); font-size:.85rem; letter-spacing:.08em; text-transform:uppercase;
    color:var(--ecru); border-bottom:1px solid var(--oxblood); padding-bottom:3px; transition:color .2s,border-color .2s;
  }
  .contact-link:hover, .contact-link:focus-visible{color:var(--brass); border-color:var(--brass);}

  .contact-form{
    margin-top: var(--sp-4);
    background: var(--ink-2);
    border: 1px solid var(--oxblood-dim);
    padding: clamp(1.2rem, 3vw, 1.8rem);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%);
    max-width: 640px;
  }
  .form-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width:480px){ .form-grid{ grid-template-columns:1fr; } }
  .contact-form label{ display:flex; flex-direction:column; gap: 0.35rem; }
  .contact-form label span{
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--ash);
  }
  .contact-form input,
  .contact-form textarea{
    background: var(--ink);
    border: 1px solid rgba(239,230,216,0.14);
    color: var(--ecru);
    font-family: var(--font-body); font-size: 0.98rem;
    padding: 0.75rem 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    box-sizing: border-box;
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder{ color: rgba(239,230,216,0.45); }
  .contact-form input:focus,
  .contact-form textarea:focus{
    border-color: var(--brass);
    box-shadow: 0 0 0 2px rgba(212,162,76,0.12);
  }
  .contact-form textarea{ resize: vertical; min-height: 120px; }
  .form-submit{
    margin-top: 1rem;
    background: var(--brass);
    color: var(--ink);
    border: 1px solid var(--brass);
    font-family: var(--font-mono); font-size: 0.78rem;
    letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700;
    padding: 0.85rem 1.4rem;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .form-submit:hover{ background: transparent; color: var(--brass); transform: translateY(-1px); }
  .form-submit:active{ transform: translateY(0); }
  .form-note{
    margin-top: 0.85rem;
    font-family: var(--font-mono); font-size: 0.70rem;
    letter-spacing: 0.04em; color: var(--ash);
  }
  .form-note a{ color: var(--brass); border-bottom: 1px solid rgba(212,162,76,0.35); }
  .form-status{
    margin-top: 0.75rem;
    font-family: var(--font-mono); font-size: 0.76rem;
    color: var(--brass);
    min-height: 1.2em;
  }

   /* ---------- state coverage — skeletons & empty/error (anti-slop) ---------- */
  .skeleton{
    background: linear-gradient(90deg, var(--ink-2) 25%, rgba(239,230,216,.06) 37%, var(--ink-2) 63%);
    background-size:400% 100%;
    animation: skeletonShimmer 1.2s ease-in-out infinite;
    border:1px solid rgba(239,230,216,.08);
  }
  @keyframes skeletonShimmer{ 0%{background-position:100% 0} 100%{background-position:-100% 0} }
  .empty-state{
    border:1px dashed rgba(239,230,216,.14);
    padding:1.4rem; color:var(--ash);
    font-family:var(--font-mono); font-size:.78rem; line-height:1.6;
  }
  .empty-state b{ color:var(--brass); font-weight:700; }
  .empty-state a{ color:var(--brass); border-bottom:1px solid rgba(212,162,76,.35); }
  .field-error{
    min-height:1.1em; margin-top:.35rem;
    font-family:var(--font-mono); font-size:.70rem; letter-spacing:.04em; color:#D96C4A;
  }
  .contact-form input[aria-invalid="true"], .contact-form textarea[aria-invalid="true"]{
    border-color:#D96C4A; box-shadow:0 0 0 2px rgba(217,108,74,.14);
  }
  .img-error-fallback{
    display:none; padding:1rem; text-align:center;
    font-family:var(--font-mono); font-size:.70rem; color:var(--ash); line-height:1.5;
    background:var(--ink-2); border:1px dashed rgba(239,230,216,.12);
  }

  /* ---------- footer ---------- */
  footer{border-top:1px solid rgba(239,230,216,.1); padding-block:var(--sp-3);}
  .footer-inner{display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.75rem;}
  footer p{font-family:var(--font-mono); font-size:.75rem; letter-spacing:.04em; color:var(--ash);}

  /* Mobile compact — keep desktop layout but much smaller (only phones) */
  @media (max-width: 480px){
    .hero{ min-height:84vh; }
    .hero h1{ font-size: clamp(2.7rem, 12vw, 3.4rem); margin-block:0.28em 0.38em; letter-spacing:-0.02em; }
    .hero-sub{ font-size: 0.88rem; max-width: 34ch; margin-bottom:1.2rem; }
    .hero .eyebrow{ font-size: 0.66rem; }
    .hero-meta{ font-size: 0.66rem; }
    .section{ padding-block:1.8rem; }
    .section h2{ font-size: clamp(1.35rem, 5.5vw, 1.65rem); margin-bottom:0.9rem; }
    .about-header{ margin-bottom:1.2rem; }
    .about-header h2{ font-size: clamp(1.6rem, 7vw, 2.1rem); }
    .about-lead{ font-size: 0.90rem; margin-bottom:0.9rem; }
    .about-copy p{ font-size: 0.85rem; line-height:1.5; margin-bottom:0.8em; }
    .split-label h2{ font-size: clamp(1.35rem, 6vw, 1.8rem); }
    .split-label{ gap:0.5rem; padding-bottom:0.6rem; margin-bottom:1rem; }
    .split-count{ font-size:0.66rem; }
    /* Narrative squeezed preview on mobile, keep card feel like Remake */
    .narrative-row{
      grid-template-columns:36px 1fr 68px;
      gap:0.5rem;
      padding:0.65rem 0.6rem;
      background:var(--ink-2);
      border:1px solid var(--oxblood-dim);
      clip-path:polygon(0 0,100% 0,100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%);
      overflow:hidden;
      align-items:center;
    }
    .narrative-row .narrative-index{
      display:block;
      padding:0;
      font-size:0.60rem;
    }
    .narrative-row .narrative-index b{ font-size:0.95rem; }
    .narrative-row .narrative-main{ padding:0; }
    .narrative-main h3{ font-size:0.92rem; line-height:1.1; }
    .narrative-meta{ font-size:0.58rem; margin-top:0.25rem; }
    .case-synopsis{ font-size:0.76rem; margin-bottom:0.5rem; line-height:1.45; }
    .narrative-cta{ font-size:0.58rem; }
    .narrative-thumb{
      width:68px; order:0;
      aspect-ratio:1/1;
      border:1px solid var(--oxblood-dim);
      clip-path:none;
    }
    .case-card{ padding:0.9rem 0.8rem; margin-bottom:1.2rem; }
    .case-kicker{ font-size:0.64rem; margin-bottom:0.4rem; }
    .case-title{ font-size:1.25rem; }
    .commercial-card{ padding:0.8rem 0.7rem; }
    .commercial-card h3{ font-size:0.96rem; }
    .commercial-card .role{ font-size:0.60rem; margin:0.2rem 0 0.4rem; }
    .commercial-card .desc{ font-size:0.78rem; line-height:1.4; max-width:none; }
    .commercial-card .mini-grid{ gap:0.35rem; padding-top:0.5rem; grid-template-columns:repeat(3, 1fr); }
    .commercial-card .mini-thumb{ border-width:1px; }
    .commercial-card .mini-label{ font-size:0.50rem; margin-top:0.2rem; }
    #craft{ padding-block:0.9rem; }
    #craft .craft-primary, #craft .craft-secondary{ padding:0.6rem; }
    .craft-primary h3{ font-size:0.95rem; margin:0.2rem 0 0.5rem; }
    .craft-primary .eyebrow, .craft-secondary .eyebrow{ font-size:0.60rem; margin-bottom:0.3rem; }
    .craft-secondary p{ font-size:0.72rem; margin-top:0.5rem; }
    .craft-secondary p[style]{ font-size:0.72rem !important; }
    .tag{ font-size:0.54rem; padding:0.2rem 0.4rem; }
    .craft-grid{ gap:0.8rem; }
    .software-grid{ gap:0.4rem; margin-top:0.5rem; }
    .software-item{ padding:0.4rem 0.5rem; }
    #contact{ padding-block:1.1rem; }
    .contact-lede{ font-size:0.80rem; margin-bottom:0.8rem; }
    .contact-form{ padding:0.7rem; margin-top:1rem; }
    .contact-form label span{ font-size:0.64rem; }
    .contact-form input, .contact-form textarea{ font-size:0.88rem; padding:0.6rem 0.7rem; }
    .form-submit{ font-size:0.70rem; padding:0.65rem 1rem; }
    .form-note{ font-size:0.62rem; }
    .gallery-panel{ width:72vw; }
    .panel-caption{ font-size:0.60rem; }
    .panel-year{ font-size:0.60rem; }
    .credit-row{ padding:0.6rem 0; gap:0.6rem; }
    .credit-org{ font-size:0.74rem; }
    .credit-role{ font-size:0.78rem; }
    .horizontal-hint{ font-size:0.62rem; }
  }

  @media (max-width:768px){
    body::before, body::after{ display:none; }
    .hero::before, .hero::after{ display:none; }
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    *,*::before,*::after{animation-duration:.01ms !important; animation-iteration-count:1 !important; transition-duration:.01ms !important;}
    body::before, body::after{ display: none; }
    .velocity-track{ animation: none; }
    .hero::before, .hero::after{ display: none; }
  }
</style>
</head>
<body>
  <CustomCursor />
  <header>
    <div class="container nav-inner">
      <a class="brand" href="/" aria-label="Mihail Mihaylov — home" data-cursor-hover data-cursor-label="HOME">
        <Image src={logoImg} alt="Mihail Mihaylov Logo" class="brand-logo" widths={[64, 128]} sizes="64px" loading="eager" decoding="async" />
      </a>
      <div class="nav-actions">
        <nav aria-label="Primary">
          {siteContent?.nav?.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
        <HamburgerMenu />
      </div>
    </div>
  </header>

  <slot />

  <footer>
    <div class="container footer-inner">
      <Image src={logoImg} alt="Mihail Mihaylov Logo" class="footer-logo" widths={[48, 96]} sizes="48px" loading="lazy" decoding="async" />
      <p>{siteContent?.footer || '© 2026 Mihail Mihaylov · Sofia, Bulgaria · Made for the big screen'}</p>
    </div>
  </footer>

  <LenisSmoothScroll />
</body>
</html>
