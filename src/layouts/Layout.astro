---
import { ClientRouter } from 'astro:transitions';
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.png';
import CustomCursor from '../components/CustomCursor.astro';
import LenisSmoothScroll from '../components/LenisSmoothScroll.astro';
import AmbientAudio from '../components/AmbientAudio.astro';
import HamburgerMenu from '../components/HamburgerMenu.astro';
import VideoModal from '../components/VideoModal.astro';
import { getCollection } from 'astro:content';

const siteContent = (await getCollection('site'))[0]?.data;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Mihail Mihaylov — film student in Sofia, Bulgaria, working across directing, editing, documentary, and live production.',
  ogImage = '/og-cover.jpg',
  ogType = 'website',
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://MihailM17.github.io');
const canonicalUrl = new URL(Astro.url.pathname, siteBase).toString();
const absoluteOgImage = /^https?:\/\//i.test(ogImage)
  ? ogImage
  : new URL(ogImage.startsWith('/') ? ogImage : `/${ogImage}`, siteBase).toString();
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#1C1614">
<link rel="canonical" href={canonicalUrl}>

<!-- Open Graph & Social Previews -->
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="Mihail Mihaylov">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={absoluteOgImage}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={absoluteOgImage}>

<!-- Google tag (gtag.js) --><script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GZMPLW7CNY"></script>
<script is:inline>window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'G-GZMPLW7CNY');</script>
<ClientRouter />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@700;800&family=Newsreader:ital,wght@0,400;0,500;1,400&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style is:global>
  :root {
    /* Core Darkroom Palette */
    --ink: #1C1614;
    --ink-2: #251E1A;
    --surface-0: #120E0C;
    --surface-1: #16110F;
    --surface-2: #1E1815;
    --surface-3: #241D19;
    --oxblood: #B23A2E;
    --oxblood-dim: #7A2A21;
    --accent-coral: #E07062; /* WCAG AA >= 5.5:1 on dark surfaces for small kickers */
    --brass: #D4A24C;
    --ecru: #EFE6D8;
    --ash: #A99C8F;
    --danger: #E3745B;
    --success: #7EC699;

    --border-subtle: rgba(239, 230, 216, 0.14);
    --border-soft: rgba(239, 230, 216, 0.08);
    --border-strong: rgba(239, 230, 216, 0.28);

    --font-display: 'Unbounded', system-ui, sans-serif;
    --font-body: 'Newsreader', Georgia, serif;
    --font-mono: 'IBM Plex Mono', 'SFMono-Regular', Menlo, monospace;

    --h2-size: clamp(1.9rem, 3.8vw, 2.75rem);
    --sp-1: 0.5rem;
    --sp-2: 1rem;
    --sp-3: 1.75rem;
    --sp-4: 3rem;
    --sp-5: 5rem;
    --sp-6: 7.5rem;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--ink);
    color: var(--ecru);
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    position: relative;
  }

  /* Subtle darkroom film grain (desktop only) */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.026;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    mix-blend-mode: soft-light;
  }
  main, header, footer { position: relative; z-index: 2; }

  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  h1, h2, h3 { margin: 0; }
  p { margin: 0; }
  :focus-visible { outline: 2px solid var(--brass); outline-offset: 3px; }

  /* Skip to content link (visible on keyboard focus) */
  .skip-link {
    position: fixed;
    top: -100px;
    left: 1rem;
    z-index: 10001;
    padding: 0.7rem 1.15rem;
    border-radius: 999px;
    background: var(--brass);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: top 0.18s ease;
  }
  .skip-link:focus {
    top: 1rem;
  }

  .container {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }
  .section { padding-block: var(--sp-6); }
  @media (max-width: 640px) {
    .section { padding-block: clamp(3rem, 8vw, 4.5rem); }
  }

  .eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    color: var(--brass);
    margin-bottom: var(--sp-2);
    display: block;
  }
  .section h2 {
    font-family: var(--font-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    font-size: var(--h2-size);
    line-height: 1.08;
    max-width: 18ch;
    margin-bottom: var(--sp-3);
    color: var(--ecru);
  }

  /* Unified pill button family */
  .pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.65rem 1.25rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .pill-btn--primary {
    background: var(--brass);
    color: var(--ink);
    border: 1px solid var(--brass);
    font-weight: 600;
  }
  .pill-btn--primary:hover {
    background: var(--ecru);
    border-color: var(--ecru);
    color: var(--ink);
    transform: translateY(-1px);
  }
  .pill-btn--secondary {
    background: rgba(28, 22, 20, 0.72);
    color: var(--ecru);
    border: 1px solid var(--border-strong);
    backdrop-filter: blur(8px);
  }
  .pill-btn--secondary:hover {
    border-color: var(--brass);
    color: var(--brass);
    transform: translateY(-1px);
  }

  /* ---------- header ---------- */
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(28, 22, 20, 0.88);
    backdrop-filter: blur(10px) saturate(1.15);
    border-bottom: 1px solid var(--border-soft);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    gap: 0.75rem;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    height: 54px;
    width: auto;
    object-fit: contain;
  }
  .footer-logo {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  nav[aria-label="Primary"] {
    display: flex;
    align-items: center;
    gap: clamp(0.6rem, 2.2vw, 1.5rem);
  }
  nav[aria-label="Primary"] a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    transition: color 0.2s ease;
    position: relative;
  }
  nav[aria-label="Primary"] a::after {
    content: "";
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 8px;
    height: 1.5px;
    background: var(--brass);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  nav[aria-label="Primary"] a:hover::after,
  nav[aria-label="Primary"] a[aria-current="location"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  nav[aria-label="Primary"] a:hover,
  nav[aria-label="Primary"] a:focus-visible,
  nav[aria-label="Primary"] a[aria-current="location"] {
    color: var(--ecru);
  }

  /* Compact 64px mobile header: hide inline nav so HamburgerMenu owns mobile */
  @media (max-width: 860px) {
    .nav-inner {
      padding-block: 0.55rem;
    }
    .brand-logo {
      height: 42px;
    }
    nav[aria-label="Primary"] {
      display: none;
    }
  }

  /* ---------- about ---------- */
  .about-section {
    position: relative;
    overflow: clip;
    padding-block: clamp(4.5rem, 8vw, 7.25rem);
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    background:
      radial-gradient(ellipse 680px 420px at 78% 45%, rgba(212, 162, 76, 0.055), transparent 64%),
      linear-gradient(180deg, #221C18 0%, #1F1916 100%);
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portrait-panel {
      max-width: 360px;
    }
  }
  .portrait-panel {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--ink-2);
    border: 1px solid var(--border-subtle);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%);
    overflow: hidden;
    width: 100%;
  }

  /* ---------- contact shared ---------- */
  #contact {
    padding-block: clamp(4.5rem, 8.5vw, 7.75rem);
    background:
      radial-gradient(ellipse 820px 420px at 88% 18%, rgba(178, 58, 46, 0.1), transparent 58%),
      radial-gradient(ellipse 600px 320px at 8% 88%, rgba(212, 162, 76, 0.07), transparent 60%),
      var(--surface-1);
    border-top: 1px solid var(--border-soft);
  }
  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 520px) {
    .form-grid { grid-template-columns: 1fr; }
  }
  .form-note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--ash);
  }
  .form-status {
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--brass);
    min-height: 1.2em;
  }
  .form-status[data-state="error"] {
    color: var(--danger);
  }
  .form-status[data-state="success"] {
    color: var(--success);
  }
  .field-error {
    min-height: 1.15em;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--danger);
  }

  /* ---------- skeletons & states ---------- */
  .skeleton {
    background: linear-gradient(90deg, var(--ink-2) 25%, rgba(239, 230, 216, 0.06) 37%, var(--ink-2) 63%);
    background-size: 400% 100%;
    animation: skeletonShimmer 1.2s ease-in-out infinite;
    border: 1px solid var(--border-soft);
  }
  @keyframes skeletonShimmer {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }
  .empty-state {
    border: 1px dashed var(--border-subtle);
    padding: 1.4rem;
    color: var(--ash);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .empty-state b { color: var(--brass); font-weight: 600; }
  .img-error-fallback {
    display: none;
    padding: 1rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ash);
    line-height: 1.5;
    background: var(--ink-2);
    border: 1px dashed var(--border-subtle);
  }

  /* ---------- footer ---------- */
  footer {
    border-top: 1px solid var(--border-soft);
    padding-block: var(--sp-3);
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  footer p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--ash);
  }

  @media (max-width: 768px) {
    body::before { display: none; }
  }

  /* Intentional reduced-motion: disable continuous/ambient effects while keeping quick state transitions */
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    body::before { display: none; }
    .skeleton { animation: none; }
  }
</style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <CustomCursor />
  <header>
    <div class="container nav-inner">
      <a class="brand" href="/" aria-label="Mihail Mihaylov - home" data-cursor-hover data-cursor-label="HOME">
        <Image src={logoImg} alt="Mihail Mihaylov Logo" class="brand-logo" widths={[64, 128]} sizes="54px" loading="eager" decoding="async" />
      </a>
      <div class="nav-actions">
        <nav aria-label="Primary">
          {siteContent?.nav?.map((item) => (
            <a href={item.href} data-nav-section={item.href.replace('/#', '')}>{item.label}</a>
          ))}
        </nav>
        <AmbientAudio />
        <HamburgerMenu />
      </div>
    </div>
  </header>

  <slot />

  <footer>
    <div class="container footer-inner">
      <Image src={logoImg} alt="Mihail Mihaylov Logo" class="footer-logo" widths={[48, 96]} sizes="44px" loading="lazy" decoding="async" />
      <p>{siteContent?.footer || '© 2026 Mihail Mihaylov · Sofia, Bulgaria'}</p>
    </div>
  </footer>

  <VideoModal />
  <LenisSmoothScroll />

  <script>
    function initActiveNav() {
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Primary"] a[data-nav-section]'));
      if (!links.length) return;
      const sections = links
        .map((a) => ({ link: a, el: document.getElementById(a.dataset.navSection || '') }))
        .filter((x): x is { link: HTMLAnchorElement; el: HTMLElement } => Boolean(x.el));
      if (!sections.length) return;

      const setActive = (id: string) => {
        links.forEach((a) => {
          if (a.dataset.navSection === id) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]?.target?.id) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: '-25% 0px -55% 0px', threshold: [0.1, 0.4] },
      );

      sections.forEach(({ el }) => observer.observe(el));
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initActiveNav);
    else initActiveNav();
    document.addEventListener('astro:page-load', initActiveNav);
  </script>
</body>
</html>
