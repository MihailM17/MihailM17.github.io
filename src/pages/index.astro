---
// ALL EDITABLE TEXT IS IN src/content/ (collections)
// Open those files in VS Code, edit, save, rebuild. No hunting needed.
import Layout from '../layouts/Layout.astro';
import SpliceStrip from '../components/SpliceStrip.astro';
import HorizontalGallery from '../components/HorizontalGallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portraitImg from '../assets/portrait.png';

const projects = await getCollection('projects');
const siteContent = (await getCollection('site'))[0]?.data;

// Custom order for narrative projects (same as hamburger menu)
const narrativeOrder: Record<string, number> = {
  'silent-lifts-vitosha': 1,
  'zasnet': 2,
  'remake-season-2': 3,
  'eastern-wind': 4,
};

const narrative = projects
  .filter((p) => ["silent-lifts-vitosha","eastern-wind","zasnet"].includes(p.data.slug))
  .sort((a, b) => narrativeOrder[a.data.slug] - narrativeOrder[b.data.slug]);

const broadcast = projects.find((p) => p.data.slug === "remake-season-2");
const commercial = siteContent.commercial.jobs;
const galleryItems = siteContent.gallery.items;
const c = siteContent;
---

<Layout title={c.siteTitle}>
  <main>
    <section id="top" class="hero">
      <div class="container hero-inner">
        <span class="eyebrow" data-reveal>{c.hero.eyebrow}</span>
        <h1 data-reveal>
          <span class="line"><span>{c.hero.titleLine1}</span></span>
          <span class="line"><span>{c.hero.titleLine2}</span></span>
        </h1>
        <p class="hero-sub" data-reveal>{c.hero.sub}</p>
        <p class="hero-meta" data-reveal>{c.hero.meta}</p>
      </div>
      <a href="#narrative" class="scroll-cue" aria-label="Scroll to Narrative" data-cursor-hover data-cursor-label="SCROLL"><span></span></a>
    </section>

    <SpliceStrip />

    <section id="about" class="section about-section">
      <div class="container">
        <div class="about-header" data-reveal>
          <span class="eyebrow">{c.about.kicker}</span>
          <h2><span>{c.about.titleLine1}</span><em>{c.about.titleLine2}</em></h2>
        </div>
        <div class="about-grid">
          <div class="about-copy" data-reveal>
            <p class="about-lead">{c.about.lead}</p>
            <p>{c.about.p1}</p>
            <p>{c.about.p2}</p>
            <div class="about-stats">
              {c.about.stats.map((s) => (
                <div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
              ))}
              <div class="about-stats-footnote"><b>28 days</b> · 5 crews × 4 · NBU × UCF sprint · Jan 2026 — Sofia 42.70°N 23.32°E</div>
            </div>
            <span class="about-lang">{c.about.lang}</span>
          </div>
          <div class="portrait-panel" data-reveal aria-hidden="true" data-cursor-hover data-cursor-label="MIHAIL">
            <Image src={portraitImg} alt={c.about.portraitAlt} widths={[400, 600, 800]} sizes="(max-width: 860px) 100vw, 420px" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <SpliceStrip />

    <section id="narrative" class="split-section">
      <div class="container">
        <div class="split-label" data-reveal>
          <h2>{c.narrative.kicker} <em>{c.narrative.index}</em></h2>
          <span class="split-count"><b>{c.narrative.count.split(' ')[0]}</b> {c.narrative.count.split(' ').slice(1).join(' ')}</span>
        </div>
        <p class="eyebrow" style="margin-top:-1.2rem; margin-bottom:var(--sp-3);" data-reveal>{c.narrative.hint}</p>

        <div class="narrative-list">
          {narrative.length === 0 ? (
            <div class="empty-state"><b>No narrative films published yet.</b> — Add projects to <code>src/content/projects/*.json</code> (needs <code>index, title, youtubeUrl, thumb</code>). The 28-day Vitosha sprint will appear here when published.</div>
          ) : narrative.map((film) => {
            const f = film.data;
            return (
              <article class="narrative-row" data-reveal data-slug={f.slug} data-youtube={f.youtubeUrl}>
                <div class="narrative-index"><b>{f.index}</b> {f.year}</div>
                <div class="narrative-main">
                  <h3>
                    <a href={`/projects/${f.slug}`} data-cursor-hover data-cursor-label="OPEN STORY">
                      {f.slug === 'silent-lifts-vitosha' ? f.titleEn : f.title}, {f.year}
                    </a>
                  </h3>
                  <div class="narrative-meta"><b>{f.kicker}</b> — {f.meta}</div>
                  <p class="case-synopsis" style="margin-top:0.7rem; max-width:52ch;">{f.synopsis}</p>
                  <a href={`/projects/${f.slug}`} class="narrative-cta" data-cursor-hover>Read story →</a>
                </div>
                <a href={f.youtubeUrl} target="_blank" rel="noopener noreferrer" class="narrative-thumb" aria-label={`Watch ${f.slug === 'silent-lifts-vitosha' ? f.titleEn : f.title} on YouTube`} data-cursor-hover data-cursor-label="PLAY">
                  <img src={f.thumb} alt={`${f.slug === 'silent-lifts-vitosha' ? f.titleEn : f.title} thumbnail`} loading="lazy" decoding="async" onerror="this.style.opacity='0.3'" />
                  <span class="play-overlay" aria-hidden="true">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="24" fill="rgba(28,22,20,0.85)"/><path d="M18 16v16l14-8-14-8z" fill="var(--brass)"/></svg>
                  </span>
                </a>
              </article>
            );
          })}
        </div>

        {broadcast && (
          <div class="case-card" style="margin-top: var(--sp-4);" data-reveal>
            <span class="case-kicker">{broadcast.data.kicker}</span>
            <h3 class="case-title"><a href={`/projects/${broadcast.data.slug}`} data-cursor-hover data-cursor-label="OPEN STORY">{broadcast.data.title}, {broadcast.data.year}</a></h3>
            <p class="case-title-bg">{broadcast.data.meta}</p>
            <div class="case-grid">
              <div class="reel-frame">
                <a href={broadcast.data.youtubeUrl} target="_blank" rel="noopener noreferrer" data-cursor-hover data-cursor-label="PLAY">
                  <img src={broadcast.data.thumb} alt="РимейкЪТ thumbnail" style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;" loading="lazy" decoding="async">
                </a>
              </div>
              <div class="case-copy"><p class="case-synopsis">{broadcast.data.synopsis}</p><a href={`/projects/${broadcast.data.slug}`} class="narrative-cta" data-cursor-hover>Read story →</a></div>
            </div>
          </div>
        )}
      </div>
    </section>

    <SpliceStrip />

    <section id="commercial" class="split-section" style="background: radial-gradient(ellipse at 18% 0%, rgba(212,162,76,0.07), transparent 55%), var(--ink);">
      <div class="container">
        <div class="split-label" data-reveal>
          <h2>{c.commercial.kicker} <em>{c.commercial.index}</em></h2>
          <span class="split-count"><b>{c.commercial.count.split(' ')[0]}</b> {c.commercial.count.split(' ').slice(1).join(' ')}</span>
        </div>
        <p class="eyebrow" style="margin-top:-1.2rem; margin-bottom:var(--sp-3);" data-reveal>{c.commercial.hint}</p>

        <div class="commercial-grid">
          {commercial.length === 0 ? (
            <div class="empty-state"><b>No commercial jobs listed.</b> — Add to <code>src/content/site/main.json → commercial.jobs</code>.</div>
          ) : commercial.map((job) => {
            const fallbackSlug = job.org.includes('7Arts') ? '7arts-artportal' : job.org.includes('Timeless') ? 'timeless-production' : null;
            const slug = (job as any).detail?.slug || fallbackSlug;
            return (
            <article class="commercial-card" data-reveal data-company-slug={slug} data-cursor-hover data-cursor-label="OPEN">
              <div class="commercial-card-content">
                <h3><a href={slug ? `/companies/${slug}` : undefined} class="commercial-card-title-link" data-cursor-hover>{job.org}</a></h3>
                <span class="role">{job.role} — {job.years}</span>
                <p class="desc">{job.desc}</p>
              </div>
              <div class="mini-grid">
                {job.items.map((it: any) => (
                  <div class="mini-item">
                    <a href={it.url} target="_blank" rel="noopener noreferrer" class={`mini-thumb ${it.isVertical ? 'is-vertical' : ''}`} data-cursor-hover data-cursor-label={it.isVertical ? "REEL" : "PLAY"}>
                      <img src={it.thumb} alt={it.label} loading="lazy" decoding="async" />
                    </a>
                    <span class="mini-label">{it.label}</span>
                  </div>
                ))}
              </div>
              {slug && <span class="commercial-card-cta">View detail →</span>}
            </article>
            );
          })}
        </div>

        <div class="credits-block" data-reveal>
          <span class="eyebrow">Credits & Affiliations</span>
          <ul class="credit-list">
            {c.commercial.credits.map((cr) => (
              <li class="credit-row"><span class="credit-org">{cr.org}</span><span class="credit-role">{cr.role} {cr.note && <em>({cr.note})</em>}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="archive">
      <HorizontalGallery eyebrow={c.gallery.eyebrow} title={c.gallery.title} items={galleryItems} />
    </section>

    <SpliceStrip />

    <section id="craft" class="section">
      <div class="container">
        <span class="eyebrow" data-reveal>{c.craft.kicker}</span>
        <h2 data-reveal>{c.craft.title}</h2>
        <div class="craft-grid" data-reveal>
          <div class="craft-primary">
            <span class="eyebrow">{c.craft.nowKicker}</span>
            <h3>{c.craft.nowTitle}</h3>
            <div class="tag-row">
              {c.craft.tags.map((t) => (<span class="tag">{t}</span>))}
            </div>
          </div>
          <div class="craft-secondary">
            <span class="eyebrow">{c.craft.approachKicker}</span>
            <p>{c.craft.approachText}</p>
            {c.craft.approachNote && <p style="margin-top:0.9rem; color:var(--ash); font-size:0.92rem;">{c.craft.approachNote}</p>}
          </div>
        </div>
      </div>
    </section>

    <SpliceStrip />

    <section id="contact" class="section">
      <div class="container">
        <span class="eyebrow" data-reveal>{c.contact.kicker}</span>
        <h2 data-reveal>{c.contact.title}</h2>
        <p class="contact-lede" data-reveal>{c.contact.lede}</p>

        <form id="contact-form" class="contact-form" data-reveal novalidate>
          <div class="form-grid">
            <label><span>Name</span><input type="text" name="name" required placeholder="Your name" autocomplete="name" aria-describedby="err-name"><span class="field-error" id="err-name" aria-live="polite"></span></label>
            <label><span>Your Email</span><input type="email" name="email" required placeholder="you@email.com" autocomplete="email" aria-describedby="err-email"><span class="field-error" id="err-email" aria-live="polite"></span></label>
          </div>
          <label style="margin-top:1rem"><span>Subject</span><input type="text" name="subject" placeholder="Project inquiry — edit / color / directing" required aria-describedby="err-subject"><span class="field-error" id="err-subject" aria-live="polite"></span></label>
          <label style="margin-top:1rem"><span>Message</span><textarea name="message" required placeholder="Tell me about your project, timeline, and budget..." rows="5" aria-describedby="err-message"></textarea><span class="field-error" id="err-message" aria-live="polite"></span></label>
          <button type="submit" class="form-submit" data-cursor-hover data-cursor-label="SEND">Send Email →</button>
          <p class="form-note">Or email directly: <a href={`mailto:${c.contact.email}`}>{c.contact.email}</a> — {c.contact.formNote}</p>
          <p class="form-status" id="form-status" aria-live="polite"></p>
        </form>

        <div class="contact-links" data-reveal style="margin-top: var(--sp-3);">
          <a class="contact-link" href={`mailto:${c.contact.email}`} data-cursor-hover data-cursor-label="MAIL">Email</a>
          <a class="contact-link" href={c.contact.instagram} target="_blank" data-cursor-hover>Instagram</a>
          <a class="contact-link" href={c.contact.linkedin} target="_blank" data-cursor-hover>LinkedIn</a>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      import { actions } from 'astro:actions';

      function initContactForm() {
        const form = document.getElementById('contact-form');
        const status = document.getElementById('form-status');
        if (!form || form.dataset.bound === '1') return;
        form.dataset.bound = '1';
        const errName = document.getElementById('err-name');
        const errEmail = document.getElementById('err-email');
        const errSubject = document.getElementById('err-subject');
        const errMessage = document.getElementById('err-message');
        const setErr = (el, input, msg) => {
          if (el) el.textContent = msg || '';
          if (input) {
            if (msg) input.setAttribute('aria-invalid', 'true');
            else input.removeAttribute('aria-invalid');
          }
        };
        const clearAll = () => {
          setErr(errName, form.querySelector('[name="name"]'), '');
          setErr(errEmail, form.querySelector('[name="email"]'), '');
          setErr(errSubject, form.querySelector('[name="subject"]'), '');
          setErr(errMessage, form.querySelector('[name="message"]'), '');
          if (status) status.textContent = '';
        };
        // live clear on input
        ['name','email','subject','message'].forEach(n => {
          const inp = form.querySelector(`[name="${n}"]`);
          if (inp) inp.addEventListener('input', () => {
            const errEl = document.getElementById(`err-${n}`);
            setErr(errEl, inp, '');
            if (status) status.textContent = '';
          });
        });
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          clearAll();
          const data = new FormData(form);
          const name = (data.get('name') || '').toString().trim();
          const email = (data.get('email') || '').toString().trim();
          const subject = (data.get('subject') || '').toString().trim() || 'Portfolio inquiry';
          const message = (data.get('message') || '').toString().trim();
          let hasError = false;
          if (!name || name.length < 2) { setErr(errName, form.querySelector('[name="name"]'), 'Name required — at least 2 characters.'); hasError = true; }
          const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
          if (!email || !emailOk) { setErr(errEmail, form.querySelector('[name="email"]'), 'Valid email required — e.g., name@domain.com'); hasError = true; }
          if (!subject || subject.length < 3) { setErr(errSubject, form.querySelector('[name="subject"]'), 'Subject required — 3+ characters or leave as “Portfolio inquiry”.'); hasError = true; }
          if (!message || message.length < 10) { setErr(errMessage, form.querySelector('[name="message"]'), 'Message required — 10+ characters so I can reply usefully.'); hasError = true; }
          if (hasError) {
            if (status) status.textContent = 'Fix the fields above — not sent yet.';
            return;
          }
          if (!navigator.onLine) {
            if (status) status.textContent = 'You appear offline — message not sent. Copy your text and email directly.';
            return;
          }
          if (status) status.textContent = 'Sending…';
          const submitBtn = form.querySelector('.form-submit');
          if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }
          try {
            const { error } = await actions.sendEmail({ name, email, subject, message });
            if (error) {
              if (status) status.textContent = `Couldn’t send: ${error.message} — try email directly: ${form.querySelector('a[href^=\"mailto:\"]')?.href || 'mohailmihaylov2004@gmail.com'}`;
            } else {
              if (status) status.textContent = 'Sent — I’ll reply within 24h (Sofia time). Check spam if you don’t hear back.';
              form.reset();
            }
          } catch (err) {
            if (status) status.textContent = 'Network error — not sent. Please email directly or try again.';
            console.error(err);
          } finally {
            if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send Email →'; }
          }
        });
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initContactForm);
      else initContactForm();
      document.addEventListener('astro:page-load', initContactForm);
      document.addEventListener('astro:after-swap', initContactForm);
    </script>

    <script>
      // @ts-nocheck
      function initNarrativeRows() {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initNarrativeRows);
          return;
        }
        if (document.body.dataset.narrativeBound === '1') return;
        document.body.dataset.narrativeBound = '1';

        document.querySelectorAll('.narrative-row').forEach(row => {
          const slug = row.dataset.slug;
          if (!slug) return;

          row.style.cursor = 'pointer';

          row.addEventListener('click', (e) => {
            // Don't navigate if clicking on a link inside (title, cta, or thumbnail)
            if (e.target.closest('a')) return;
            window.location.href = `/projects/${slug}`;
          });

          // Keyboard accessibility
          row.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              if (!e.target.closest('a')) {
                window.location.href = `/projects/${slug}`;
              }
            }
          });

          // Make focus visible
          row.setAttribute('tabindex', '0');
        });
      }

      initNarrativeRows();
      document.addEventListener('astro:page-load', initNarrativeRows);
      document.addEventListener('astro:after-swap', initNarrativeRows);
    </script>

    <script>
      // @ts-nocheck
      function initCommercialCards() {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initCommercialCards);
          return;
        }
        if (document.body.dataset.commercialBound === '1') return;
        document.body.dataset.commercialBound = '1';

        document.querySelectorAll('.commercial-card[data-company-slug]').forEach(card => {
          const slug = card.dataset.companySlug;
          if (!slug) return;

          card.style.cursor = 'pointer';

          card.addEventListener('click', (e) => {
            // Keep thumbnail/video links intact — don't redirect to company page
            if (e.target.closest('.mini-thumb')) return;
            // If clicking the title link itself, let native navigation handle it
            if (e.target.closest('a[href^="/companies"]')) return;
            // Also avoid capturing clicks on any external link (video reels)
            if (e.target.closest('a[target="_blank"]')) return;
            window.location.href = `/companies/${slug}`;
          });

          // Keyboard accessibility
          card.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              const target = e.target;
              if (target.closest && (target.closest('.mini-thumb') || target.closest('a[target="_blank"]'))) return;
              window.location.href = `/companies/${slug}`;
            }
          });

          card.setAttribute('tabindex', '0');
          card.setAttribute('role', 'link');
          card.setAttribute('aria-label', `View ${card.querySelector('h3')?.textContent?.trim()} detail`);
        });
      }

      initCommercialCards();
      document.addEventListener('astro:page-load', initCommercialCards);
      document.addEventListener('astro:after-swap', initCommercialCards);
    </script>
    <Lightbox />
  </main>
</Layout>

<style>
  .narrative-cta{
    display:inline-block; margin-top: .6rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--brass); border-bottom: 1px solid var(--oxblood); padding-bottom: 2px;
  }
  .narrative-cta:hover{ color: var(--ecru); border-color: var(--brass); }

  .commercial-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .commercial-card-link:hover h3 { color: var(--brass); }
  .commercial-card-link:focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; border-radius: 2px; }
  .commercial-card-title-link{ color: inherit; text-decoration: none; border-bottom: 1px solid transparent; transition: color .2s, border-color .2s; }
  .commercial-card-title-link:hover, .commercial-card:hover .commercial-card-title-link{ color: var(--brass); border-color: rgba(212,162,76,0.35); }
  .commercial-card:focus-visible{ outline: 2px solid var(--brass); outline-offset: 3px; }
  .commercial-card-cta{
    display: inline-block; margin-top: 1rem; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase;
    color: var(--brass); border-bottom: 1px solid var(--oxblood); padding-bottom: 2px; align-self: flex-start;
    transition: color .2s, border-color .2s;
  }
  .commercial-card:hover .commercial-card-cta{ color: var(--ecru); border-color: var(--brass); }
</style>
