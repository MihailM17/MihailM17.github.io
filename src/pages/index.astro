---
// ALL EDITABLE TEXT IS IN src/content/ (collections)
import Layout from '../layouts/Layout.astro';
import CdArchive from '../components/CdArchive.astro';
import FilmStrip from '../components/FilmStrip.astro';
import Lightbox from '../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portraitImg from '../assets/portrait.jpg';
import { resolveMedia } from '../lib/media';

const projects = await getCollection('projects');
const siteContent = (await getCollection('site'))[0]?.data;
const c = siteContent;
const galleryItems = siteContent.gallery.items;

const featured =
  projects.find((p) => p.data.slug === 'silent-lifts-vitosha')?.data || projects[0]?.data;
const featuredTitle =
  featured?.slug === 'silent-lifts-vitosha' && featured.titleEn
    ? featured.titleEn
    : featured?.title || 'The Silent Lifts of Vitosha';
const featuredMedia = resolveMedia('/vitosha_shot_on_film.jpg');
---

<Layout
  title={c.siteTitle}
  description="Mihail Mihaylov — film student in Sofia, Bulgaria, working across directing, editing, documentary, and live production."
  ogImage="/og-cover.jpg"
>
  <main id="main">
    <!-- 1. HOME: Featured Project & Quiet Introduction -->
    <section id="top" class="featured-hero">
      <div class="container featured-hero-inner">
        <div class="hero-intro-bar">
          <span class="hero-name">Mihail Mihaylov</span>
          <span class="hero-intro-sep" aria-hidden="true">·</span>
          <p class="hero-intro-note">Film student in Sofia, directing &amp; editing.</p>
        </div>

        {featured && (
          <div class="featured-stage">
            <a
              href={`/projects/${featured.slug}`}
              class="featured-frame"
              aria-label={`Open ${featuredTitle} project page`}
              data-cursor-hover
              data-cursor-label="OPEN FILM"
            >
              {featuredMedia ? (
                <Image
                  src={featuredMedia}
                  alt={`${featuredTitle} — 35mm still on Vitosha Mountain`}
                  widths={[480, 768, 1180, 1600]}
                  sizes="(max-width: 720px) 100vw, min(1180px, 92vw)"
                  format="webp"
                  quality={84}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              ) : (
                <img
                  src="/og-cover.jpg"
                  alt={`${featuredTitle} — 35mm still on Vitosha Mountain`}
                  width="1600"
                  height="1055"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              )}
              <div class="featured-scrim" aria-hidden="true"></div>
            </a>

            <div class="featured-overlay">
              <span class="featured-kicker">Featured · Documentary · {featured.year}</span>
              <h1>{featuredTitle}</h1>
              <p class="featured-synopsis">{featured.synopsis}</p>
              <p class="featured-meta">{featured.kicker} · {featured.meta}</p>

              <div class="featured-actions">
                <a
                  href={featured.youtubeUrl}
                  data-video-url={featured.youtubeUrl}
                  data-video-title={featuredTitle}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pill-btn pill-btn--primary"
                  data-cursor-hover
                  data-cursor-label="PLAY"
                >
                  Watch film <span aria-hidden="true">▶</span>
                </a>
                <a
                  href={`/projects/${featured.slug}`}
                  class="pill-btn pill-btn--secondary"
                  data-cursor-hover
                  data-cursor-label="STORY"
                >
                  Read story <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- 2. ABOUT -->
    <section id="about" class="section about-section">
      <div class="container">
        <div class="about-grid">
          <div class="about-copy" data-reveal>
            <h2 class="about-heading">A little about me.</h2>
            <p class="about-para">{c.about.lead}</p>
            <p class="about-para">{c.about.p1}</p>
            <p class="about-para">{c.about.p2}</p>
          </div>
          <div class="portrait-panel" data-reveal>
            <Image
              src={portraitImg}
              alt={c.about.portraitAlt}
              widths={[400, 600, 800]}
              sizes="(max-width: 820px) 100vw, 400px"
              format="webp"
              quality={82}
              style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WORK: Interactive CD Collection -->
    <CdArchive id="work" title="Selected work" />

    <!-- 3.5. FILM STRIP: Selected Stills -->
    <FilmStrip title="Selected frames." items={galleryItems} />

    <!-- 4. CONTACT -->
    <section id="contact" class="section contact-section">
      <div class="container">
        <div class="contact-layout">
          <div class="contact-intro" data-reveal>
            <h2 class="contact-heading">Get in touch<em>.</em></h2>
            <p class="contact-lede">{c.contact.lede}</p>

            <div class="contact-channels">
              <div class="channel-row channel-row--email">
                <a
                  href={`mailto:${c.contact.email}`}
                  class="channel-main"
                  data-cursor-hover
                  data-cursor-label="MAIL"
                >
                  <span class="channel-label">Email</span>
                  <span class="channel-value">{c.contact.email}</span>
                </a>
                <button
                  type="button"
                  class="copy-email-btn"
                  data-copy-email={c.contact.email}
                  aria-label="Copy email address"
                >
                  Copy
                </button>
              </div>

              <a
                class="channel-row"
                href={c.contact.instagram}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor-hover
                data-cursor-label="OPEN"
              >
                <span class="channel-main">
                  <span class="channel-label">Instagram</span>
                  <span class="channel-value">@mihail.m4307</span>
                </span>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </a>

              <a
                class="channel-row"
                href={c.contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor-hover
                data-cursor-label="OPEN"
              >
                <span class="channel-main">
                  <span class="channel-label">LinkedIn</span>
                  <span class="channel-value">Mihail Mihaylov</span>
                </span>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </a>
            </div>

            <p class="contact-location">
              <span class="loc-dot" aria-hidden="true"></span>
              <span>Based in Sofia, Bulgaria · EET</span>
            </p>
          </div>

          <div class="contact-slate" data-reveal>
            <div class="slate-bar" aria-hidden="true">
              <span class="slate-tag">DIRECT MESSAGE</span>
              <span class="slate-meta">SOFIA · BG</span>
            </div>

            <form
              id="contact-form"
              class="slate-form"
              data-recipient={c.contact.email}
              novalidate
            >
              <div class="form-grid">
                <label>
                  <span>Name</span>
                  <input
                    type="text"
                    name="name"
                    required
                    placeholder="Your name"
                    autocomplete="name"
                    aria-describedby="err-name"
                  />
                  <span class="field-error" id="err-name" aria-live="polite"></span>
                </label>
                <label>
                  <span>Your Email</span>
                  <input
                    type="email"
                    name="email"
                    required
                    placeholder="you@email.com"
                    autocomplete="email"
                    aria-describedby="err-email"
                  />
                  <span class="field-error" id="err-email" aria-live="polite"></span>
                </label>
              </div>
              <label class="slate-field">
                <span>Subject <small class="field-opt">(optional)</small></span>
                <input
                  type="text"
                  name="subject"
                  placeholder="Project, collaboration, or just saying hello"
                  aria-describedby="err-subject"
                />
                <span class="field-error" id="err-subject" aria-live="polite"></span>
              </label>
              <label class="slate-field">
                <span>Message</span>
                <textarea
                  name="message"
                  required
                  placeholder="Tell me what you're working on..."
                  rows="5"
                  aria-describedby="err-message"
                ></textarea>
                <span class="field-error" id="err-message" aria-live="polite"></span>
              </label>

              <div class="slate-footer">
                <button
                  type="submit"
                  class="pill-btn pill-btn--primary slate-submit"
                  data-cursor-hover
                  data-cursor-label="SEND"
                >
                  Open in email app <span aria-hidden="true">→</span>
                </button>
                <p class="form-note slate-note">{c.contact.formNote}</p>
              </div>

              <div class="form-feedback">
                <p class="form-status" id="form-status" aria-live="polite"></p>
                <button
                  type="button"
                  id="copy-draft-btn"
                  class="copy-draft-btn"
                  hidden
                >
                  Copy formatted message
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

    <script>
      import { getSound } from '../lib/sound';

      function initContactForm() {
        const form = document.getElementById('contact-form') as HTMLFormElement | null;
        const status = document.getElementById('form-status') as HTMLElement | null;
        const copyDraftBtn = document.getElementById('copy-draft-btn') as HTMLButtonElement | null;
        if (!form || form.dataset.bound === '1') return;
        form.dataset.bound = '1';

        const recipient = form.dataset.recipient || 'mohailmihaylov2004@gmail.com';
        const errName = document.getElementById('err-name');
        const errEmail = document.getElementById('err-email');
        const errSubject = document.getElementById('err-subject');
        const errMessage = document.getElementById('err-message');
        let lastDraftText = '';

        const setErr = (el: HTMLElement | null, input: Element | null, msg: string) => {
          if (el) el.textContent = msg || '';
          if (input) {
            if (msg) input.setAttribute('aria-invalid', 'true');
            else input.removeAttribute('aria-invalid');
          }
        };

        const setStatus = (msg: string, state: '' | 'error' | 'success' = '') => {
          if (!status) return;
          status.textContent = msg;
          if (state) status.dataset.state = state;
          else delete status.dataset.state;
        };

        const clearAll = () => {
          setErr(errName, form.querySelector('[name="name"]'), '');
          setErr(errEmail, form.querySelector('[name="email"]'), '');
          setErr(errSubject, form.querySelector('[name="subject"]'), '');
          setErr(errMessage, form.querySelector('[name="message"]'), '');
          setStatus('');
        };

        ['name', 'email', 'subject', 'message'].forEach((n) => {
          const inp = form.querySelector(`[name="${n}"]`);
          inp?.addEventListener('input', () => {
            setErr(document.getElementById(`err-${n}`), inp, '');
            setStatus('');
          });
        });

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          clearAll();

          const data = new FormData(form);
          const name = (data.get('name') || '').toString().trim();
          const email = (data.get('email') || '').toString().trim();
          const subjectRaw = (data.get('subject') || '').toString().trim();
          const subject = subjectRaw || 'Portfolio inquiry';
          const message = (data.get('message') || '').toString().trim();

          let firstInvalid: HTMLElement | null = null;
          if (!name || name.length < 2) {
            const inp = form.querySelector<HTMLElement>('[name="name"]');
            setErr(errName, inp, 'Please enter your name (at least 2 characters).');
            firstInvalid ||= inp;
          }
          const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
          if (!email || !emailOk) {
            const inp = form.querySelector<HTMLElement>('[name="email"]');
            setErr(errEmail, inp, 'Please enter a valid email address.');
            firstInvalid ||= inp;
          }
          if (!message || message.length < 10) {
            const inp = form.querySelector<HTMLElement>('[name="message"]');
            setErr(errMessage, inp, 'Please write a short message (at least 10 characters).');
            firstInvalid ||= inp;
          }

          if (firstInvalid) {
            getSound().playError();
            setStatus('Please fix the highlighted fields above.', 'error');
            firstInvalid.focus();
            return;
          }

          const bodyLines = [
            `Hi Mihail,`,
            ``,
            message,
            ``,
            `—`,
            `From: ${name} (${email})`,
          ];
          const body = bodyLines.join('\n');
          const mailtoUrl = `mailto:${encodeURIComponent(recipient)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

          lastDraftText = `To: ${recipient}\nSubject: ${subject}\n\n${body}`;
          if (copyDraftBtn) {
            copyDraftBtn.hidden = false;
            copyDraftBtn.textContent = 'Copy formatted message';
          }

          getSound().playSend();
          // Open visitor's email client cleanly via anchor click
          const link = document.createElement('a');
          link.href = mailtoUrl;
          link.style.display = 'none';
          document.body.appendChild(link);
          link.click();
          link.remove();

          setStatus(
            `Opened a draft to ${recipient} in your email app. Using webmail? Copy the formatted message below.`,
            'success',
          );
        });

        copyDraftBtn?.addEventListener('click', async () => {
          if (!lastDraftText) return;
          try {
            await navigator.clipboard.writeText(lastDraftText);
            getSound().playCopy();
            copyDraftBtn.textContent = 'Message copied ✓';
            setTimeout(() => {
              copyDraftBtn.textContent = 'Copy formatted message';
            }, 2200);
          } catch {
            setStatus(`Copy failed — email ${recipient} directly.`, 'error');
          }
        });

        // One-click copy email button
        const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-email]');
        if (copyBtn && copyBtn.dataset.bound !== '1') {
          copyBtn.dataset.bound = '1';
          copyBtn.addEventListener('click', async () => {
            const addr = copyBtn.getAttribute('data-copy-email') || '';
            try {
              await navigator.clipboard.writeText(addr);
              getSound().playCopy();
              copyBtn.textContent = 'Copied ✓';
              copyBtn.classList.add('is-copied');
              setTimeout(() => {
                copyBtn.textContent = 'Copy';
                copyBtn.classList.remove('is-copied');
              }, 2000);
            } catch {
              window.location.href = `mailto:${addr}`;
            }
          });
        }
      }

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initContactForm);
      else initContactForm();
      document.addEventListener('astro:page-load', initContactForm);
      document.addEventListener('astro:after-swap', initContactForm);
    </script>

    <Lightbox />
  </main>
</Layout>

<style>
  /* ==========================================================================
     FEATURED PROJECT HERO
     ========================================================================== */
  .featured-hero {
    position: relative;
    padding-block: clamp(1.6rem, 3.2vw, 2.75rem) clamp(3.75rem, 6.5vw, 5.75rem);
    background:
      radial-gradient(ellipse 760px 380px at 78% 8%, rgba(212, 162, 76, 0.08), transparent 62%),
      radial-gradient(ellipse 560px 340px at 12% 88%, rgba(178, 58, 46, 0.07), transparent 64%),
      #181311;
    overflow: clip;
  }

  .hero-intro-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.75rem;
    margin-bottom: clamp(1rem, 2vw, 1.4rem);
    animation: heroFadeIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .hero-name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ecru);
  }
  .hero-intro-sep {
    color: var(--brass);
    font-family: var(--font-mono);
  }
  .hero-intro-note {
    font-family: var(--font-body);
    font-size: 1rem;
    font-style: italic;
    color: var(--ash);
    margin: 0;
  }

  .featured-stage {
    position: relative;
    border: 1px solid var(--border-subtle);
    background: var(--ink-2);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 24px), calc(100% - 24px) 100%, 0 100%);
    overflow: hidden;
    animation: heroFadeIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.06s both;
  }

  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-intro-bar,
    .featured-stage {
      animation: none;
    }
  }

  .featured-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 440px;
    max-height: 76vh;
    overflow: hidden;
    background: var(--surface-0);
  }
  .featured-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    filter: contrast(1.04) saturate(0.92);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }
  .featured-stage:hover .featured-frame img {
    transform: scale(1.025);
    filter: contrast(1.06) saturate(0.98);
  }

  /* Deep bottom-left scrim guarantees WCAG AA >= 4.5:1 over bright film highlights */
  .featured-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(14, 11, 9, 0.14) 0%,
        rgba(14, 11, 9, 0.32) 38%,
        rgba(14, 11, 9, 0.9) 76%,
        rgba(14, 11, 9, 0.98) 100%
      ),
      linear-gradient(
        90deg,
        rgba(14, 11, 9, 0.84) 0%,
        rgba(14, 11, 9, 0.48) 54%,
        transparent 85%
      );
  }

  .featured-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: clamp(1.5rem, 3.8vw, 2.8rem);
    pointer-events: none;
  }
  .featured-overlay a {
    pointer-events: auto;
  }

  .featured-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.65rem;
  }

  .featured-overlay h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 5vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ecru);
    max-width: 16ch;
    margin: 0 0 0.85rem;
  }

  .featured-synopsis {
    max-width: 52ch;
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.55vw, 1.15rem);
    line-height: 1.55;
    color: rgba(239, 230, 216, 0.94);
    margin: 0 0 0.55rem;
  }

  .featured-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--ash);
    margin: 0 0 1.35rem;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 720px) {
    .featured-frame {
      min-height: 220px;
      aspect-ratio: 16 / 10;
    }
    .featured-scrim {
      background: linear-gradient(180deg, transparent 55%, rgba(14, 11, 9, 0.55) 100%);
    }
    .featured-overlay {
      position: relative;
      padding: 1.35rem 1.2rem 1.6rem;
      background: var(--ink-2);
      border-top: 1px solid var(--border-soft);
    }
    .featured-overlay h1 {
      font-size: clamp(1.65rem, 7vw, 2.3rem);
      max-width: none;
    }
    .featured-meta {
      line-height: 1.5;
    }
  }

  /* ==========================================================================
     ABOUT (UNDERSTATED, BALANCED)
     ========================================================================== */
  .about-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--h2-size);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0 0 var(--sp-3);
    max-width: 18ch;
  }
  .about-para {
    font-family: var(--font-body);
    font-size: clamp(1.04rem, 1.5vw, 1.14rem);
    line-height: 1.72;
    color: rgba(239, 230, 216, 0.92);
    max-width: 54ch;
    margin: 0 0 1.2em;
  }
  .about-para:last-child {
    margin-bottom: 0;
  }

  /* ==========================================================================
     CONTACT (EDITORIAL CLOSING SLATE)
     ========================================================================== */
  .contact-layout {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 880px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }

  .contact-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--h2-size);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0 0 1.15rem;
    max-width: none;
  }
  .contact-heading em {
    font-style: normal;
    color: var(--brass);
  }

  .contact-intro .contact-lede {
    font-family: var(--font-body);
    font-size: clamp(1.04rem, 1.55vw, 1.18rem);
    line-height: 1.65;
    color: rgba(239, 230, 216, 0.9);
    max-width: 42ch;
    margin: 0 0 2rem;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--border-subtle);
  }
  .channel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0.25rem;
    min-height: 56px;
    border-bottom: 1px solid var(--border-soft);
    transition: border-color 0.25s ease, padding-left 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  a.channel-row:hover {
    border-bottom-color: var(--brass);
    padding-left: 0.55rem;
  }
  .channel-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }
  .channel-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .channel-value {
    font-family: var(--font-body);
    font-size: 1.08rem;
    color: var(--ecru);
    transition: color 0.2s ease;
    overflow-wrap: anywhere;
  }
  .channel-row:hover .channel-value,
  .channel-main:hover .channel-value {
    color: var(--brass);
  }
  .channel-arrow {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--ash);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  a.channel-row:hover .channel-arrow {
    color: var(--brass);
    transform: translate(3px, -3px);
  }

  .copy-email-btn {
    flex-shrink: 0;
    min-height: 44px;
    min-width: 44px;
