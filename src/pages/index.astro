---
// ALL EDITABLE TEXT IS IN src/content/ (collections)
import Layout from '../layouts/Layout.astro';
import CdArchive from '../components/CdArchive.astro';
import FilmStrip from '../components/FilmStrip.astro';
import Lightbox from '../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portraitImg from '../assets/portrait.jpg';

const projects = await getCollection('projects');
const siteContent = (await getCollection('site'))[0]?.data;
const c = siteContent;
const galleryItems = siteContent.gallery.items;

const featured =
  projects.find((p) => p.data.slug === 'silent-lifts-vitosha')?.data || projects[0]?.data;
const featuredTitle =
  featured?.slug === 'silent-lifts-vitosha' && featured.titleEn
    ? featured.titleEn
    : featured?.title || 'The Silent Lifts of Vitosha';
const featuredStill = '/vitosha_shot_on_film.jpg';
---

<Layout title={c.siteTitle}>
  <main>
    <!-- 1. HOME: Featured Project & Quiet Introduction -->
    <section id="top" class="featured-hero">
      <div class="container featured-hero-inner">
        <div class="hero-intro-bar" data-reveal>
          <span class="hero-name">Mihail Mihaylov</span>
          <span class="hero-intro-sep" aria-hidden="true">·</span>
          <p class="hero-intro-note">Film student in Sofia, directing &amp; editing.</p>
        </div>

        {featured && (
          <div class="featured-stage" data-reveal>
            <a
              href={`/projects/${featured.slug}`}
              class="featured-frame"
              aria-label={`Open ${featuredTitle} project page`}
              data-cursor-hover
              data-cursor-label="OPEN FILM"
            >
              <img
                src={featuredStill}
                alt={`${featuredTitle} — 35mm still on Vitosha Mountain`}
                loading="eager"
                decoding="async"
                onerror={`this.onerror=null;this.src='${featured.cover}'`}
              />
              <div class="featured-scrim" aria-hidden="true"></div>
            </a>

            <div class="featured-overlay">
              <span class="featured-kicker">Featured · Documentary · {featured.year}</span>
              <h1>{featuredTitle}</h1>
              <p class="featured-synopsis">{featured.synopsis}</p>
              <p class="featured-meta">{featured.kicker} · {featured.meta}</p>

              <div class="featured-actions">
                <a
                  href={featured.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="featured-btn featured-btn--primary"
                  data-cursor-hover
                  data-cursor-label="WATCH"
                >
                  Watch film <span aria-hidden="true">↗</span>
                </a>
                <a
                  href={`/projects/${featured.slug}`}
                  class="featured-btn featured-btn--secondary"
                  data-cursor-hover
                  data-cursor-label="STORY"
                >
                  Read story <span aria-hidden="true">→</span>
                </a>
                <a
                  href="#work"
                  class="featured-btn featured-btn--ghost"
                  data-cursor-hover
                  data-cursor-label="WORK"
                >
                  Explore all work <span aria-hidden="true">↓</span>
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- 2. ABOUT -->
    <section id="about" class="section about-section">
      <div class="container">
        <div class="about-grid">
          <div class="about-copy" data-reveal>
            <span class="eyebrow">{c.about.kicker}</span>
            <h2 class="about-heading">A little about me.</h2>
            <p class="about-para">{c.about.lead}</p>
            <p class="about-para">{c.about.p1}</p>
            <p class="about-para">{c.about.p2}</p>
          </div>
          <div class="portrait-panel" data-reveal data-cursor-hover data-cursor-label="MIHAIL">
            <Image
              src={portraitImg}
              alt={c.about.portraitAlt}
              widths={[400, 600, 800]}
              sizes="(max-width: 820px) 100vw, 400px"
              style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 3. WORK: Interactive CD Collection -->
    <CdArchive id="work" eyebrow="Work" title="Selected work" />

    <!-- 3.5. FILM STRIP: Selected Stills -->
    <FilmStrip eyebrow="Stills" title="Selected frames." items={galleryItems} />

    <!-- 4. CONTACT -->
    <section id="contact" class="section contact-section">
      <div class="container">
        <div class="contact-layout">
          <div class="contact-intro" data-reveal>
            <span class="eyebrow">{c.contact.kicker}</span>
            <h2 class="contact-heading">Get in touch<em>.</em></h2>
            <p class="contact-lede">{c.contact.lede}</p>

            <div class="contact-channels">
              <div class="channel-row channel-row--email">
                <a
                  href={`mailto:${c.contact.email}`}
                  class="channel-main"
                  data-cursor-hover
                  data-cursor-label="MAIL"
                >
                  <span class="channel-label">Email</span>
                  <span class="channel-value">{c.contact.email}</span>
                </a>
                <button
                  type="button"
                  class="copy-email-btn"
                  data-copy-email={c.contact.email}
                  aria-label="Copy email address"
                >
                  Copy
                </button>
              </div>

              <a
                class="channel-row"
                href={c.contact.instagram}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor-hover
                data-cursor-label="OPEN"
              >
                <span class="channel-main">
                  <span class="channel-label">Instagram</span>
                  <span class="channel-value">@mihail.m4307</span>
                </span>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </a>

              <a
                class="channel-row"
                href={c.contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                data-cursor-hover
                data-cursor-label="OPEN"
              >
                <span class="channel-main">
                  <span class="channel-label">LinkedIn</span>
                  <span class="channel-value">Mihail Mihaylov</span>
                </span>
                <span class="channel-arrow" aria-hidden="true">↗</span>
              </a>
            </div>

            <p class="contact-location">
              <span class="loc-dot" aria-hidden="true"></span>
              <span>Based in Sofia, Bulgaria · EET</span>
            </p>
          </div>

          <div class="contact-slate" data-reveal>
            <div class="slate-bar" aria-hidden="true">
              <span class="slate-tag">DIRECT MESSAGE</span>
              <span class="slate-meta">SOFIA · BG</span>
            </div>

            <form id="contact-form" class="slate-form" novalidate>
              <div class="form-grid">
                <label>
                  <span>Name</span>
                  <input
                    type="text"
                    name="name"
                    required
                    placeholder="Your name"
                    autocomplete="name"
                    aria-describedby="err-name"
                  />
                  <span class="field-error" id="err-name" aria-live="polite"></span>
                </label>
                <label>
                  <span>Your Email</span>
                  <input
                    type="email"
                    name="email"
                    required
                    placeholder="you@email.com"
                    autocomplete="email"
                    aria-describedby="err-email"
                  />
                  <span class="field-error" id="err-email" aria-live="polite"></span>
                </label>
              </div>
              <label class="slate-field">
                <span>Subject</span>
                <input
                  type="text"
                  name="subject"
                  placeholder="Project, collaboration, or just saying hello"
                  required
                  aria-describedby="err-subject"
                />
                <span class="field-error" id="err-subject" aria-live="polite"></span>
              </label>
              <label class="slate-field">
                <span>Message</span>
                <textarea
                  name="message"
                  required
                  placeholder="Tell me what you're working on..."
                  rows="5"
                  aria-describedby="err-message"
                ></textarea>
                <span class="field-error" id="err-message" aria-live="polite"></span>
              </label>

              <div class="slate-footer">
                <button type="submit" class="form-submit slate-submit" data-cursor-hover data-cursor-label="SEND">
                  Send message <span aria-hidden="true">→</span>
                </button>
                <p class="form-note slate-note">{c.contact.formNote}</p>
              </div>
              <p class="form-status" id="form-status" aria-live="polite"></p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <script>
      // @ts-nocheck
      import { actions } from 'astro:actions';

      function initContactForm() {
        const form = document.getElementById('contact-form');
        const status = document.getElementById('form-status');
        if (!form || form.dataset.bound === '1') return;
        form.dataset.bound = '1';
        const errName = document.getElementById('err-name');
        const errEmail = document.getElementById('err-email');
        const errSubject = document.getElementById('err-subject');
        const errMessage = document.getElementById('err-message');
        const setErr = (el, input, msg) => {
          if (el) el.textContent = msg || '';
          if (input) {
            if (msg) input.setAttribute('aria-invalid', 'true');
            else input.removeAttribute('aria-invalid');
          }
        };
        const clearAll = () => {
          setErr(errName, form.querySelector('[name="name"]'), '');
          setErr(errEmail, form.querySelector('[name="email"]'), '');
          setErr(errSubject, form.querySelector('[name="subject"]'), '');
          setErr(errMessage, form.querySelector('[name="message"]'), '');
          if (status) status.textContent = '';
        };
        ['name', 'email', 'subject', 'message'].forEach((n) => {
          const inp = form.querySelector(`[name="${n}"]`);
          if (inp) {
            inp.addEventListener('input', () => {
              const errEl = document.getElementById(`err-${n}`);
              setErr(errEl, inp, '');
              if (status) status.textContent = '';
            });
          }
        });
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          clearAll();
          const data = new FormData(form);
          const name = (data.get('name') || '').toString().trim();
          const email = (data.get('email') || '').toString().trim();
          const subject = (data.get('subject') || '').toString().trim() || 'Portfolio inquiry';
          const message = (data.get('message') || '').toString().trim();
          let hasError = false;
          if (!name || name.length < 2) {
            setErr(errName, form.querySelector('[name="name"]'), 'Name required - at least 2 characters.');
            hasError = true;
          }
          const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
          if (!email || !emailOk) {
            setErr(errEmail, form.querySelector('[name="email"]'), 'Valid email required - e.g., name@domain.com');
            hasError = true;
          }
          if (!subject || subject.length < 3) {
            setErr(
              errSubject,
              form.querySelector('[name="subject"]'),
              'Subject required - 3+ characters or leave as “Portfolio inquiry”.',
            );
            hasError = true;
          }
          if (!message || message.length < 10) {
            setErr(
              errMessage,
              form.querySelector('[name="message"]'),
              'Message required - 10+ characters so I can reply usefully.',
            );
            hasError = true;
          }
          if (hasError) {
            if (status) status.textContent = 'Fix the fields above - not sent yet.';
            return;
          }
          if (!navigator.onLine) {
            if (status) status.textContent = 'You appear offline - message not sent. Copy your text and email directly.';
            return;
          }
          if (status) status.textContent = 'Sending…';
          const submitBtn = form.querySelector('.form-submit');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending…';
          }
          try {
            const { error } = await actions.sendEmail({ name, email, subject, message });
            if (error) {
              if (status) {
                status.textContent = `Couldn’t send: ${error.message} - try email directly: ${form.querySelector('a[href^="mailto:"]')?.href || 'mohailmihaylov2004@gmail.com'}`;
              }
            } else {
              if (status) status.textContent = 'Sent - I’ll reply within 24h (Sofia time). Check spam if you don’t hear back.';
              form.reset();
            }
          } catch (err) {
            if (status) status.textContent = 'Network error - not sent. Please email directly or try again.';
            console.error(err);
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = 'Send message <span aria-hidden="true">→</span>';
            }
          }
        });

        // One-click copy email button
        const copyBtn = document.querySelector('[data-copy-email]');
        if (copyBtn && copyBtn.dataset.bound !== '1') {
          copyBtn.dataset.bound = '1';
          copyBtn.addEventListener('click', async () => {
            const addr = copyBtn.getAttribute('data-copy-email') || '';
            try {
              await navigator.clipboard.writeText(addr);
              copyBtn.textContent = 'Copied ✓';
              copyBtn.classList.add('is-copied');
              setTimeout(() => {
                copyBtn.textContent = 'Copy';
                copyBtn.classList.remove('is-copied');
              }, 2000);
            } catch {
              window.location.href = `mailto:${addr}`;
            }
          });
        }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initContactForm);
      else initContactForm();
      document.addEventListener('astro:page-load', initContactForm);
      document.addEventListener('astro:after-swap', initContactForm);
    </script>

    <Lightbox />
  </main>
</Layout>

<style>
  /* ==========================================================================
     FEATURED PROJECT HERO
     ========================================================================== */
  .featured-hero {
    position: relative;
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(4rem, 7vw, 6.25rem);
    background:
      radial-gradient(ellipse 760px 380px at 78% 8%, rgba(212, 162, 76, 0.08), transparent 62%),
      radial-gradient(ellipse 560px 340px at 12% 88%, rgba(178, 58, 46, 0.07), transparent 64%),
      #181311;
    overflow: clip;
  }

  .hero-intro-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.75rem;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .hero-name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ecru);
  }
  .hero-intro-sep {
    color: var(--brass);
    font-family: var(--font-mono);
  }
  .hero-intro-note {
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-style: italic;
    color: var(--ash);
    margin: 0;
  }

  .featured-stage {
    position: relative;
    border: 1px solid rgba(239, 230, 216, 0.14);
    background: var(--ink-2);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 24px), calc(100% - 24px) 100%, 0 100%);
    overflow: hidden;
  }

  .featured-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 420px;
    max-height: 76vh;
    overflow: hidden;
    background: #120e0c;
  }
  .featured-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    filter: contrast(1.04) saturate(0.92);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }
  .featured-stage:hover .featured-frame img {
    transform: scale(1.025);
    filter: contrast(1.06) saturate(0.98);
  }

  .featured-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(18, 14, 12, 0.14) 0%, rgba(18, 14, 12, 0.25) 42%, rgba(18, 14, 12, 0.88) 84%, rgba(18, 14, 12, 0.96) 100%),
      linear-gradient(90deg, rgba(18, 14, 12, 0.68) 0%, rgba(18, 14, 12, 0.24) 52%, transparent 80%);
  }

  .featured-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: clamp(1.4rem, 3.8vw, 2.8rem);
    pointer-events: none;
  }
  .featured-overlay a {
    pointer-events: auto;
  }

  .featured-kicker {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass);
    margin-bottom: 0.65rem;
  }

  .featured-overlay h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 5vw, 3.85rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--ecru);
    max-width: 16ch;
    margin: 0 0 0.85rem;
  }

  .featured-synopsis {
    max-width: 52ch;
    font-family: var(--font-body);
    font-size: clamp(0.98rem, 1.55vw, 1.15rem);
    line-height: 1.55;
    color: rgba(239, 230, 216, 0.9);
    margin: 0 0 0.55rem;
  }

  .featured-meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
    margin: 0 0 1.35rem;
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.8rem;
  }

  .featured-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.68rem 1.15rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 0.22s ease, color 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
  }
  .featured-btn--primary {
    background: var(--brass);
    color: var(--ink);
    border: 1px solid var(--brass);
    font-weight: 700;
  }
  .featured-btn--primary:hover {
    background: var(--ecru);
    border-color: var(--ecru);
    color: var(--ink);
    transform: translateY(-1px);
  }
  .featured-btn--secondary {
    background: rgba(28, 22, 20, 0.68);
    color: var(--ecru);
    border: 1px solid rgba(239, 230, 216, 0.3);
    backdrop-filter: blur(8px);
  }
  .featured-btn--secondary:hover {
    border-color: var(--brass);
    color: var(--brass);
    transform: translateY(-1px);
  }
  .featured-btn--ghost {
    background: transparent;
    color: var(--ash);
    border: 1px solid transparent;
    padding-inline: 0.65rem;
  }
  .featured-btn--ghost:hover {
    color: var(--ecru);
  }

  /* On smaller screens, place caption cleanly underneath the film frame so the still breathes */
  @media (max-width: 720px) {
    .featured-frame {
      min-height: 220px;
      aspect-ratio: 16 / 10;
    }
    .featured-scrim {
      background: linear-gradient(180deg, transparent 55%, rgba(18, 14, 12, 0.55) 100%);
    }
    .featured-overlay {
      position: relative;
      padding: 1.25rem 1.15rem 1.5rem;
      background: var(--ink-2);
      border-top: 1px solid rgba(239, 230, 216, 0.08);
    }
    .featured-overlay h1 {
      font-size: clamp(1.65rem, 7vw, 2.3rem);
      max-width: none;
    }
    .featured-meta {
      font-size: 0.66rem;
      line-height: 1.5;
    }
    .featured-btn {
      font-size: 0.68rem;
      padding: 0.6rem 0.95rem;
    }
  }

  /* ==========================================================================
     ABOUT (UNDERSTATED, BALANCED)
     ========================================================================== */
  .about-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.85rem, 4.2vw, 2.85rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0 0 var(--sp-3);
    max-width: 18ch;
  }
  .about-para {
    font-family: var(--font-body);
    font-size: clamp(1.02rem, 1.5vw, 1.14rem);
    line-height: 1.72;
    color: rgba(239, 230, 216, 0.9);
    max-width: 54ch;
    margin: 0 0 1.2em;
  }
  .about-para:last-child {
    margin-bottom: 0;
  }

  /* ==========================================================================
     CONTACT (EDITORIAL CLOSING SLATE)
     ========================================================================== */
  .contact-layout {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 880px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }

  .contact-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 4.8vw, 3.35rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--ecru);
    margin: 0 0 1.15rem;
    max-width: none;
  }
  .contact-heading em {
    font-style: normal;
    color: var(--brass);
  }

  .contact-intro .contact-lede {
    font-family: var(--font-body);
    font-size: clamp(1.04rem, 1.55vw, 1.18rem);
    line-height: 1.65;
    color: rgba(239, 230, 216, 0.88);
    max-width: 42ch;
    margin: 0 0 2rem;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(239, 230, 216, 0.12);
  }
  .channel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid rgba(239, 230, 216, 0.1);
    transition: border-color 0.25s ease, padding-left 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  a.channel-row:hover {
    border-bottom-color: var(--brass);
    padding-left: 0.55rem;
  }
  .channel-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    flex: 1;
  }
  .channel-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .channel-value {
    font-family: var(--font-body);
    font-size: 1.08rem;
    color: var(--ecru);
    transition: color 0.2s ease;
    overflow-wrap: anywhere;
  }
  .channel-row:hover .channel-value,
  .channel-main:hover .channel-value {
    color: var(--brass);
  }
  .channel-arrow {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ash);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease;
  }
  a.channel-row:hover .channel-arrow {
    color: var(--brass);
    transform: translate(3px, -3px);
  }

  .copy-email-btn {
    flex-shrink: 0;
    padding: 0.38rem 0.72rem;
    border-radius: 999px;
    border: 1px solid rgba(239, 230, 216, 0.18);
    background: rgba(28, 22, 20, 0.6);
    color: var(--ash);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
