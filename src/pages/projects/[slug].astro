---
import Layout from '../../layouts/Layout.astro';
import SpliceStrip from '../../components/SpliceStrip.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p } }));
}

const { project } = Astro.props;
if (!project) throw new Error('Project not found');
const { slug } = Astro.params;

// Need to fetch all projects again for prev/next navigation
const allProjects = await getCollection('projects');
const projectMap = new Map(allProjects.map(p => [p.data.slug, p]));
const current = projectMap.get(slug);
if (!current) throw new Error('Project not found');
const idx = allProjects.findIndex((p) => p.data.slug === slug);
const prev = idx > 0 ? allProjects[idx - 1] : null;
const next = idx < allProjects.length - 1 ? allProjects[idx + 1] : null;
// Use English title for projects that have distinct English titles, otherwise use Bulgarian title
const hasEnglishTitle = current.data.titleEn && current.data.titleEn !== current.data.title;
const displayTitle = hasEnglishTitle ? current.data.titleEn : current.data.title;
const displayTitleEn = hasEnglishTitle ? current.data.title : current.data.titleEn;
const projectData = current.data;
---

<Layout title={`${displayTitle}, ${projectData.year} — Mihail Mihaylov`}>
  <main>
    <div class="container" style="padding-top: 1.6rem;">
      <a href="/#narrative" class="back-link" data-cursor-hover data-cursor-label="BACK">← Back to Narrative</a>
    </div>

    <section class="project-hero">
      <div class="container project-hero-inner">
        <div class="hero-meta" data-reveal>
          <span class="eyebrow" style="margin-bottom: 0.6rem;">{projectData.kicker} — {projectData.year}</span>
          <span class="index-badge">{projectData.index}</span>
        </div>
        <h1 data-reveal>
          <span class="line"><span>{displayTitle},</span></span>
          <span class="line"><span class="outline">{projectData.year}</span></span>
        </h1>
        <p class="hero-en" data-reveal>{hasEnglishTitle ? <><em>{displayTitleEn}</em> — </> : ''}{projectData.meta}</p>
        <p class="project-synopsis" data-reveal>{projectData.synopsis}</p>
      </div>

      <div class="project-cover-wrap container" data-reveal data-parallax="0.08">
        <a href={projectData.youtubeUrl} target="_blank" rel="noopener noreferrer" class="project-cover" aria-label={`Watch ${displayTitle} on YouTube`} data-cursor-hover data-cursor-label="PLAY ON YOUTUBE">
          <img src={projectData.cover} alt={`${displayTitle} cover`} loading="eager" decoding="async" />
          <span class="play-badge"><i>▶</i> Watch Film</span>
        </a>
        <span class="cover-hint">Click image → YouTube · Bar links stay on site</span>
      </div>
    </section>

    <SpliceStrip />

    <section class="section specs-section">
      <div class="container specs-grid">
        <aside class="specs-aside" data-parallax="0.06">
          <span class="eyebrow">Specs</span>
          <ul>
            {projectData.specs.map((s) => (
              <li><b>{s.label}</b> <span>{s.value}</span></li>
            ))}
          </ul>
          <a href={projectData.youtubeUrl} target="_blank" rel="noopener noreferrer" class="specs-cta" data-cursor-hover data-cursor-label="YOUTUBE">Watch on YouTube →</a>
        </aside>

        <article class="story" data-parallax="0.12">
          <span class="eyebrow">Story</span>
          {projectData.story.map((para) => (
            <p data-reveal>{para}</p>
          ))}
        </article>
      </div>
    </section>

    <section class="section gallery-section" style="padding-top: 0;">
      <div class="container">
        <span class="eyebrow" data-reveal>Stills & Archive</span>
        <div class="gallery-grid">
          {projectData.gallery.length === 0 ? (
            <div class="empty-state">
              <b>No stills yet</b> — this film’s gallery is being assembled.<br/>
              For <em>{projectData.slug}</em>: add images to <code>src/content/projects/{projectData.slug}.json → gallery[]</code>.
            </div>
          ) : projectData.gallery.map((img, i) => (
            <figure class="gallery-card" data-reveal data-parallax={i % 2 === 0 ? "0.04" : "0.10"} data-lightbox data-src={img.src} data-caption={img.caption} data-cursor-hover data-cursor-label="VIEW">
              <div class="gallery-img-wrap skeleton" data-img-wrap>
                <img src={img.src} alt={img.alt} loading="lazy" decoding="async" onload="this.closest('[data-img-wrap]')?.classList.remove('skeleton')" onerror="this.style.display='none'; const fb=this.nextElementSibling; if(fb) fb.style.display='block'; this.closest('[data-img-wrap]')?.classList.remove('skeleton')" />
                <div class="img-error-fallback" style="display:none;">Image failed — <small>{img.src}</small></div>
              </div>
              <figcaption>{img.caption}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section nav-section">
      <div class="container nav-grid">
        {prev ? (
          <a href={`/projects/${prev.data.slug}`} class="nav-card nav-prev" data-cursor-hover data-cursor-label="PREV">
            <span class="eyebrow">Previous</span>
            <b>{prev.data.slug === 'silent-lifts-vitosha' ? prev.data.titleEn : prev.data.title}, {prev.data.year}</b>
            <span>{prev.data.kicker}</span>
          </a>
        ) : <span />}
        <a href="/#narrative" class="nav-center" data-cursor-hover>Narrative Index</a>
        {next ? (
          <a href={`/projects/${next.data.slug}`} class="nav-card nav-next" data-cursor-hover data-cursor-label="NEXT">
            <span class="eyebrow">Next</span>
            <b>{next.data.slug === 'silent-lifts-vitosha' ? next.data.titleEn : next.data.title}, {next.data.year}</b>
            <span>{next.data.kicker}</span>
          </a>
        ) : <span />}
      </div>
    </section>

    <SpliceStrip />
    <Lightbox />
  </main>
</Layout>

<style>
  .back-link{
    font-family: var(--font-mono); font-size: .78rem; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ash); border-bottom: 1px solid transparent; padding-bottom: 2px; transition: color .2s, border-color .2s;
  }
  .back-link:hover{ color: var(--ecru); border-color: var(--brass); }

  .project-hero{
    position: relative; padding-block: var(--sp-5) var(--sp-4);
    background: radial-gradient(ellipse at 72% 12%, rgba(178,58,46,.14), transparent 58%), var(--ink);
    overflow: clip;
  }
  .project-hero-inner{ position: relative; z-index: 1; }
  .hero-meta{ display:flex; align-items:center; gap: .85rem; }
  .index-badge{
    font-family: var(--font-mono); font-size: .78rem; letter-spacing: .14em;
    color: var(--brass); border: 1px solid var(--oxblood-dim); padding: .2rem .5rem;
  }
  .project-hero h1{
    font-family: var(--font-display); font-weight: 900; text-transform: uppercase;
    font-size: clamp(2.6rem, 9vw, 6.2rem); line-height: .9; letter-spacing: -.03em; color: var(--ecru);
    margin: .45em 0 .3em;
  }
  .project-hero h1 .line{ display:block; overflow:clip; }
  .project-hero h1 .outline{ color: transparent; -webkit-text-stroke: 1px rgba(239,230,216,.38); }
  .hero-en{ font-family: var(--font-mono); font-size: .8rem; letter-spacing: .06em; color: var(--ash); text-transform: uppercase; margin-bottom: 1rem; }
  .project-synopsis{ max-width: 58ch; font-size: clamp(1.05rem, 2vw, 1.25rem); font-style: italic; color: var(--ecru); border-left: 2px solid var(--oxblood); padding-left: 1rem; }

  .project-cover-wrap{ margin-top: var(--sp-4); }
  .project-cover{
    position: relative; display: block; aspect-ratio: 16/8.5; overflow: hidden;
    border: 1px solid rgba(239,230,216,.14); background: var(--ink-2);
    clip-path: polygon(0 0,100% 0,100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
  }
  .project-cover img{ width:100%; height:100%; object-fit:cover; transition: transform .7s cubic-bezier(.16,1,.3,1), filter .4s; filter: saturate(.95) contrast(1.04); }
  .project-cover:hover img{ transform: scale(1.03); filter: saturate(1); }
  .play-badge{
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    font-family: var(--font-mono); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase;
    color: var(--ecru); background: rgba(28,22,20,.82); border: 1px solid var(--brass);
    padding: .65rem 1rem; backdrop-filter: blur(6px); display:flex; gap:.5rem; align-items:center;
  }
  .play-badge i{ color: var(--brass); font-style: normal; }
  .cover-hint{ display:block; margin-top: .6rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ash); }

  .specs-grid{ display:grid; grid-template-columns: 300px 1fr; gap: var(--sp-5); align-items:start; }
  @media (max-width:900px){ .specs-grid{ grid-template-columns:1fr; } }
  .specs-aside{
    position: sticky; top: 92px; background: var(--ink-2); border: 1px solid var(--oxblood-dim);
    padding: 1.4rem; clip-path: polygon(0 0,100% 0,100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
  }
  .specs-aside ul{ margin-top: .9rem; display:grid; gap: .65rem; }
  .specs-aside li{ display:flex; justify-content:space-between; gap:1rem; font-family: var(--font-mono); font-size: .76rem; text-transform: uppercase; letter-spacing: .06em; color: var(--ash); border-bottom: 1px solid rgba(239,230,216,.08); padding-bottom: .5rem; }
  .specs-aside li b{ color: var(--ecru); }
  .specs-cta{ display:inline-block; margin-top: 1rem; font-family: var(--font-mono); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; color: var(--brass); border-bottom: 1px solid var(--oxblood); padding-bottom: 2px; }
  .story{ display:grid; gap: 1.1rem; }
  .story p{ color: var(--ecru); max-width: 58ch; line-height: 1.7; }
  .gallery-grid{ display:grid; grid-template-columns: repeat(auto-fit, minmax(280px,1fr)); gap: 1.4rem; }
  .gallery-card{ margin:0; cursor: zoom-in; }
  .gallery-img-wrap{ aspect-ratio: 3/2; overflow:hidden; border:1px solid rgba(239,230,216,.12); background: var(--ink-2); }
  .gallery-img-wrap img{ width:100%; height:100%; object-fit:cover; transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .gallery-card:hover img{ transform: scale(1.04); }
  .gallery-card:hover .gallery-img-wrap{ border-color: rgba(212,162,76,0.22); }
  .gallery-card figcaption{ margin-top: .5rem; font-family: var(--font-mono); font-size: .68rem; letter-spacing: .06em; text-transform: uppercase; color: var(--ash); }

  .nav-grid{ display:grid; grid-template-columns: 1fr auto 1fr; gap: 1rem; align-items:center; }
  .nav-card{ background: var(--ink-2); border: 1px solid var(--oxblood-dim); padding: 1rem 1.2rem; transition: border-color .25s, transform .25s; }
  .nav-card:hover{ border-color: var(--brass); transform: translateY(-2px); }
  .nav-card b{ display:block; font-family: var(--font-display); font-size: 1rem; color: var(--ecru); }
  .nav-card span{ font-family: var(--font-mono); font-size: .7rem; color: var(--ash); text-transform: uppercase; letter-spacing: .06em; }
  .nav-center{ font-family: var(--font-mono); font-size: .76rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ash); border-bottom:1px solid var(--brass); padding-bottom:2px; text-align:center; }
  @media (max-width:760px){ .nav-grid{ grid-template-columns:1fr; } .nav-center{ order:-1; } }
</style>

<script>
  // parallax already handled globally by LenisSmoothScroll via [data-parallax]
</script>
