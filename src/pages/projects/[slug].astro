---
import Layout from '../../layouts/Layout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveMedia, optimizeMediaUrl } from '../../lib/media';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects.map((p) => ({ params: { slug: p.data.slug }, props: { project: p } }));
}

const { project } = Astro.props;
if (!project) throw new Error('Project not found');
const { slug } = Astro.params;

const ORDER: Record<string, number> = {
  'silent-lifts-vitosha': 1,
  'lunen-blyasak': 2,
  'zasnet': 3,
  'remake-season-2': 4,
  'eastern-wind': 5,
};
const allProjects = (await getCollection('projects')).sort(
  (a, b) => (ORDER[a.data.slug] ?? 999) - (ORDER[b.data.slug] ?? 999),
);
const current = allProjects.find((p) => p.data.slug === slug);
if (!current) throw new Error('Project not found');
const idx = allProjects.findIndex((p) => p.data.slug === slug);
const prev = idx > 0 ? allProjects[idx - 1] : null;
const next = idx < allProjects.length - 1 ? allProjects[idx + 1] : null;

const hasEnglishTitle = current.data.titleEn && current.data.titleEn !== current.data.title;
const displayTitle = hasEnglishTitle ? current.data.titleEn : current.data.title;
const displayTitleAlt = hasEnglishTitle ? current.data.title : current.data.titleEn;
const projectData = current.data;
const gradeUrl = (projectData as any).gradeBreakdownUrl as string | undefined;
const gradeId = gradeUrl?.match(/(?:youtu\.be\/|v=)([\w-]{11})/)?.[1];

const coverMedia = resolveMedia(projectData.cover);
const ogCover = await optimizeMediaUrl(projectData.cover, 1200, 82);

const galleryItems = await Promise.all(
  (projectData.gallery || []).map(async (img) => ({
    ...img,
    media: resolveMedia(img.src),
    lightboxSrc: await optimizeMediaUrl(img.src, 1600, 84),
  })),
);
---

<Layout
  title={`${displayTitle} (${projectData.year}) — Mihail Mihaylov`}
  description={projectData.synopsis}
  ogImage={ogCover || '/og-cover.jpg'}
  ogType="article"
>
  <main id="main">
    <div class="container back-wrap">
      <a href="/#work" class="back-link" data-cursor-hover data-cursor-label="BACK">← Back to Work</a>
    </div>

    <section class="project-hero">
      <div class="container project-hero-inner">
        <div class="hero-meta">
          <span class="eyebrow" style="margin:0;">{projectData.kicker} · {projectData.year}</span>
          <span class="index-badge">{projectData.index}</span>
        </div>
        <h1>
          {displayTitle} <span class="title-year">{projectData.year}</span>
        </h1>
        <p class="hero-en">
          {hasEnglishTitle && <><em>{displayTitleAlt}</em> · </>}
          {projectData.meta}
        </p>
        <p class="project-synopsis">{projectData.synopsis}</p>
        <div class="hero-actions">
          <a
            href={projectData.youtubeUrl}
            data-video-url={projectData.youtubeUrl}
            data-video-title={displayTitle}
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn pill-btn--primary"
            data-cursor-hover
            data-cursor-label="PLAY"
          >
            Watch film <span aria-hidden="true">▶</span>
          </a>
          {gradeUrl && (
            <a
              href={gradeUrl}
              data-video-url={gradeUrl}
              data-video-title={`${displayTitle} — Grade breakdown`}
              target="_blank"
              rel="noopener noreferrer"
              class="pill-btn pill-btn--secondary"
              data-cursor-hover
              data-cursor-label="GRADE"
            >
              Grade breakdown <span aria-hidden="true">▶</span>
            </a>
          )}
        </div>
      </div>

      <div class="project-cover-wrap container">
        <a
          href={projectData.youtubeUrl}
          data-inline-video={projectData.youtubeUrl}
          data-video-title={displayTitle}
          target="_blank"
          rel="noopener noreferrer"
          class="project-cover"
          aria-label={`Play ${displayTitle}`}
          data-cursor-hover
          data-cursor-label="PLAY"
        >
          {coverMedia ? (
            <Image
              src={coverMedia}
              alt={`${displayTitle} cover`}
              widths={[640, 1024, 1440]}
              sizes="(max-width: 768px) 100vw, min(1180px, 92vw)"
              format="webp"
              quality={84}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          ) : (
            <img
              src={projectData.cover}
              alt={`${displayTitle} cover`}
              width="1280"
              height="720"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          )}
          <span class="play-badge" aria-hidden="true"><i>▶</i> Watch film</span>
        </a>
      </div>
    </section>

    <section class="section specs-section">
      <div class="container specs-grid">
        <aside class="specs-aside">
          <h2 class="aside-heading">Specs</h2>
          <ul>
            {projectData.specs.map((s) => (
              <li>
                <b>{s.label}</b> <span>{s.value}</span>
              </li>
            ))}
          </ul>
          <div class="specs-actions">
            <a
              href={projectData.youtubeUrl}
              data-video-url={projectData.youtubeUrl}
              data-video-title={displayTitle}
              target="_blank"
              rel="noopener noreferrer"
              class="pill-btn pill-btn--primary"
              data-cursor-hover
              data-cursor-label="PLAY"
            >
              Watch film <span aria-hidden="true">▶</span>
            </a>
            {gradeUrl && (
              <a
                href={gradeUrl}
                data-video-url={gradeUrl}
                data-video-title={`${displayTitle} — Grade breakdown`}
                target="_blank"
                rel="noopener noreferrer"
                class="pill-btn pill-btn--secondary"
                data-cursor-hover
                data-cursor-label="GRADE"
              >
                Grade breakdown <span aria-hidden="true">▶</span>
              </a>
            )}
          </div>
        </aside>

        <article class="story">
          <h2 class="section-subhead">Story</h2>
          {projectData.story.map((para) => (
            <p>{para}</p>
          ))}
        </article>
      </div>
    </section>

    {gradeUrl && gradeId && (
      <section class="section grade-section" style="padding-top: 0;">
        <div class="container">
          <h2 class="section-subhead">Grade breakdown</h2>
          <p class="grade-lede">How the moonlit grade was built, step by step in DaVinci Resolve.</p>
          <div class="project-cover-wrap">
            <a
              href={gradeUrl}
              data-inline-video={gradeUrl}
              data-video-title={`${displayTitle} — Grade breakdown`}
              target="_blank"
              rel="noopener noreferrer"
              class="project-cover"
              aria-label={`Play ${displayTitle} grade breakdown`}
              data-cursor-hover
              data-cursor-label="PLAY BREAKDOWN"
            >
              <img
                src={`https://img.youtube.com/vi/${gradeId}/maxresdefault.jpg`}
                alt={`${displayTitle} grade breakdown cover`}
                width="1280"
                height="720"
                loading="lazy"
                decoding="async"
                onerror={`this.onerror=null;this.src='https://img.youtube.com/vi/${gradeId}/hqdefault.jpg'`}
              />
              <span class="play-badge" aria-hidden="true"><i>▶</i> Watch breakdown</span>
            </a>
          </div>
        </div>
      </section>
    )}

    {galleryItems.length > 0 && (
      <section class="section gallery-section" style="padding-top: 0;">
        <div class="container">
          <h2 class="section-subhead">Stills &amp; archive</h2>
          <div class="gallery-grid">
            {galleryItems.map((img) => (
              <figure
                class="gallery-card"
                data-lightbox
                data-src={img.lightboxSrc || img.src}
                data-caption={img.caption}
                data-cursor-hover
                data-cursor-label="VIEW"
                tabindex="0"
                role="button"
                aria-label={`Inspect still: ${img.caption || img.alt}`}
              >
                <div class="gallery-img-wrap">
                  {img.media ? (
                    <Image
                      src={img.media}
                      alt={img.alt}
                      widths={[400, 720, 1000]}
                      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 380px"
                      format="webp"
                      quality={82}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <img
                      src={img.src}
                      alt={img.alt}
                      width="720"
                      height="480"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </div>
                <figcaption>{img.caption}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="section nav-section">
      <div class="container nav-grid">
        {prev ? (
          <a href={`/projects/${prev.data.slug}`} class="nav-card nav-prev" data-cursor-hover data-cursor-label="PREV">
            <span class="nav-dir">← Previous</span>
            <b>
              {prev.data.slug === 'silent-lifts-vitosha' ? prev.data.titleEn : prev.data.title} ({prev.data.year})
            </b>
            <span>{prev.data.kicker}</span>
          </a>
        ) : (
          <span />
        )}
        <a href="/#work" class="pill-btn pill-btn--secondary nav-center" data-cursor-hover>
          All work
        </a>
        {next ? (
          <a href={`/projects/${next.data.slug}`} class="nav-card nav-next" data-cursor-hover data-cursor-label="NEXT">
            <span class="nav-dir">Next →</span>
            <b>
              {next.data.slug === 'silent-lifts-vitosha' ? next.data.titleEn : next.data.title} ({next.data.year})
            </b>
            <span>{next.data.kicker}</span>
          </a>
        ) : (
          <span />
        )}
      </div>
    </section>

    <Lightbox />
  </main>
</Layout>

<style>
  .back-wrap {
    padding-top: 1.4rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    transition: color 0.2s ease;
  }
  .back-link:hover {
    color: var(--brass);
  }

  .project-hero {
    position: relative;
    padding-block: clamp(1.75rem, 4vw, 3.25rem) clamp(2.5rem, 5vw, 4rem);
    background: radial-gradient(ellipse at 72% 12%, rgba(178, 58, 46, 0.12), transparent 58%), var(--ink);
    overflow: clip;
  }
  .project-hero-inner {
    position: relative;
    z-index: 1;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .index-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--brass);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0.2rem 0.65rem;
  }
  .project-hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5.4vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ecru);
    margin: 0 0 0.85rem;
    max-width: 18ch;
  }
  .title-year {
    color: var(--brass);
    font-weight: 700;
  }
  .hero-en {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--ash);
    text-transform: uppercase;
    margin-bottom: 1.15rem;
  }
  .project-synopsis {
    max-width: 58ch;
    font-size: clamp(1.04rem, 1.8vw, 1.2rem);
    line-height: 1.65;
    color: rgba(239, 230, 216, 0.92);
    border-left: 2px solid var(--brass);
    padding-left: 1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .project-cover-wrap {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .project-cover {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--ink-2);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%);
  }
  .project-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s;
    filter: saturate(0.95) contrast(1.04);
  }
  .project-cover:hover img {
    transform: scale(1.03);
    filter: saturate(1);
  }
  .play-badge {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    min-height: 44px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ecru);
    background: rgba(28, 22, 20, 0.86);
    border: 1px solid var(--brass);
    padding: 0 1.2rem;
    backdrop-filter: blur(6px);
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }
  .play-badge i {
    color: var(--brass);
    font-style: normal;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 310px 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 768px) {
    .specs-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .specs-aside {
    position: sticky;
    top: 96px;
    background: var(--ink-2);
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
  }
  @media (max-width: 768px) {
    .specs-aside {
      position: static;
    }
  }
  .aside-heading,
  .section-subhead {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ecru);
    margin: 0 0 1.15rem;
  }
  .specs-aside ul {
    display: grid;
    gap: 0.7rem;
  }
  .specs-aside li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ash);
    border-bottom: 1px solid var(--border-soft);
    padding-bottom: 0.55rem;
  }
  .specs-aside li b {
    color: var(--ecru);
  }
  .specs-actions {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }
  .story {
    display: grid;
    gap: 1.15rem;
  }
  .story p {
    color: rgba(239, 230, 216, 0.92);
    font-size: 1.06rem;
    max-width: 58ch;
    line-height: 1.72;
  }
  .grade-lede {
    color: var(--ash);
    font-size: 1.05rem;
    margin-bottom: 1.5rem;
    max-width: 52ch;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }
  @media (max-width: 520px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
  .gallery-card {
    margin: 0;
    cursor: zoom-in;
    border-radius: 2px;
  }
  .gallery-img-wrap {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    background: var(--ink-2);
    transition: border-color 0.22s ease;
  }
  .gallery-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .gallery-card:hover img,
  .gallery-card:focus-visible img {
    transform: scale(1.04);
  }
  .gallery-card:hover .gallery-img-wrap,
  .gallery-card:focus-visible .gallery-img-wrap {
    border-color: var(--brass);
  }
  .gallery-card figcaption {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ash);
  }

  .nav-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    align-items: center;
  }
  .nav-card {
    background: var(--ink-2);
    border: 1px solid var(--border-subtle);
    padding: 1.1rem 1.25rem;
    transition: border-color 0.25s, transform 0.25s;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav-card:hover {
    border-color: var(--brass);
    transform: translateY(-2px);
  }
  .nav-dir {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .nav-card b {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--ecru);
  }
  .nav-card span:last-child {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ash);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  @media (max-width: 640px) {
    .nav-grid {
      grid-template-columns: 1fr;
    }
    .nav-center {
      order: -1;
      justify-self: start;
    }
  }
</style>
