---
// Project Library: aggregates films (projects collection) + companies (site commercial.jobs)
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { resolveMedia } from '../../lib/media';
import type { ImageMetadata } from 'astro';

const projects = await getCollection('projects');
const siteContent = (await getCollection('site'))[0]?.data;

type LibraryItem = {
  kind: 'film' | 'company';
  category: 'short-films' | 'documentary' | 'television' | 'commercial';
  categoryLabel: string;
  href: string;
  watchUrl?: string;
  gradeUrl?: string;
  title: string;
  sub?: string;
  yearLabel: string;
  years: string[];
  kicker: string;
  meta: string;
  synopsis: string;
  thumb: string;
  media: ImageMetadata | null;
  index: string;
};

const classify = (slug: string, kicker: string): LibraryItem['category'] => {
  if (/documentary/i.test(kicker)) return 'documentary';
  if (slug === 'remake-season-2' || /tv|television|reality/i.test(kicker)) return 'television';
  if (/music video|commercial|broadcast|promo/i.test(kicker)) return 'commercial';
  return 'short-films';
};

const CAT_LABELS: Record<LibraryItem['category'], string> = {
  'short-films': 'Short Films',
  documentary: 'Documentary',
  television: 'Television',
  commercial: 'Commercial',
};

const filmItems: LibraryItem[] = projects.map((p) => {
  const d = p.data as any;
  const isVitosha = d.slug === 'silent-lifts-vitosha';
  const cat = classify(d.slug, d.kicker || '');
  const displayTitle = isVitosha && d.titleEn ? d.titleEn : d.title;
  const thumb = d.thumb || d.cover;
  return {
    kind: 'film',
    category: cat,
    categoryLabel: CAT_LABELS[cat],
    href: `/projects/${d.slug}`,
    watchUrl: d.youtubeUrl,
    gradeUrl: d.gradeBreakdownUrl,
    title: `${displayTitle} (${d.year})`,
    sub: isVitosha && d.title ? d.title : undefined,
    yearLabel: d.year,
    years: [String(d.year)],
    kicker: d.kicker,
    meta: d.meta,
    synopsis: d.synopsis,
    thumb,
    media: resolveMedia(thumb),
    index: d.index,
  };
});

const jobItems: LibraryItem[] = ((siteContent as any)?.commercial?.jobs || []).map((job: any, i: number) => {
  const slug = job?.detail?.slug || (job.org.includes('7Arts') ? '7arts-artportal' : 'timeless-production');
  const yearsFound = Array.from(new Set((String(job.years || '').match(/(19|20)\d{2}/g) || []) as string[]));
  const thumb = job.items?.[0]?.thumb || '/vitosha_shot_on_film.jpg';
  return {
    kind: 'company',
    category: 'commercial',
    categoryLabel: 'Commercial',
    href: `/companies/${slug}`,
    title: job.org,
    yearLabel: job.years,
    years: yearsFound.length ? yearsFound : ['2025'],
    kicker: job.role,
    meta: job.years,
    synopsis: job.desc,
    thumb,
    media: resolveMedia(thumb),
    index: `C${i + 1}`,
  };
});

const items: LibraryItem[] = [...filmItems, ...jobItems].sort((a, b) => {
  const ya = parseInt(a.years[0] || '0', 10);
  const yb = parseInt(b.years[0] || '0', 10);
  if (yb !== ya) return yb - ya;
  if (a.kind !== b.kind) return a.kind === 'film' ? -1 : 1;
  return a.title.localeCompare(b.title);
});

const allYears = Array.from(new Set(items.flatMap((it) => it.years))).sort((a, b) => parseInt(b) - parseInt(a));
const counts = {
  all: items.length,
  'short-films': items.filter((it) => it.category === 'short-films').length,
  documentary: items.filter((it) => it.category === 'documentary').length,
  television: items.filter((it) => it.category === 'television').length,
  commercial: items.filter((it) => it.category === 'commercial').length,
};
---

<Layout
  title="Work Library — Mihail Mihaylov"
  description="Browse all short films, documentary work, television episodes, and commercial productions by Mihail Mihaylov."
  ogImage="/og-cover.jpg"
>
  <main id="main">
    <section class="library-hero">
      <div class="container">
        <a href="/" class="back-link" data-cursor-hover data-cursor-label="HOME">← Back home</a>
        <h1>Work library<em>.</em></h1>
        <p class="library-lede">Every film, television credit, and production in one place.</p>
      </div>
    </section>

    <section class="section library-controls-section" style="padding-top: var(--sp-3);">
      <div class="container">
        <div class="library-controls">
          <div class="filter-row" role="group" aria-label="Filter by category">
            <button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">All ({counts.all})</button>
            <button type="button" class="filter-btn" data-filter="short-films" aria-pressed="false">Short Films ({counts['short-films']})</button>
            <button type="button" class="filter-btn" data-filter="documentary" aria-pressed="false">Documentary ({counts.documentary})</button>
            <button type="button" class="filter-btn" data-filter="television" aria-pressed="false">Television ({counts.television})</button>
            <button type="button" class="filter-btn" data-filter="commercial" aria-pressed="false">Commercial ({counts.commercial})</button>
          </div>
          <div class="filter-row secondary">
            <label class="year-label">
              Year
              <select id="year-select" aria-label="Filter by year">
                <option value="all">All years</option>
                {allYears.map((y) => <option value={y}>{y}</option>)}
              </select>
            </label>
            <label class="search-label">
              Search
              <input id="library-search" type="search" placeholder="Title, role, keyword…" autocomplete="off" />
            </label>
          </div>
          <p class="library-status" id="library-status" aria-live="polite">
            Showing {items.length} / {items.length}
          </p>
        </div>

        <div class="library-grid" id="library-grid">
          {items.map((it) => (
            <article
              class="library-card"
              data-category={it.category}
              data-years={it.years.join(' ')}
              data-search={`${it.title} ${it.sub || ''} ${it.kicker} ${it.synopsis} ${it.meta}`.toLowerCase()}
            >
              <a href={it.href} class="library-thumb" aria-label={`Open ${it.title}`} data-cursor-hover data-cursor-label="OPEN">
                {it.media ? (
                  <Image
                    src={it.media}
                    alt={`${it.title} cover`}
                    widths={[400, 680]}
                    sizes="(max-width: 640px) 100vw, 380px"
                    format="webp"
                    quality={82}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <img src={it.thumb} alt={`${it.title} cover`} width="640" height="360" loading="lazy" decoding="async" />
                )}
                <span class="library-cat">{it.categoryLabel}</span>
              </a>
              <div class="library-body">
                <div class="library-top">
                  <b>{it.index}</b>
                  <span>{it.yearLabel}</span>
                </div>
                <h2><a href={it.href} data-cursor-hover>{it.title}</a></h2>
                {it.sub && <p class="library-sub">{it.sub}</p>}
                <p class="library-kicker">{it.kicker}</p>
                <p class="library-meta">{it.meta}</p>
                <p class="library-syn">{it.synopsis}</p>
                <div class="library-links">
                  <a href={it.href} class="pill-btn pill-btn--primary" data-cursor-hover>Read story →</a>
                  {it.watchUrl && (
                    <a
                      href={it.watchUrl}
                      data-video-url={it.watchUrl}
                      data-video-title={it.title}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="pill-btn pill-btn--secondary"
                      data-cursor-hover
                    >
                      Watch <span aria-hidden="true">▶</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="empty-state" id="library-empty" hidden>
          <b>No matches.</b> Try clearing search or choosing a different filter.
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .library-hero {
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(ellipse 720px 380px at 78% 10%, rgba(212, 162, 76, 0.1), transparent 58%),
      var(--ink);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .back-link:hover { color: var(--brass); }
  .library-hero h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 5.2vw, 3.8rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ecru);
    margin: 0.5rem 0 0.9rem;
  }
  .library-hero h1 em { font-style: normal; color: var(--brass); }
  .library-lede {
    max-width: 56ch;
    color: rgba(239, 230, 216, 0.9);
    font-size: clamp(1.02rem, 1.8vw, 1.18rem);
    border-left: 2px solid var(--brass);
    padding-left: 1rem;
  }

  .library-controls {
    background: var(--ink-2);
    border: 1px solid var(--border-subtle);
    padding: 1.25rem;
    margin-bottom: var(--sp-3);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%);
    display: grid;
    gap: 1rem;
  }
  .filter-row { display: flex; flex-wrap: wrap; gap: 0.55rem; align-items: center; }
  .filter-row.secondary { gap: 1rem; }
  .filter-btn {
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: transparent;
    color: var(--ash);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover { color: var(--ecru); border-color: var(--brass); }
  .filter-btn.is-active { color: var(--ink); background: var(--brass); border-color: var(--brass); font-weight: 600; }
  .year-label,
  .search-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .year-label select,
  .search-label input {
    min-height: 44px;
    background: var(--ink);
    border: 1px solid var(--border-subtle);
    color: var(--ecru);
    font-family: var(--font-body);
    font-size: 0.98rem;
    padding: 0.55rem 0.75rem;
    outline: none;
    text-transform: none;
    letter-spacing: 0;
  }
  .search-label input { min-width: min(280px, 65vw); }
  .year-label select:focus,
  .search-label input:focus { border-color: var(--brass); }
  .library-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ash);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .library-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
  @media (max-width: 520px) { .library-grid { grid-template-columns: 1fr; } }
  .library-card {
    background: var(--ink-2);
    border: 1px solid var(--border-subtle);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s;
    display: flex;
    flex-direction: column;
  }
  .library-card:hover { border-color: var(--brass); transform: translateY(-3px); }
  .library-card.is-hidden { display: none; }
  .library-thumb { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ink); }
  .library-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); filter: saturate(0.92) contrast(1.04); }
  .library-card:hover .library-thumb img { transform: scale(1.04); }
  .library-cat {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(28, 22, 20, 0.88);
    border: 1px solid var(--brass);
    border-radius: 999px;
    color: var(--brass);
    padding: 0.25rem 0.65rem;
  }
  .library-body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .library-top { display: flex; justify-content: space-between; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ash); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; }
  .library-top b { color: var(--brass); }
  .library-body h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.22rem;
    line-height: 1.18;
    color: var(--ecru);
    margin: 0;
  }
  .library-body h2 a:hover { color: var(--brass); }
  .library-sub { font-family: var(--font-body); font-style: italic; color: var(--ash); font-size: 0.94rem; margin-top: 0.15rem; }
  .library-kicker { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--brass); margin-top: 0.6rem; }
  .library-meta { font-family: var(--font-mono); font-size: 0.75rem; color: var(--ash); text-transform: uppercase; letter-spacing: 0.04em; margin-top: 0.25rem; }
  .library-syn { color: rgba(239, 230, 216, 0.9); font-size: 0.96rem; line-height: 1.6; margin-top: 0.7rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; flex: 1; }
  .library-links { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.15rem; }
  #library-empty { margin-top: 1rem; }
</style>

<script>
  function initLibrary() {
    const grid = document.getElementById('library-grid');
    if (!grid || grid.dataset.bound === '1') return;
    grid.dataset.bound = '1';

    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const yearSel = document.getElementById('year-select') as HTMLSelectElement | null;
    const search = document.getElementById('library-search') as HTMLInputElement | null;
    const status = document.getElementById('library-status');
    const empty = document.getElementById('library-empty');
    let cat = 'all';

    function apply() {
      const y = yearSel ? yearSel.value : 'all';
      const q = (search ? search.value : '').trim().toLowerCase();
      const cards = Array.from(grid!.querySelectorAll<HTMLElement>('.library-card'));
      let shown = 0;
      cards.forEach((card) => {
        const okCat = cat === 'all' || card.dataset.category === cat;
        const years = (card.dataset.years || '').split(' ');
        const okYear = y === 'all' || years.includes(y);
        const hay = card.dataset.search || '';
        const okQ = !q || hay.includes(q);
        const show = okCat && okYear && okQ;
        card.classList.toggle('is-hidden', !show);
        if (show) shown++;
      });
      if (status) status.textContent = `Showing ${shown} / ${cards.length}`;
      if (empty) empty.hidden = shown !== 0;
    }

    btns.forEach((b) =>
      b.addEventListener('click', () => {
        btns.forEach((x) => {
          x.classList.remove('is-active');
          x.setAttribute('aria-pressed', 'false');
        });
        b.classList.add('is-active');
        b.setAttribute('aria-pressed', 'true');
        cat = b.dataset.filter || 'all';
        apply();
      }),
    );
    yearSel?.addEventListener('change', apply);
    search?.addEventListener('input', apply);
    apply();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initLibrary);
  else initLibrary();
  document.addEventListener('astro:page-load', initLibrary);
  document.addEventListener('astro:after-swap', initLibrary);
</script>
