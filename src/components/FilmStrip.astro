---
import { Image } from 'astro:assets';
import { resolveMedia, optimizeMediaUrl } from '../lib/media';

interface StripItem {
  src: string;
  alt: string;
  caption?: string;
  year?: string;
}

interface Props {
  title?: string;
  items: StripItem[];
}

const { title = 'Selected frames.', items } = Astro.props;

const resolvedItems = await Promise.all(
  items.map(async (item) => ({
    ...item,
    media: resolveMedia(item.src),
    lightboxSrc: await optimizeMediaUrl(item.src, 1600, 84),
  })),
);
---

<section id="stills" class="filmstrip-section" data-filmstrip>
  <div class="container filmstrip-head" data-reveal>
    <div>
      <h2>{title}</h2>
    </div>
    <div class="filmstrip-controls">
      <span class="filmstrip-hint filmstrip-hint--desktop">Drag or scroll sideways · Click frame to inspect</span>
      <span class="filmstrip-hint filmstrip-hint--mobile">Swipe sideways · Tap frame</span>
      <div class="filmstrip-arrows">
        <button type="button" class="strip-arrow" data-strip-prev aria-label="Scroll film strip left">←</button>
        <button type="button" class="strip-arrow" data-strip-next aria-label="Scroll film strip right">→</button>
      </div>
    </div>
  </div>

  <div class="filmstrip-viewport" data-strip-viewport>
    <div class="filmstrip-band">
      <div class="sprocket-rail" aria-hidden="true"></div>

      <div class="filmstrip-track" data-strip-track>
        {resolvedItems.map((item, i) => {
          const frameCode = `${String(i + 1).padStart(2, '0')}A`;
          const fullCaption = item.year
            ? `${item.caption || item.alt} · ${item.year}`
            : item.caption || item.alt;
          return (
            <figure
              class="film-frame"
              data-lightbox
              data-src={item.lightboxSrc || item.src}
              data-caption={fullCaption}
              data-cursor-hover
              data-cursor-label="VIEW"
              tabindex="0"
              role="button"
              aria-label={`Inspect still: ${item.caption || item.alt}`}
            >
              <div class="film-frame-top" aria-hidden="true">
                <span class="film-code">{frameCode}</span>
                {item.year && <span class="film-year">{item.year}</span>}
              </div>
              <div class="film-frame-media" data-img-wrap>
                {item.media ? (
                  <Image
                    src={item.media}
                    alt={item.alt}
                    widths={[360, 640, 840]}
                    sizes="(max-width: 640px) 74vw, 360px"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                ) : (
                  <img
                    src={item.src}
                    alt={item.alt}
                    width="720"
                    height="480"
                    loading="lazy"
                    decoding="async"
                    draggable="false"
                  />
                )}
              </div>
              <figcaption class="film-frame-caption">
                <span>{item.caption || item.alt}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>

      <div class="sprocket-rail" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .filmstrip-section {
    --strip-surface: #211B18;
    position: relative;
    padding-block: clamp(4.5rem, 8vw, 7.25rem);
    background:
      radial-gradient(ellipse 680px 320px at 80% 12%, rgba(212, 162, 76, 0.05), transparent 62%),
      linear-gradient(180deg, #221C18 0%, #1E1815 100%);
    border-top: 1px solid var(--border-soft);
    overflow: clip;
  }

  .filmstrip-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: var(--sp-3);
  }
  .filmstrip-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--h2-size);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0;
  }

  .filmstrip-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .filmstrip-hint {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .filmstrip-hint--mobile {
    display: none;
  }
  .filmstrip-arrows {
    display: inline-flex;
    gap: 0.5rem;
  }
  .strip-arrow {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    background: rgba(30, 24, 21, 0.75);
    color: var(--ecru);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .strip-arrow:hover {
    border-color: var(--brass);
    color: var(--brass);
    background: rgba(212, 162, 76, 0.1);
  }

  .filmstrip-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    touch-action: pan-x pan-y;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 162, 76, 0.35) rgba(18, 14, 12, 0.7);
    -webkit-overflow-scrolling: touch;
  }
  .filmstrip-viewport.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .filmstrip-viewport::-webkit-scrollbar {
    height: 6px;
  }
  .filmstrip-viewport::-webkit-scrollbar-track {
    background: var(--surface-0);
  }
  .filmstrip-viewport::-webkit-scrollbar-thumb {
    background: rgba(212, 162, 76, 0.35);
    border-radius: 999px;
  }
  .filmstrip-viewport::-webkit-scrollbar-thumb:hover {
    background: rgba(212, 162, 76, 0.65);
  }

  .filmstrip-band {
    display: inline-flex;
    flex-direction: column;
    min-width: 100%;
    background: var(--surface-0);
    border-block: 1px solid var(--border-subtle);
    box-shadow:
      inset 0 1px 0 rgba(239, 230, 216, 0.05),
      inset 0 -1px 0 rgba(239, 230, 216, 0.05);
  }

  .sprocket-rail {
    position: relative;
    height: 18px;
    width: 100%;
    background-color: #100c0a;
    border-block: 1px solid rgba(239, 230, 216, 0.04);
    flex-shrink: 0;
  }
  .sprocket-rail::before {
    content: '';
    position: absolute;
    inset: 4px 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 8px,
      var(--strip-surface, var(--ink)) 8px,
      var(--strip-surface, var(--ink)) 20px,
      transparent 20px,
      transparent 28px
    );
  }

  .filmstrip-track {
    display: flex;
    gap: 1.15rem;
    padding: 0.95rem clamp(1.25rem, 5vw, 3rem) 1.05rem;
    align-items: stretch;
  }

  .film-frame {
    flex: 0 0 auto;
    width: clamp(260px, 28vw, 360px);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    cursor: pointer;
    border-radius: 2px;
  }

  .film-frame-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brass);
    padding-inline: 2px;
  }
  .film-year {
    color: var(--ash);
  }

  .film-frame-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    transition: border-color 0.25s ease, box-shadow 0.3s ease;
  }
  .film-frame-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
  }
  .film-frame:hover .film-frame-media,
  .film-frame:focus-visible .film-frame-media {
    border-color: var(--brass);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
  }
  .film-frame:hover .film-frame-media img,
  .film-frame:focus-visible .film-frame-media img {
    transform: scale(1.04);
    filter: saturate(1) contrast(1.06);
  }

  .film-frame-caption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ash);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-inline: 2px;
    transition: color 0.2s ease;
  }
  .film-frame:hover .film-frame-caption,
  .film-frame:focus-visible .film-frame-caption {
    color: var(--ecru);
  }

  @media (max-width: 640px) {
    .filmstrip-hint--desktop {
      display: none;
    }
    .filmstrip-hint--mobile {
      display: inline;
    }
    .film-frame {
      width: 74vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .film-frame-media img {
      transition: none;
    }
    .film-frame:hover .film-frame-media img {
      transform: none;
    }
  }
</style>

<script>
  import { getSound } from '../lib/sound';

  function initFilmStrip() {
    const section = document.querySelector<HTMLElement>('[data-filmstrip]');
    if (!section || section.dataset.stripBound === '1') return;
    section.dataset.stripBound = '1';

    const viewport = section.querySelector<HTMLElement>('[data-strip-viewport]');
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-strip-prev]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-strip-next]');
    if (!viewport) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stepSize = () => Math.max(280, Math.round(viewport.clientWidth * 0.65));

    prevBtn?.addEventListener('click', () => {
      getSound().playStep(-1);
      viewport.scrollBy({ left: -stepSize(), behavior: prefersReduced ? 'auto' : 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      getSound().playStep(1);
      viewport.scrollBy({ left: stepSize(), behavior: prefersReduced ? 'auto' : 'smooth' });
    });

    // Pointer-event mouse drag scrubbing (touch uses native inertial overflow-x).
    // Capture pointer ONLY after dragging past threshold so normal mouse clicks reach .film-frame -> Lightbox.
    let isDown = false;
    let activePointerId: number | null = null;
    let captured = false;
    let startX = 0;
    let startScroll = 0;
    let dragged = false;

    const endDrag = () => {
      if (!isDown) return;
      isDown = false;
      if (captured && activePointerId !== null) {
        try {
          viewport.releasePointerCapture(activePointerId);
        } catch {}
      }
      captured = false;
      activePointerId = null;
      viewport.classList.remove('is-dragging');
      if (dragged) {
        setTimeout(() => {
          dragged = false;
        }, 80);
      }
    };

    const onPointerDown = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      isDown = true;
      activePointerId = e.pointerId;
      captured = false;
      dragged = false;
      startX = e.clientX;
      startScroll = viewport.scrollLeft;
    };

    const onPointerMove = (e: PointerEvent) => {
      if (!isDown || e.pointerId !== activePointerId) return;
      const dx = e.clientX - startX;
      if (!dragged) {
        if (Math.abs(dx) <= 6) return;
        dragged = true;
        viewport.classList.add('is-dragging');
        try {
          viewport.setPointerCapture(e.pointerId);
          captured = true;
        } catch {}
      }
      viewport.scrollLeft = startScroll - dx;
    };

    viewport.addEventListener('pointerdown', onPointerDown);
    window.addEventListener('pointermove', onPointerMove);
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
    viewport.addEventListener('lostpointercapture', endDrag);
    window.addEventListener('blur', endDrag);

    viewport.addEventListener(
      'click',
      (e) => {
        if (dragged) {
          e.stopPropagation();
          e.preventDefault();
        }
      },
      true,
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('pointermove', onPointerMove);
        window.removeEventListener('pointerup', endDrag);
        window.removeEventListener('pointercancel', endDrag);
        window.removeEventListener('blur', endDrag);
        endDrag();
      },
      { once: true },
    );
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFilmStrip);
  else initFilmStrip();
  document.addEventListener('astro:page-load', initFilmStrip);
  document.addEventListener('astro:after-swap', initFilmStrip);
</script>
