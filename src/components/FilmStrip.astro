---
interface StripItem {
  src: string;
  alt: string;
  caption?: string;
  year?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  items: StripItem[];
}

const { eyebrow = 'Stills', title = 'Selected frames.', items } = Astro.props;
---

<section id="stills" class="filmstrip-section" data-filmstrip>
  <div class="container filmstrip-head" data-reveal>
    <div>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
    </div>
    <div class="filmstrip-controls">
      <span class="filmstrip-hint">Drag or scroll sideways · Click frame to inspect</span>
      <div class="filmstrip-arrows">
        <button type="button" class="strip-arrow" data-strip-prev aria-label="Scroll film strip left">←</button>
        <button type="button" class="strip-arrow" data-strip-next aria-label="Scroll film strip right">→</button>
      </div>
    </div>
  </div>

  <div class="filmstrip-viewport" data-strip-viewport>
    <div class="filmstrip-band">
      <div class="sprocket-rail" aria-hidden="true"></div>

      <div class="filmstrip-track" data-strip-track>
        {items.map((item, i) => {
          const frameCode = `${String(i + 1).padStart(2, '0')}A`;
          const fullCaption = item.year
            ? `${item.caption || item.alt} · ${item.year}`
            : item.caption || item.alt;
          return (
            <figure
              class="film-frame"
              data-lightbox
              data-src={item.src}
              data-caption={fullCaption}
              data-cursor-hover
              data-cursor-label="VIEW"
              tabindex="0"
              role="button"
              aria-label={`View ${item.caption || item.alt}`}
            >
              <div class="film-frame-top" aria-hidden="true">
                <span class="film-code">{frameCode}</span>
                {item.year && <span class="film-year">{item.year}</span>}
              </div>
              <div class="film-frame-media skeleton" data-img-wrap>
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  onload="this.closest('[data-img-wrap]')?.classList.remove('skeleton')"
                  onerror="this.closest('[data-img-wrap]')?.classList.remove('skeleton'); this.style.opacity='0.25'"
                />
              </div>
              <figcaption class="film-frame-caption">
                <span>{item.caption || item.alt}</span>
              </figcaption>
            </figure>
          );
        })}
      </div>

      <div class="sprocket-rail" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .filmstrip-section {
    --strip-surface: #211B18;
    position: relative;
    padding-block: clamp(4.75rem, 8.5vw, 7.5rem);
    background:
      radial-gradient(ellipse 680px 320px at 80% 12%, rgba(212, 162, 76, 0.05), transparent 62%),
      linear-gradient(180deg, #221C18 0%, #1E1815 100%);
    border-top: 1px solid rgba(239, 230, 216, 0.09);
    overflow: clip;
  }

  .filmstrip-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: var(--sp-3);
  }
  .filmstrip-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 3.8vw, 2.55rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0;
  }

  .filmstrip-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .filmstrip-hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .filmstrip-arrows {
    display: inline-flex;
    gap: 0.4rem;
  }
  .strip-arrow {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(239, 230, 216, 0.16);
    background: rgba(30, 24, 21, 0.7);
    color: var(--ecru);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .strip-arrow:hover {
    border-color: var(--brass);
    color: var(--brass);
    background: rgba(212, 162, 76, 0.08);
  }

  .filmstrip-viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    cursor: grab;
    scrollbar-width: thin;
    scrollbar-color: rgba(212, 162, 76, 0.35) rgba(18, 14, 12, 0.7);
    -webkit-overflow-scrolling: touch;
  }
  .filmstrip-viewport.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .filmstrip-viewport::-webkit-scrollbar {
    height: 6px;
  }
  .filmstrip-viewport::-webkit-scrollbar-track {
    background: #120e0c;
  }
  .filmstrip-viewport::-webkit-scrollbar-thumb {
    background: rgba(212, 162, 76, 0.32);
    border-radius: 999px;
  }
  .filmstrip-viewport::-webkit-scrollbar-thumb:hover {
    background: rgba(212, 162, 76, 0.6);
  }

  .filmstrip-band {
    display: inline-flex;
    flex-direction: column;
    min-width: 100%;
    background: #120e0c;
    border-block: 1px solid rgba(239, 230, 216, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(239, 230, 216, 0.05),
      inset 0 -1px 0 rgba(239, 230, 216, 0.05);
  }

  /* Subtle 35mm sprocket perforations matching the page background (--ink) */
  .sprocket-rail {
    position: relative;
    height: 18px;
    width: 100%;
    background-color: #100c0a;
    border-block: 1px solid rgba(239, 230, 216, 0.04);
    flex-shrink: 0;
  }
  .sprocket-rail::before {
    content: '';
    position: absolute;
    inset: 4px 0;
    background: repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 8px,
      var(--strip-surface, var(--ink)) 8px,
      var(--strip-surface, var(--ink)) 20px,
      transparent 20px,
      transparent 28px
    );
  }

  .filmstrip-track {
    display: flex;
    gap: 1.15rem;
    padding: 0.95rem clamp(1.25rem, 5vw, 3rem) 1.05rem;
    align-items: stretch;
  }

  .film-frame {
    flex: 0 0 auto;
    width: clamp(260px, 28vw, 360px);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    cursor: pointer;
    outline: none;
  }

  .film-frame-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(212, 162, 76, 0.72);
    padding-inline: 2px;
  }
  .film-year {
    color: var(--ash);
    opacity: 0.75;
  }

  .film-frame-media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid rgba(239, 230, 216, 0.14);
    border-radius: 2px;
    transition: border-color 0.28s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }
  .film-frame-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
  }
  .film-frame:hover .film-frame-media,
  .film-frame:focus-visible .film-frame-media {
    border-color: var(--brass);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
  }
  .film-frame:hover .film-frame-media img,
  .film-frame:focus-visible .film-frame-media img {
    transform: scale(1.045);
    filter: saturate(1) contrast(1.06);
  }

  .film-frame-caption {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-inline: 2px;
    transition: color 0.2s ease;
  }
  .film-frame:hover .film-frame-caption {
    color: var(--ecru);
  }

  @media (max-width: 640px) {
    .filmstrip-hint {
      display: none;
    }
    .film-frame {
      width: 74vw;
    }
    .sprocket-rail {
      height: 18px;
    }
  }
</style>

<script>
  // @ts-nocheck
  function initFilmStrip() {
    const section = document.querySelector('[data-filmstrip]');
    if (!section || section.dataset.stripBound === '1') return;
    section.dataset.stripBound = '1';

    const viewport = section.querySelector('[data-strip-viewport]');
    const prevBtn = section.querySelector('[data-strip-prev]');
    const nextBtn = section.querySelector('[data-strip-next]');
    if (!viewport) return;

    const stepSize = () => Math.max(280, Math.round(viewport.clientWidth * 0.65));

    prevBtn?.addEventListener('click', () => {
      viewport.scrollBy({ left: -stepSize(), behavior: 'smooth' });
    });
    nextBtn?.addEventListener('click', () => {
      viewport.scrollBy({ left: stepSize(), behavior: 'smooth' });
    });

    // Click-and-drag horizontal scrubbing without hijacking vertical page scroll
    let isDown = false;
    let startX = 0;
    let startScroll = 0;
    let dragged = false;

    viewport.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      isDown = true;
      dragged = false;
      startX = e.pageX;
      startScroll = viewport.scrollLeft;
      viewport.classList.add('is-dragging');
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      const dx = e.pageX - startX;
      if (Math.abs(dx) > 6) dragged = true;
      viewport.scrollLeft = startScroll - dx;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      viewport.classList.remove('is-dragging');
      if (dragged) {
        setTimeout(() => { dragged = false; }, 50);
      }
    });

    // Prevent drag release from accidentally opening Lightbox
    viewport.addEventListener(
      'click',
      (e) => {
        if (dragged) {
          e.stopPropagation();
          e.preventDefault();
        }
      },
      true,
    );

    // Keyboard open for film frames
    viewport.querySelectorAll('.film-frame[data-lightbox]').forEach((frame) => {
      frame.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          frame.click();
        }
      });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initFilmStrip);
  else initFilmStrip();
  document.addEventListener('astro:page-load', initFilmStrip);
  document.addEventListener('astro:after-swap', initFilmStrip);
</script>
