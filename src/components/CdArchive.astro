</style>

<script>
  // @ts-nocheck
  type Disc = {
    id: string;
    kind: string;
    category: string;
    categoryLabel: string;
    catalog: string;
    title: string;
    year: string;
    role: string;
    format: string;
    description: string;
    cover: string | null;
    fallback: string | null;
    customArt?: boolean;
    href: string | null;
    watchUrl: string | null;
    microX: number;
    accent: string;
    glow: string;
    avg: { r: number; g: number; b: number; hex: string };
  };

  // Subtle, tactile mechanical CD bay audio (Web Audio API, zero external assets)
  class DiscBayAudio {
    ctx: AudioContext | null = null;

    private getContext(): AudioContext | null {
      const AudioCtx = window.AudioContext || (window as any).webkitAudioContext;
      if (!AudioCtx) return null;
      if (!this.ctx) {
        try {
          this.ctx = new AudioCtx();
        } catch {
          return null;
        }
      }
      if (this.ctx.state === 'suspended') {
        this.ctx.resume().catch(() => {});
      }
      return this.ctx;
    }

    private playClick(ctx: AudioContext, when: number, freq: number, gainPeak: number, dur = 0.032) {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(freq, when);
      osc.frequency.exponentialRampToValueAtTime(Math.max(80, freq * 0.35), when + dur);

      gain.gain.setValueAtTime(0.0001, when);
      gain.gain.linearRampToValueAtTime(gainPeak, when + 0.003);
      gain.gain.exponentialRampToValueAtTime(0.0001, when + dur);

      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start(when);
      osc.stop(when + dur + 0.01);
    }

    private playSlide(
      ctx: AudioContext,
      when: number,
      duration: number,
      filterFrom: number,
      filterTo: number,
      gainPeak: number,
    ) {
      const sampleCount = Math.floor(ctx.sampleRate * duration);
      const buffer = ctx.createBuffer(1, sampleCount, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < sampleCount; i++) {
        data[i] = (Math.random() * 2 - 1) * 0.65;
      }

      const noise = ctx.createBufferSource();
      noise.buffer = buffer;

      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.Q.value = 2.4;
      filter.frequency.setValueAtTime(filterFrom, when);
      filter.frequency.exponentialRampToValueAtTime(filterTo, when + duration);

      const gain = ctx.createGain();
      gain.gain.setValueAtTime(0.0001, when);
      gain.gain.linearRampToValueAtTime(gainPeak, when + duration * 0.22);
      gain.gain.exponentialRampToValueAtTime(0.0001, when + duration);

      noise.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      noise.start(when);
      noise.stop(when + duration + 0.02);
    }

    private playServo(ctx: AudioContext, when: number, fStart: number, fEnd: number, duration: number, gainPeak: number) {
      const osc = ctx.createOscillator();
      const filter = ctx.createBiquadFilter();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(fStart, when);
      osc.frequency.exponentialRampToValueAtTime(fEnd, when + duration);

      filter.type = 'lowpass';
      filter.frequency.value = 340;

      gain.gain.setValueAtTime(0.0001, when);
      gain.gain.linearRampToValueAtTime(gainPeak, when + duration * 0.25);
      gain.gain.exponentialRampToValueAtTime(0.0001, when + duration);

      osc.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      osc.start(when);
      osc.stop(when + duration + 0.02);
    }

    playLoad() {
      const ctx = this.getContext();
      if (!ctx) return;
      const now = ctx.currentTime;
      // Soft plastic pull from shelf + gentle tray servo glide
      this.playClick(ctx, now, 1150, 0.035, 0.024);
      this.playSlide(ctx, now + 0.02, 0.18, 680, 1280, 0.028);
      this.playServo(ctx, now + 0.04, 118, 174, 0.24, 0.022);
    }

    playDockLatch() {
      const ctx = this.getContext();
      if (!ctx) return;
      const now = ctx.currentTime;
      // Tactile spindle seat + subtle disc peek slide
      this.playClick(ctx, now, 2100, 0.042, 0.022);
      this.playClick(ctx, now + 0.018, 360, 0.048, 0.038);
      this.playSlide(ctx, now + 0.05, 0.22, 1400, 880, 0.018);
    }

    playEject() {
      const ctx = this.getContext();
      if (!ctx) return;
      const now = ctx.currentTime;
      // Unlatch + quiet downward return glide
      this.playClick(ctx, now, 1650, 0.036, 0.022);
      this.playServo(ctx, now + 0.03, 152, 92, 0.2, 0.02);
      this.playSlide(ctx, now + 0.04, 0.16, 1120, 620, 0.022);
    }

    dispose() {
      if (this.ctx) {
        this.ctx.close().catch(() => {});
        this.ctx = null;
      }
    }
  }

  const ROOT = '[data-cd-archive]';
  let teardown: (() => void) | null = null;

  function bootCdArchive() {
    const root = document.querySelector(ROOT) as HTMLElement | null;
    if (!root || root.dataset.cdBound === '1') return;
    root.dataset.cdBound = '1';

    const dataEl = root.querySelector('[data-cd-data]');
    if (!dataEl?.textContent) return;

    let DISCS: Disc[] = [];
    try {
      DISCS = JSON.parse(dataEl.textContent);
    } catch {
      return;
    }
    if (!DISCS.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const towerEl = root.querySelector('[data-cd-tower]') as HTMLElement;
    const bayEl = root.querySelector('[data-cd-bay]') as HTMLElement;
    const panelEl = root.querySelector('[data-cd-panel]') as HTMLElement;
    const liveEl = root.querySelector('[data-cd-live]') as HTMLElement;
    const auraA = root.querySelector('[data-aura-a]') as HTMLElement | null;
    const auraB = root.querySelector('[data-aura-b]') as HTMLElement | null;
    const ambientA = root.querySelector('[data-ambient-a]') as HTMLElement | null;
    const ambientB = root.querySelector('[data-ambient-b]') as HTMLElement | null;
    const btnPrev = root.querySelector('[data-cd-prev]') as HTMLButtonElement;
    const btnReturn = root.querySelector('[data-cd-return]') as HTMLButtonElement;
    const btnNext = root.querySelector('[data-cd-next]') as HTMLButtonElement;
    const stackLabelEl = root.querySelector('[data-cd-stack-label]') as HTMLElement | null;
    const filterBtns = Array.from(root.querySelectorAll('[data-cd-filter]')) as HTMLButtonElement[];

    if (!towerEl || !bayEl || !panelEl) return;

    const audio = new DiscBayAudio();

    let activeCategory = 'all';
    const visibleIndices = (): number[] =>
      DISCS.map((d, i) => (activeCategory === 'all' || d.category === activeCategory ? i : -1)).filter(
        (i) => i !== -1,
      );

    // Track active aura layer & last color key so duplicate calls never re-trigger a flash
    let activeAuraLayer: 'a' | 'b' = 'a';
    const initAvg = DISCS[0]?.avg;
    let lastAuraKey: string | null = initAvg ? `${initAvg.r},${initAvg.g},${initAvg.b}` : null;

    // ---------------------------------------------------------------- utils
    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const easeOutExpo = (t: number) => (t >= 1 ? 1 : 1 - Math.pow(2, -10 * t));
    const easeInOutCubic = (t: number) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);
    const easeInOutQuart = (t: number) =>
      t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2;

    const esc = (s: string) =>
      String(s).replace(
        /[&<>"']/g,
        (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[
            c
          ] as string,
      );

    // ---------------------------------------------------------------- stage
    const stage = document.createElement('div');
    stage.className = 'cd-flight-stage';
    document.body.appendChild(stage);

    // ---------------------------------------------------------------- state
    const states = new Map<string, string>();
    const actors = new Map<string, any>();
    DISCS.forEach((d) => states.set(d.catalog, 'seated'));

    let activeIndex = -1;
    let pendingLaunch: ReturnType<typeof setTimeout> | null = null;
    let panelSwap: ReturnType<typeof setTimeout> | null = null;
    let syncRafId: number | null = null;

    const slotEl = (catalog: string) =>
      towerEl.querySelector(`.cd-slot[data-id="${catalog}"]`) as HTMLElement | null;

    // ---------------------------------------------------------------- tower
    function applyParting(centerIdx: number) {
      const visibleSlots = Array.from(towerEl.children).filter(
        (child) => !(child as HTMLElement).classList.contains('is-filtered-out'),
      ) as HTMLElement[];
      const pos = visibleSlots.findIndex((el) => Number(el.dataset.index) === centerIdx);
      Array.from(towerEl.children).forEach((child) => {
        (child as HTMLElement).classList.remove('part-up', 'part-down');
      });
      if (pos === -1) return;
      if (visibleSlots[pos - 1]) visibleSlots[pos - 1].classList.add('part-up');
      if (visibleSlots[pos + 1]) visibleSlots[pos + 1].classList.add('part-down');
    }
    function clearParting() {
      Array.from(towerEl.children).forEach((child) => {
        (child as HTMLElement).classList.remove('part-up', 'part-down');
      });
    }

    function setState(catalog: string, next: string) {
      states.set(catalog, next);
      const slot = slotEl(catalog);
      if (!slot) return;
      const spine = slot.querySelector('.cd-spine') as HTMLElement;
      const cavity = slot.querySelector('.cd-cavity') as HTMLElement;
      const isEmpty = next !== 'seated';

      slot.classList.toggle('is-empty', isEmpty);

      // FIX: Properly toggle `inert` so empty slots are actually clickable!
      if (spine) {
        spine.inert = isEmpty;
        spine.tabIndex = isEmpty ? -1 : 0;
        spine.setAttribute('aria-hidden', isEmpty ? 'true' : 'false');
        if (next === 'docked' || next === 'entering') {
          spine.setAttribute('aria-current', 'true');
        } else {
          spine.removeAttribute('aria-current');
        }
      }
      if (cavity) {
        cavity.inert = !isEmpty;
        cavity.tabIndex = isEmpty ? 0 : -1;
        cavity.setAttribute('aria-hidden', isEmpty ? 'false' : 'true');
      }
    }

    towerEl.querySelectorAll('.cd-slot').forEach((slot) => {
      const el = slot as HTMLElement;
      const idx = Number(el.dataset.index);
      const spine = el.querySelector('.cd-spine') as HTMLElement;
      const cavity = el.querySelector('.cd-cavity') as HTMLElement;

      spine?.addEventListener('mouseenter', () => applyParting(idx));
      spine?.addEventListener('mouseleave', clearParting);
      spine?.addEventListener('focus', () => applyParting(idx));
      spine?.addEventListener('blur', clearParting);

      spine?.addEventListener('click', () => {
        selectProject(idx);
      });

      cavity?.addEventListener('click', () => {
        const disc = DISCS[idx];
        const state = states.get(disc.catalog);
        if (state === 'docked' || state === 'entering') returnToStack(disc.catalog, true);
        else if (state === 'returning') selectProject(idx);
      });
    });

    // Arrow keys are scoped to the tower so they never hijack page scrolling.
    towerEl.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      e.preventDefault();
      const vis = visibleIndices();
      if (!vis.length) return;
      const forward = e.key === 'ArrowDown';
      const pos = vis.indexOf(activeIndex);
      const next =
        pos === -1
          ? vis[0]
          : forward
            ? vis[(pos + 1) % vis.length]
            : vis[(pos - 1 + vis.length) % vis.length];
      selectProject(next);
      const spine = slotEl(DISCS[next].catalog)?.querySelector('.cd-spine') as HTMLElement;
      spine?.focus({ preventScroll: true });
    });

    // ---------------------------------------------------------------- panel
    function panelHTML(disc: Disc) {
      const href = disc.href ? esc(disc.href) : null;
      return `
        <div class="cd-stagger">
          <div class="cd-kicker">
            <span style="color:${disc.accent}">${esc(disc.catalog)} · ${esc(disc.categoryLabel)} · ${esc(disc.year)}</span>
          </div>
          <h3 class="cd-panel-title">${esc(disc.title)}</h3>
          <div class="cd-panel-meta">
            <p class="cd-panel-role">${esc(disc.role)}</p>
            <p class="cd-panel-format">${esc(disc.format)}</p>
          </div>
          <p class="cd-panel-desc">${esc(disc.description)}</p>
          <div class="cd-panel-actions">
            ${
              href
                ? `<a class="cd-action" href="${href}">Open project <span aria-hidden="true">→</span></a>`
                : ''
            }
            ${
              disc.watchUrl
                ? `<a class="cd-action cd-action-ghost" href="${esc(disc.watchUrl)}" target="_blank" rel="noopener noreferrer">Watch <span aria-hidden="true">↗</span></a>`
                : ''
            }
          </div>
        </div>`;
    }

    function standbyHTML() {
      const count = visibleIndices().length;
      return `
        <div class="cd-stagger">
          <div class="cd-kicker" style="color:var(--ash)">
            <span>Work · ${String(count).padStart(2, '0')} ${count === 1 ? 'Project' : 'Projects'}</span>
          </div>
          <h3 class="cd-standby-title">Select a disc<br /><em>from the stack.</em></h3>
          <p class="cd-panel-desc">Short films, documentary work, television, and live broadcast projects. Pick any case from the stack to inspect it or open its project page.</p>
        </div>`;
    }

    function swapPanel(disc: Disc | null, delay = 220) {
      if (panelSwap) clearTimeout(panelSwap);
      panelEl.classList.add('is-exiting');
      panelSwap = setTimeout(() => {
        panelEl.innerHTML = disc ? panelHTML(disc) : standbyHTML();
        void panelEl.offsetWidth;
        panelEl.classList.remove('is-exiting');
      }, delay);
    }

    function announce(disc: Disc | null) {
      if (!liveEl) return;
      liveEl.textContent = disc
        ? `Now showing ${disc.title}, ${disc.year}`
        : 'Display bay empty';
    }

    function setAuraColor(avg: { r: number; g: number; b: number } | null) {
      if (!auraA || !auraB) return;

      const key = avg ? `${avg.r},${avg.g},${avg.b}` : null;
      // FIX: Skip redundant crossfade when the exact same color is already active
      if (key === lastAuraKey) return;
      lastAuraKey = key;

      const nextLayer = activeAuraLayer === 'a' ? 'b' : 'a';
      const curAura = activeAuraLayer === 'a' ? auraA : auraB;
      const nextAura = activeAuraLayer === 'a' ? auraB : auraA;
      const curAmb = activeAuraLayer === 'a' ? ambientA : ambientB;
      const nextAmb = activeAuraLayer === 'a' ? ambientB : ambientA;

      if (avg) {
        const { r, g, b } = avg;
        nextAura.style.background = `radial-gradient(circle closest-side, rgba(${r}, ${g}, ${b}, 0.44) 0%, rgba(${r}, ${g}, ${b}, 0.22) 42%, rgba(${r}, ${g}, ${b}, 0.07) 72%, transparent 100%)`;
        if (nextAmb) {
          nextAmb.style.background = `radial-gradient(ellipse 65% 55% at 58% 46%, rgba(${r}, ${g}, ${b}, 0.18) 0%, rgba(${r}, ${g}, ${b}, 0.05) 52%, transparent 76%)`;
          nextAmb.classList.add('is-active');
        }
        nextAura.classList.add('is-active');

        curAura.classList.remove('is-active');
        curAmb?.classList.remove('is-active');
        activeAuraLayer = nextLayer;
      } else {
        curAura.classList.remove('is-active');
        curAmb?.classList.remove('is-active');
      }
    }

    function updateChrome(disc: Disc | null) {
      if (disc) {
        setAuraColor(disc.avg || null);
        bayEl.classList.add('has-disc');
        btnReturn.disabled = false;
      } else {
        setAuraColor(null);
        bayEl.classList.remove('has-disc');
        btnReturn.disabled = true;
      }
    }

    // ---------------------------------------------------------------- actor
    class JewelCase {
      disc: Disc;
      slotEl: HTMLElement;
      W: number;
      D: number;
      scaleStart: number;
      pose: any;
      el!: HTMLElement;
      glareEl!: HTMLElement;
      rafId: number | null = null;
      tiltRafId: number | null = null;
      tiltX = 0;
      tiltY = 0;
      targetTiltX = 0;
      targetTiltY = 0;
      mode = 'entering';
      timers: ReturnType<typeof setTimeout>[] = [];

      constructor(disc: Disc, slot: HTMLElement) {
        this.disc = disc;
        this.slotEl = slot;

        const bayRect = bayEl.getBoundingClientRect();
        const spine = slot.querySelector('.cd-spine') as HTMLElement;
        const startRect = spine.getBoundingClientRect();

        this.W = Math.round(bayRect.width);
        this.scaleStart = startRect.width / this.W;
        this.D = startRect.height / this.scaleStart;

        this.pose = {
          x: startRect.left + startRect.width / 2,
          y: startRect.top + startRect.height / 2,
          z: 0,
          localZ: -this.W / 2,
          rx: 90,
          ry: 0,
          rz: 0,
          scale: this.scaleStart,
        };

        this.build();
        this.applyPose(this.pose);
      }

      build() {
        const { W, D, disc } = this;
        const halfW = W / 2;
        const halfD = D / 2;
        const discSize = Math.round(W * 0.86);

        const el = document.createElement('div');
        el.className = 'cd-actor';
        el.style.width = `${W}px`;
        el.style.height = `${W}px`;
        el.style.marginLeft = `${-halfW}px`;
        el.style.marginTop = `${-halfW}px`;
        el.style.setProperty('--case-accent', disc.accent);

        // 1. Disc nestled inside (at Z = 0, safely between front +halfD and back -halfD)
        const discSlot = document.createElement('div');
        discSlot.className = 'jc-disc-slot';
        discSlot.style.width = `${discSize}px`;
        discSlot.style.height = `${discSize}px`;
        discSlot.innerHTML = '<div class="jc-disc"><div class="jc-hub"></div></div>';
        el.appendChild(discSlot);

        // 2. Front cover
        const front = document.createElement('div');
        front.className = 'jc-face jc-front';
        front.style.transform = `translateZ(${halfD}px)`;

        const hinge = document.createElement('div');
        hinge.className = 'jc-hinge';
        hinge.style.width = `${Math.round(W * 0.074)}px`;

        const win = document.createElement('div');
        win.className = 'jc-window';
        win.appendChild(this.buildCover());

        ['tl', 'tr', 'bl', 'br'].forEach((pos) => {
          const tab = document.createElement('span');
          tab.className = `jc-tab ${pos}`;
          tab.setAttribute('aria-hidden', 'true');
          win.appendChild(tab);
        });

        const vig = document.createElement('div');
        vig.className = 'jc-vignette';
        win.appendChild(vig);

        const glare = document.createElement('div');
        glare.className = 'jc-glare';
        win.appendChild(glare);
        this.glareEl = glare;

        // Centre button -> internal project page (keeps viewers on site)
        if (disc.href) {
          const open = document.createElement('a');
          open.className = 'jc-open';
          open.href = disc.href;
          open.setAttribute('aria-label', `Open ${disc.title} project page`);
          open.innerHTML =
            '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
          win.appendChild(open);
        }

        front.appendChild(hinge);
        front.appendChild(win);
        el.appendChild(front);

        // 3. Back
        const back = document.createElement('div');
        back.className = 'jc-face jc-back';
        back.style.transform = `rotateY(180deg) translateZ(${halfD}px)`;
        el.appendChild(back);

        // 4. Bottom spine (matches the tower spine)
        const bottom = document.createElement('div');
        bottom.className = 'jc-face jc-bottom';
        bottom.style.height = `${D}px`;
        bottom.style.top = `${(W - D) / 2}px`;
        bottom.style.transform = `rotateX(-90deg) translateZ(${halfW}px)`;
        bottom.innerHTML = this.spineHTML();
        el.appendChild(bottom);

        // 5-7. Top / left / right edges
        const top = document.createElement('div');
        top.className = 'jc-face jc-edge';
        top.style.width = `${W}px`;
        top.style.height = `${D}px`;
        top.style.top = `${(W - D) / 2}px`;
        top.style.transform = `rotateX(90deg) translateZ(${halfW}px)`;
        el.appendChild(top);

        const left = document.createElement('div');
        left.className = 'jc-face jc-edge jc-left';
        left.style.width = `${D}px`;
        left.style.height = `${W}px`;
        left.style.left = `${(W - D) / 2}px`;
        left.style.transform = `rotateY(-90deg) translateZ(${halfW}px)`;
        el.appendChild(left);

        // Translucent clear-plastic right edge
        const right = document.createElement('div');
        right.className = 'jc-face jc-right';
        right.style.width = `${D}px`;
        right.style.height = `${W}px`;
        right.style.left = `${(W - D) / 2}px`;
        right.style.transform = `rotateY(90deg) translateZ(${halfW}px)`;
        el.appendChild(right);

        if (!reduced) {
          el.addEventListener('mousemove', (e: MouseEvent) => {
            if (this.mode !== 'docked') return;
            const r = el.getBoundingClientRect();
            const nx = (e.clientX - r.left) / r.width - 0.5;
            const ny = (e.clientY - r.top) / r.height - 0.5;
            this.targetTiltY = nx * 16;
            this.targetTiltX = -ny * 13;
            this.startTilt();
          });
          el.addEventListener('mouseleave', () => {
            if (this.mode !== 'docked') return;
            this.targetTiltX = 0;
            this.targetTiltY = 0;
            this.startTilt();
          });
        }

        this.el = el;
        stage.appendChild(el);
      }

      spineHTML() {
        const d = this.disc;
        return `
          <span class="cd-spine-shell">
            <span class="cd-spine-hinge" aria-hidden="true"></span>
            <span class="cd-spine-paper">
              <span class="cd-spine-band" aria-hidden="true"></span>
              <span class="cd-spine-main">
                <span class="cd-spine-code">${esc(d.catalog)}</span>
                <span class="cd-spine-title">${esc(d.title)}</span>
              </span>
              <span class="cd-spine-year">${esc(d.year)}</span>
            </span>
            <span class="cd-spine-cap" aria-hidden="true"></span>
            <span class="cd-spine-glare" aria-hidden="true"></span>
          </span>`;
      }

      buildCover() {
        const d = this.disc;
        const wrap = document.createElement('div');
        wrap.style.cssText = 'position:relative;width:100%;height:100%;';

        if (!d.cover) {
          wrap.innerHTML = this.fallbackHTML();
          return wrap;
        }

        const img = document.createElement('img');
        img.src = d.cover;
        img.alt = `${d.title} cover artwork`;
        img.className = 'jc-cover-img';
        img.loading = 'eager';
        img.decoding = 'async';
        img.draggable = false;

        let triedFallback = false;
        img.addEventListener('error', () => {
          if (!triedFallback && d.fallback && img.src !== d.fallback) {
            triedFallback = true;
            img.src = d.fallback;
          } else {
            wrap.innerHTML = this.fallbackHTML();
          }
        });

        wrap.appendChild(img);

        const code = document.createElement('div');
        code.className = 'jc-code';
        code.textContent = d.catalog;

        wrap.appendChild(code);

        if (!d.customArt) {
          const foot = document.createElement('div');
          foot.className = 'jc-foot';
          foot.innerHTML = `<span class="jc-foot-title">${esc(d.title)}</span><span class="jc-foot-year">${esc(d.year)}</span>`;
          wrap.appendChild(foot);
        }
        return wrap;
      }

      fallbackHTML() {
        const d = this.disc;
        return `
          <div class="jc-fallback" style="background:radial-gradient(circle at 24% 20%, ${d.glow} 0%, var(--cd-surface) 62%, var(--cd-deep) 100%)">
            <div class="jc-fallback-top"><span>${esc(d.catalog)}</span><span>${esc(d.year)}</span></div>
            <div>
              <p class="jc-fallback-title">${esc(d.title)}</p>
              <p class="jc-fallback-role">${esc(d.role)}</p>
            </div>
            <div class="jc-fallback-foot">${esc(d.format)}</div>
          </div>`;
      }

      applyPose(p: any) {
        const rx = p.rx + this.tiltX;
        const ry = p.ry + this.tiltY;

        this.el.style.transform =
          `translate3d(${p.x.toFixed(2)}px, ${p.y.toFixed(2)}px, ${p.z.toFixed(2)}px) ` +
          `scale3d(${p.scale.toFixed(4)}, ${p.scale.toFixed(4)}, ${p.scale.toFixed(4)}) ` +
          `translateZ(${p.localZ.toFixed(2)}px) ` +
          `rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) rotateZ(${p.rz.toFixed(2)}deg)`;

        if (this.glareEl) {
          const gx = ry * 2.2 - rx * 0.65;
          const gy = rx * 1.1 - ry * 0.45;
          const op = 0.52 + Math.min(0.45, Math.abs(Math.sin((rx + ry) * 0.03)) * 0.45);
          this.glareEl.style.transform = `translate3d(${gx.toFixed(1)}px, ${gy.toFixed(1)}px, 0)`;
          this.glareEl.style.opacity = op.toFixed(2);
        }
      }

      slotAnchor() {
        const cavity = this.slotEl.querySelector('.cd-cavity') as HTMLElement;
        const r = cavity.getBoundingClientRect();
        // If the slot is currently filtered out (display: none), return cleanly to the top of the tower
        if (r.width < 10 || r.height < 4) {
          const tr = towerEl.getBoundingClientRect();
          return {
            x: tr.left + tr.width / 2,
            y: tr.top + 18,
            scale: Math.max(0.45, tr.width / this.W),
          };
        }
        return {
          x: r.left + r.width / 2 + this.disc.microX,
          y: r.top + r.height / 2,
          scale: r.width / this.W,
        };
      }

      bayAnchor() {
        const r = bayEl.getBoundingClientRect();
        return { x: r.left + r.width / 2, y: r.top + r.height / 2, scale: r.width / this.W };
      }

      stop() {
        if (this.rafId) {
          cancelAnimationFrame(this.rafId);
          this.rafId = null;
        }
        if (this.tiltRafId) {
          cancelAnimationFrame(this.tiltRafId);
          this.tiltRafId = null;
        }
        this.timers.forEach(clearTimeout);
        this.timers = [];
      }

      dockInstantly() {
        this.stop();
        const bay = this.bayAnchor();
        this.pose.x = bay.x;
        this.pose.y = bay.y;
        this.pose.z = 0;
        this.pose.localZ = 0;
        this.pose.rx = 3;
        this.pose.ry = -10;
        this.pose.rz = 0;
        this.pose.scale = bay.scale;
        this.applyPose(this.pose);
        this.mode = 'docked';
        this.el.style.opacity = '1';
        this.el.classList.add('is-docked', 'disc-peeking', 'show-open');
        this.el.style.zIndex = '45';
        const isOffscreen =
          bay.y + this.W * 0.75 < 0 || bay.y - this.W * 0.75 > window.innerHeight;
        this.el.style.visibility = isOffscreen ? 'hidden' : 'visible';
        setState(this.disc.catalog, 'docked');
      }

      flyToBay(onDocked?: () => void) {
        if (reduced) {
          audio.playDockLatch();
          this.dockInstantly();
          onDocked?.();
          return;
        }
        this.stop();
        audio.playLoad();
        this.mode = 'entering';
        this.tiltX = this.tiltY = this.targetTiltX = this.targetTiltY = 0;
        this.el.style.visibility = 'visible';
        this.el.style.opacity = '1';
        this.el.classList.remove('is-docked', 'disc-peeking', 'show-open');
        this.el.style.zIndex = '50';

        // FIX: Match CSS @media (min-width: 1024px) breakpoint
        const desktop = window.innerWidth >= 1024;
        const idx = DISCS.indexOf(this.disc);

        // On mobile/tablet (< 1024px), keep the animation anchored directly to the bay's live
        // coordinates so smooth scrolling up to the bay never causes jarring vertical jumps.
        if (!desktop) {
          const duration = 460;
          const t0 = performance.now();
          const tickMobile = (now: number) => {
            if (this.mode !== 'entering') return;
            const raw = clamp01((now - t0) / duration);
            const t = easeOutExpo(raw);
            const bay = this.bayAnchor();

            this.pose.x = bay.x;
            this.pose.y = bay.y + lerp(36, 0, t);
            this.pose.z = lerp(-24, 0, t);
            this.pose.localZ = 0;
            this.pose.rx = lerp(16, 3, t);
            this.pose.ry = lerp(-4, -10, t);
            this.pose.rz = 0;
            this.pose.scale = bay.scale * lerp(0.92, 1, t);

            this.el.style.opacity = clamp01(raw * 2.4).toFixed(3);
            this.applyPose(this.pose);

            if (raw < 1) {
              this.rafId = requestAnimationFrame(tickMobile);
            } else {
              this.rafId = null;
              this.el.style.opacity = '1';
              this.mode = 'docked';
              this.el.classList.add('is-docked');
              this.el.style.zIndex = '45';
              setState(this.disc.catalog, 'docked');
              audio.playDockLatch();
              requestAnimationFrame(() => {
                if (this.mode !== 'docked') return;
                this.el.classList.add('disc-peeking', 'show-open');
              });
              onDocked?.();
            }
          };
          this.rafId = requestAnimationFrame(tickMobile);
          return;
        }

        const start = { ...this.pose };
        const duration = 840;
        const t0 = performance.now();

        applyParting(idx);
        this.timers.push(
          setTimeout(() => {
            if (this.mode === 'entering' || this.mode === 'docked') clearParting();
          }, 260),
        );

        const tick = (now: number) => {
          const raw = clamp01((now - t0) / duration);
          const bay = this.bayAnchor();

          const pull = easeOutCubic(clamp01(raw / 0.24));
          const release = 1 - easeInOutCubic(clamp01((raw - 0.16) / 0.56));
          const pullX = 46 * pull * release;

          const travel = easeInOutQuart(clamp01((raw - 0.08) / 0.92));
          const arc = Math.sin(Math.PI * travel);

          const liftY = -52 * arc;

          const rot = easeInOutCubic(clamp01((raw - 0.12) / 0.84));
          const bank = Math.sin(Math.PI * rot);

          this.pose.x = lerp(start.x, bay.x, travel) + pullX;
          this.pose.y = lerp(start.y, bay.y, travel) + liftY;
          this.pose.z = lerp(start.z, 0, travel) + 96 * arc + 32 * pull * release;
          this.pose.localZ = lerp(start.localZ, 0, rot);
          this.pose.rx = lerp(start.rx, 3, rot);
          this.pose.ry = lerp(start.ry, -10, rot) - 22 * bank;
          this.pose.rz = lerp(start.rz, 0, rot) - 7.5 * bank;
          this.pose.scale = lerp(start.scale, bay.scale, easeOutExpo(travel));

          this.applyPose(this.pose);

          if (raw < 1) {
            this.rafId = requestAnimationFrame(tick);
          } else {
            this.rafId = null;
            this.mode = 'docked';
            this.el.classList.add('is-docked');
            this.el.style.zIndex = '45';
            setState(this.disc.catalog, 'docked');
            audio.playDockLatch();
            requestAnimationFrame(() => {
              if (this.mode !== 'docked') return;
              this.el.classList.add('disc-peeking', 'show-open');
            });
            onDocked?.();
          }
        };
        this.rafId = requestAnimationFrame(tick);
      }

      returnToSlot(onSeated?: () => void) {
        this.stop();
        const wasDocked = this.mode === 'docked';
        if (wasDocked) audio.playEject();
        this.mode = 'returning';
        setState(this.disc.catalog, 'returning');

        this.el.style.visibility = 'visible';
        this.el.classList.remove('is-docked', 'show-open', 'disc-peeking');
        this.el.style.zIndex = '42';

        const start = { ...this.pose, rx: this.pose.rx + this.tiltX, ry: this.pose.ry + this.tiltY };
        this.tiltX = this.tiltY = this.targetTiltX = this.targetTiltY = 0;

        const seat = () => {
          if (reduced) {
            this.destroy();
            setState(this.disc.catalog, 'seated');
            onSeated?.();
            return;
          }
          // FIX: Match CSS @media (min-width: 1024px) breakpoint
          const desktop = window.innerWidth >= 1024;

          if (!desktop) {
            const duration = 300;
            const t0 = performance.now();
            const tickMobileOut = (now: number) => {
              if (this.mode !== 'returning') return;
              const raw = clamp01((now - t0) / duration);
              const t = easeInOutCubic(raw);
              const bay = this.bayAnchor();

              this.pose.x = bay.x;
              this.pose.y = bay.y + lerp(0, 30, t);
              this.pose.z = lerp(0, -24, t);
              this.pose.localZ = 0;
              this.pose.rx = lerp(start.rx, 16, t);
              this.pose.ry = lerp(start.ry, -4, t);
              this.pose.rz = 0;
              this.pose.scale = bay.scale * lerp(1, 0.92, t);

              this.el.style.opacity = clamp01(1 - raw * 1.2).toFixed(3);
              this.applyPose(this.pose);

              if (raw < 1) {
                this.rafId = requestAnimationFrame(tickMobileOut);
              } else {
                this.rafId = null;
                this.destroy();
                setState(this.disc.catalog, 'seated');
                onSeated?.();
              }
            };
            this.rafId = requestAnimationFrame(tickMobileOut);
            return;
          }

          const duration = 680;
          const t0 = performance.now();

          const tick = (now: number) => {
            if (this.mode !== 'returning') return;
            const raw = clamp01((now - t0) / duration);
            const slot = this.slotAnchor();

            const travel = easeInOutCubic(clamp01(raw / 0.86));
            const arc = Math.sin(Math.PI * travel);

            const approach = easeOutCubic(clamp01(raw / 0.55));
            const home = 1 - easeInOutCubic(clamp01((raw - 0.72) / 0.28));
            const slideX = 34 * approach * home;

            const rot = easeInOutCubic(clamp01(raw / 0.82));
            const bank = Math.sin(Math.PI * rot);

            this.pose.x = lerp(start.x, slot.x, travel) + slideX;
            this.pose.y = lerp(start.y, slot.y, travel) - 34 * arc;
            this.pose.z = lerp(start.z, 0, travel) + 74 * arc;
            this.pose.localZ = lerp(start.localZ, -this.W / 2, rot);
            this.pose.rx = lerp(start.rx, 90, rot);
            this.pose.ry = lerp(start.ry, 0, rot) + 18 * bank;
            this.pose.rz = lerp(start.rz, 0, rot) + 6 * bank;
            this.pose.scale = lerp(start.scale, slot.scale, easeInOutCubic(raw));

            this.applyPose(this.pose);

            if (raw < 1) {
              this.rafId = requestAnimationFrame(tick);
            } else {
              this.rafId = null;
              this.destroy();
              setState(this.disc.catalog, 'seated');
              onSeated?.();
            }
          };
          this.rafId = requestAnimationFrame(tick);
        };

        if (wasDocked && !reduced) this.timers.push(setTimeout(seat, 160));
        else seat();
      }

      startTilt() {
        if (this.tiltRafId) return;
        const step = () => {
          if (this.mode !== 'docked') {
            this.tiltRafId = null;
            return;
          }
          this.tiltX += (this.targetTiltX - this.tiltX) * 0.14;
          this.tiltY += (this.targetTiltY - this.tiltY) * 0.14;
          this.applyPose(this.pose);
          if (
            Math.abs(this.targetTiltX - this.tiltX) > 0.03 ||
            Math.abs(this.targetTiltY - this.tiltY) > 0.03
          ) {
            this.tiltRafId = requestAnimationFrame(step);
          } else {
            this.tiltX = this.targetTiltX;
            this.tiltY = this.targetTiltY;
            this.applyPose(this.pose);
            this.tiltRafId = null;
          }
        };
        this.tiltRafId = requestAnimationFrame(step);
      }

      syncToBay() {
        if (this.mode !== 'docked') return;
        const bay = this.bayAnchor();
        this.pose.x = bay.x;
        this.pose.y = bay.y;
        this.pose.scale = bay.scale;
        this.applyPose(this.pose);
        const isOffscreen =
          bay.y + this.W * 0.75 < 0 || bay.y - this.W * 0.75 > window.innerHeight;
        this.el.style.visibility = isOffscreen ? 'hidden' : 'visible';
      }

      destroy() {
        this.stop();
        this.el?.parentNode?.removeChild(this.el);
        actors.delete(this.disc.catalog);
      }
    }

    // ---------------------------------------------------------------- flow
    function launch(idx: number) {
      const disc = DISCS[idx];
      if (!disc) return;
      const slot = slotEl(disc.catalog);
      if (!slot) return;

      let actor = actors.get(disc.catalog);
      if (!actor) {
        actor = new JewelCase(disc, slot);
        actors.set(disc.catalog, actor);
      }
      setState(disc.catalog, 'entering');
      actor.flyToBay();
    }

    function selectProject(idx: number) {
      const disc = DISCS[idx];
      if (!disc) return;

      const state = states.get(disc.catalog);
      if (activeIndex === idx && (state === 'docked' || state === 'entering')) return;

      if (pendingLaunch) clearTimeout(pendingLaunch);

      // On small screens, bring the bay into view so the docking is visible.
      if (window.innerWidth < 1024) {
        const r = bayEl.getBoundingClientRect();
        if (r.top < 0 || r.bottom > window.innerHeight) {
          bayEl.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
        }
      }

      let occupied = false;
      actors.forEach((actor, id) => {
        if (id !== disc.catalog && (actor.mode === 'docked' || actor.mode === 'entering')) {
          occupied = true;
          actor.returnToSlot();
        }
      });

      activeIndex = idx;
      announce(disc);
      // FIX: Update chrome/aura ONCE here (not a second time inside launch())
      updateChrome(disc);

      if (occupied) {
        swapPanel(disc, 340);
        pendingLaunch = setTimeout(() => launch(idx), 200);
      } else {
        swapPanel(disc, 210);
        launch(idx);
      }
    }

    function returnToStack(catalog: string | null = null, reset = true) {
      if (pendingLaunch) clearTimeout(pendingLaunch);

      let target = catalog;
      if (!target && activeIndex !== -1) target = DISCS[activeIndex]?.catalog ?? null;
      if (!target) return;

      const actor = actors.get(target);
      if (actor && (actor.mode === 'docked' || actor.mode === 'entering')) {
        actor.returnToSlot();
      }

      if (reset && activeIndex !== -1 && DISCS[activeIndex]?.catalog === target) {
        activeIndex = -1;
        updateChrome(null);
        swapPanel(null, 220);
        announce(null);
      }
    }

    // ---------------------------------------------------------------- categories
    function applyCategory(nextCat: string) {
      if (nextCat === activeCategory) return;
      activeCategory = nextCat;

      filterBtns.forEach((btn) => {
        const active = btn.dataset.cdFilter === activeCategory;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      const vis = visibleIndices();
      if (stackLabelEl) {
        const n = String(vis.length).padStart(2, '0');
        stackLabelEl.textContent = `Stack · ${n} ${vis.length === 1 ? 'Disc' : 'Discs'}`;
      }

      clearParting();
      towerEl.querySelectorAll('.cd-slot').forEach((slot) => {
        const el = slot as HTMLElement;
        const cat = el.dataset.category || '';
        const match = activeCategory === 'all' || cat === activeCategory;
        el.classList.toggle('is-filtered-out', !match);
      });

      // Keep the active disc if it belongs to the chosen category; otherwise load the first visible disc
      if (activeIndex !== -1 && vis.includes(activeIndex)) {
        scheduleSync();
      } else if (vis.length > 0) {
        selectProject(vis[0]);
      } else {
        returnToStack(null, true);
      }
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyCategory(btn.dataset.cdFilter || 'all');
      });
    });

    // ---------------------------------------------------------------- chrome
    btnPrev?.addEventListener('click', () => {
      const vis = visibleIndices();
      if (!vis.length) return;
      const pos = vis.indexOf(activeIndex);
      const idx = pos <= 0 ? vis[vis.length - 1] : vis[pos - 1];
      selectProject(idx);
    });
    btnNext?.addEventListener('click', () => {
      const vis = visibleIndices();
      if (!vis.length) return;
      const pos = vis.indexOf(activeIndex);
      const idx = pos === -1 || pos >= vis.length - 1 ? vis[0] : vis[pos + 1];
      selectProject(idx);
    });
    btnReturn?.addEventListener('click', () => {
      returnToStack(null, true);
    });

    // Sync via rAF on scroll/resize for silky-smooth tracking with LenisSmoothScroll
    const scheduleSync = () => {
      if (syncRafId !== null) return;
      syncRafId = requestAnimationFrame(() => {
        syncRafId = null;
        actors.forEach((a) => a.syncToBay());
      });
    };

    window.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('resize', scheduleSync);

    let ro: ResizeObserver | null = null;
    if (typeof ResizeObserver !== 'undefined') {
      ro = new ResizeObserver(scheduleSync);
      ro.observe(bayEl);
    }

    // ---------------------------------------------------------------- initial state: open from the start
    if (!panelEl.firstElementChild && DISCS[0]) {
      panelEl.innerHTML = panelHTML(DISCS[0]);
    }
    activeIndex = 0;
    if (DISCS[0]) {
      announce(DISCS[0]);
      const slot0 = slotEl(DISCS[0].catalog);
      if (slot0) {
        const actor = new JewelCase(DISCS[0], slot0);
        actors.set(DISCS[0].catalog, actor);
        actor.dockInstantly();
      }
      updateChrome(DISCS[0]);
      requestAnimationFrame(() => actors.forEach((a) => a.syncToBay()));
    }

    // ---------------------------------------------------------------- teardown
    teardown = () => {
      if (pendingLaunch) clearTimeout(pendingLaunch);
      if (panelSwap) clearTimeout(panelSwap);
      if (syncRafId !== null) cancelAnimationFrame(syncRafId);
      ro?.disconnect();
      window.removeEventListener('scroll', scheduleSync);
      window.removeEventListener('resize', scheduleSync);
      actors.forEach((a) => a.stop());
      actors.clear();
      audio.dispose();
      stage.remove();
      root.dataset.cdBound = '0';
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootCdArchive, { once: true });
  } else {
    bootCdArchive();
  }
  document.addEventListener('astro:page-load', bootCdArchive);
  document.addEventListener('astro:before-swap', () => {
    if (teardown) {
      teardown();
      teardown = null;
    }
  });
</script>