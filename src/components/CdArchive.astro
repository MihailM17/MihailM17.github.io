---
// ============================================================================
// CdArchive - physical CD jewel-case archive browser
// Data comes from the content collections (projects + site.commercial.jobs).
// All colour/typography is mapped to the site tokens in Layout.astro.
// ============================================================================
import { getCollection } from 'astro:content';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
}

const {
  id = 'work',
  eyebrow = 'Work',
  title = 'Selected work',
} = Astro.props;

const allProjects = await getCollection('projects');
const site = (await getCollection('site'))[0]?.data;

type CategoryId = 'short-films' | 'documentary' | 'television' | 'commercial-music';

const CATEGORIES: { id: 'all' | CategoryId; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'short-films', label: 'Short Films' },
  { id: 'documentary', label: 'Documentary' },
  { id: 'television', label: 'Television' },
  { id: 'commercial-music', label: 'Commercial & Music Videos' },
];

const CATEGORY_LABELS: Record<CategoryId, string> = {
  'short-films': 'Short Films',
  documentary: 'Documentary',
  television: 'Television',
  'commercial-music': 'Commercial & Music Videos',
};

const classifyProject = (slug: string, kicker: string): CategoryId => {
  if (/documentary/i.test(kicker)) return 'documentary';
  if (slug === 'remake-season-2' || /tv|television|reality/i.test(kicker)) return 'television';
  if (/music video|commercial|broadcast|promo/i.test(kicker)) return 'commercial-music';
  return 'short-films';
};

// Two accents only: films/originals use brass, commercial/broadcast productions use oxblood.
const ACCENT = {
  film: { hex: '#D4A24C', glow: 'rgba(212,162,76,0.17)' },
  company: { hex: '#B23A2E', glow: 'rgba(178,58,46,0.17)' },
};

// Hand-stacked micro offset, one per shelf position (in px).
const MICRO = [-2, 2, -1, 3, -3, 1, -2, 2, -1];

// YouTube serves hqdefault for every video, so it is a safe second attempt.
const youTubeFallback = (src: unknown) =>
  typeof src === 'string' && src.includes('maxresdefault')
    ? src.replace('maxresdefault', 'hqdefault')
    : null;

// Custom 1:1 square CD covers (Silent Lifts & Lunen Blyasak intentionally keep their existing covers)
const CUSTOM_COVERS: Record<string, string> = {
  'tdb-play': '/cd-cover-tdb-play.jpg',
  '7arts-artportal': '/cd-cover-7arts.jpg',
  'zasnet': '/cd-cover-zasnet.jpg',
  'remake-season-2': '/cd-cover-remakecut.jpg',
  'eastern-wind': '/cd-cover-eastern-wind.jpg',
  'timeless-ep1': '/cd-cover-sapunenite-mehuri.jpg',
  'timeless-ep2': '/cd-cover-koleloto.jpg',
};

// Dominant / average cover artwork colors for atmospheric ambient illumination
const DISC_COLORS: Record<string, { r: number; g: number; b: number; hex: string }> = {
  'silent-lifts-vitosha': { r: 68, g: 122, b: 100, hex: '#447a64' }, // Mountain forest pine green
  'tdb-play':             { r: 214, g: 122, b: 36, hex: '#d67a24' }, // Good Game warm stage orange
  'lunen-blyasak':        { r: 38, g: 78,  b: 132, hex: '#264e84' }, // Moonlit sapphire blue
  '7arts-artportal':      { r: 30, g: 64,  b: 204, hex: '#1e40cc' }, // 7Arts electric royal blue
  'zasnet':               { r: 88, g: 124, b: 138, hex: '#587c8a' }, // Cool misty winter lake teal
  'remake-season-2':      { r: 44, g: 82,  b: 196, hex: '#2c52c4' }, // Gundi Remake cobalt blue
  'eastern-wind':         { r: 108, g: 130, b: 112, hex: '#6c8270' }, // Misty mountain pine sage
  'timeless-ep1':         { r: 36, g: 118, b: 198, hex: '#2476c6' }, // Soap bubbles winter cobalt blue
  'timeless-ep2':         { r: 74, g: 142, b: 130, hex: '#4a8e82' }, // Koleloto teal & warm illustration
};

const filmDiscs = allProjects.map((entry) => {
  const d = entry.data;
  const displayTitle =
    d.slug === 'silent-lifts-vitosha' && d.titleEn ? d.titleEn : d.title;
  const color = DISC_COLORS[d.slug] || { r: 212, g: 162, b: 76, hex: '#D4A24C' };
  const category = classifyProject(d.slug, d.kicker);
  const customCover = CUSTOM_COVERS[d.slug];
  return {
    id: d.slug,
    kind: 'film',
    category,
    categoryLabel: CATEGORY_LABELS[category],
    title: displayTitle,
    year: d.year,
    role: d.kicker,
    format: d.meta,
    description: d.synopsis,
    cover: customCover || d.thumb,
    fallback: customCover ? d.thumb : youTubeFallback(d.thumb),
    customArt: Boolean(customCover),
    href: `/projects/${d.slug}`,
    watchUrl: d.youtubeUrl,
    accent: ACCENT.film.hex,
    glow: `rgba(${color.r}, ${color.g}, ${color.b}, 0.42)`,
    avg: color,
  };
});

// Commercial & broadcast productions from site content (zero project data lost)
const jobs = site?.commercial?.jobs || [];
const tdbJob = jobs.find((job: any) => job.detail?.slug === 'tdb-play');
const sevenArtsJob = jobs.find((job: any) => job.detail?.slug === '7arts-artportal');
const timelessJob = jobs.find((job: any) => job.org.toLowerCase().includes('timeless'));

const ep1Item = timelessJob?.items?.[0];
const ep2Item = timelessJob?.items?.[1];
const tdbColor = DISC_COLORS['tdb-play'];
const sevenArtsColor = DISC_COLORS['7arts-artportal'];
const ep1Color = DISC_COLORS['timeless-ep1'];
const ep2Color = DISC_COLORS['timeless-ep2'];

const extraDiscs = [
  tdbJob && {
    id: 'tdb-play',
    kind: 'commercial',
    category: 'commercial-music' as CategoryId,
    categoryLabel: CATEGORY_LABELS['commercial-music'],
    title: 'TDB Play — Live Broadcast',
    year: '2026',
    role: tdbJob.role,
    format: 'Vivacom Game-ON & Good Game Festival · Freelance',
    description: tdbJob.desc,
    cover: CUSTOM_COVERS['tdb-play'],
    fallback: '/goodgame-director-vision-mixer.jpg',
    customArt: true,
    href: '/companies/tdb-play',
    watchUrl: tdbJob.detail?.videoUrl || 'https://www.youtube.com/watch?v=Epg8ynZ2TDc',
    accent: ACCENT.company.hex,
    glow: `rgba(${tdbColor.r}, ${tdbColor.g}, ${tdbColor.b}, 0.42)`,
    avg: tdbColor,
  },
  sevenArtsJob && {
    id: '7arts-artportal',
    kind: 'commercial',
    category: 'commercial-music' as CategoryId,
    categoryLabel: CATEGORY_LABELS['commercial-music'],
    title: '7Arts & ArtPortal',
    year: '2026',
    role: sevenArtsJob.role,
    format: 'Trailers, Promos & Social Reels · June 2025 – March 2026',
    description: sevenArtsJob.desc,
    cover: CUSTOM_COVERS['7arts-artportal'],
    fallback: sevenArtsJob.items?.[0]?.thumb || '/art-portal-cover.jpg',
    customArt: true,
    href: '/companies/7arts-artportal',
    watchUrl: sevenArtsJob.items?.[0]?.url || 'https://www.instagram.com/reel/DP1d4V7DE5n/',
    accent: ACCENT.company.hex,
    glow: `rgba(${sevenArtsColor.r}, ${sevenArtsColor.g}, ${sevenArtsColor.b}, 0.42)`,
    avg: sevenArtsColor,
  },
  {
    id: 'timeless-ep1',
    kind: 'episode',
    category: 'television' as CategoryId,
    categoryLabel: CATEGORY_LABELS['television'],
    title: ep1Item?.label || 'Сапунените мехури',
    year: '2025',
    role: 'Video Editor · Уча, зная и играя',
    format: 'TV Broadcast Episode · Timeless Production',
    description:
      "Broadcast episode for children's educational series 'Уча, зная и играя' on national television, edited for Timeless Production Group.",
    cover: CUSTOM_COVERS['timeless-ep1'],
    fallback: ep1Item?.thumb || 'https://img.youtube.com/vi/vC3i48d0Mms/maxresdefault.jpg',
    customArt: true,
    href: '/companies/timeless-production',
    watchUrl: ep1Item?.url || 'https://youtu.be/vC3i48d0Mms',
    accent: ACCENT.company.hex,
    glow: `rgba(${ep1Color.r}, ${ep1Color.g}, ${ep1Color.b}, 0.42)`,
    avg: ep1Color,
  },
  {
    id: 'timeless-ep2',
    kind: 'episode',
    category: 'television' as CategoryId,
    categoryLabel: CATEGORY_LABELS['television'],
    title: ep2Item?.label || 'Колелото',
    year: '2025',
    role: 'Video Editor · Уча, зная и играя',
    format: 'TV Broadcast Episode · Timeless Production',
    description:
      "Broadcast episode exploring how wheels work for 'Уча, зная и играя', edited for Timeless Production Group.",
    cover: CUSTOM_COVERS['timeless-ep2'],
    fallback: ep2Item?.thumb || 'https://img.youtube.com/vi/CE5H1h6dpFw/maxresdefault.jpg',
    customArt: true,
    href: '/companies/timeless-production',
    watchUrl: ep2Item?.url || 'https://youtu.be/CE5H1h6dpFw',
    accent: ACCENT.company.hex,
    glow: `rgba(${ep2Color.r}, ${ep2Color.g}, ${ep2Color.b}, 0.42)`,
    avg: ep2Color,
  },
].filter(Boolean) as any[];

// Recency-first curated order across all works
const DISC_ORDER = [
  'silent-lifts-vitosha',
  'tdb-play',
  'lunen-blyasak',
  '7arts-artportal',
  'zasnet',
  'remake-season-2',
  'eastern-wind',
  'timeless-ep1',
  'timeless-ep2',
];

const discOrderIndex = (id: string) => {
  const idx = DISC_ORDER.indexOf(id);
  return idx === -1 ? 999 : idx;
};

const rawDiscs = [...filmDiscs, ...extraDiscs].sort(
  (a, b) => discOrderIndex(a.id) - discOrderIndex(b.id),
);

const discs = rawDiscs.map((disc, i) => ({
  ...disc,
  catalog: `MM-${String(i + 1).padStart(2, '0')}`,
  microX: MICRO[i % MICRO.length] ?? 0,
}));

const categoryCounts: Record<string, number> = { all: discs.length };
for (const d of discs) {
  categoryCounts[d.category] = (categoryCounts[d.category] || 0) + 1;
}

const total = String(discs.length).padStart(2, '0');
const initialDisc = discs[0];
const initialAvg = initialDisc?.avg ?? { r: 68, g: 122, b: 100 };
---

<section id={id} class="cd-archive" data-cd-archive>
  <div class="cd-ambient" data-cd-ambient aria-hidden="true">
    <div
      class="cd-ambient-layer cd-ambient-a is-active"
      data-ambient-a
      style={`background: radial-gradient(ellipse 65% 55% at 58% 46%, rgba(${initialAvg.r}, ${initialAvg.g}, ${initialAvg.b}, 0.18) 0%, rgba(${initialAvg.r}, ${initialAvg.g}, ${initialAvg.b}, 0.05) 52%, transparent 76%);`}
    ></div>
    <div class="cd-ambient-layer cd-ambient-b" data-ambient-b></div>
  </div>

  <div class="container cd-inner">
    <div class="cd-head" data-reveal>
      <div class="cd-head-top">
        <div>
          <span class="eyebrow">{eyebrow}</span>
          <h2>{title}<em>.</em></h2>
        </div>
        <div class="cd-filters" role="group" aria-label="Filter projects by category" data-cd-filters>
          {CATEGORIES.map((cat) => (
            <button
              type="button"
              class={`cd-filter ${cat.id === 'all' ? 'is-active' : ''}`}
              data-cd-filter={cat.id}
              aria-pressed={cat.id === 'all' ? 'true' : 'false'}
            >
              <span>{cat.label}</span>
              <span class="cd-filter-count">{String(categoryCounts[cat.id] || 0).padStart(2, '0')}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <div class="cd-layout">
      <!-- ---------------------------------------------------------------- -->
      <!-- TOWER                                                             -->
      <!-- ---------------------------------------------------------------- -->
      <div class="cd-tower-col">
        <div class="cd-tower-frame">
          <div class="cd-tower-meta">
            <span data-cd-stack-label>Stack · {total} Discs</span>
            <span class="cd-tower-meta-dim">2025—2026</span>
          </div>

          <div
            class="cd-tower"
            data-cd-tower
            role="group"
            aria-label="Work stack - select a disc"
          >
            {discs.map((disc, i) => (
              <div
                class={`cd-slot ${i === 0 ? 'is-empty' : ''}`}
                data-id={disc.catalog}
                data-index={i}
                data-category={disc.category}
                style={`--case-accent:${disc.accent};--micro-x:${disc.microX}px;`}
              >
                {/* FIX: Only mark non-empty cavities as inert initially; slot 0 starts in bay */}
                <button
                  type="button"
                  class="cd-cavity"
                  data-cavity={i}
                  tabindex={i === 0 ? 0 : -1}
                  inert={i !== 0 ? true : undefined}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  aria-label={`Return ${disc.title} to the stack`}
                >
                  <span class="cd-cavity-mark">
                    <span>{disc.catalog} · In bay</span>
                  </span>
                  <span class="cd-cavity-action">Return ↩</span>
                </button>

                <button
                  type="button"
                  class="cd-spine"
                  data-spine={i}
                  tabindex={i === 0 ? -1 : 0}
                  inert={i === 0 ? true : undefined}
                  aria-hidden={i === 0 ? 'true' : 'false'}
                  aria-label={`${disc.catalog}: ${disc.title}, ${disc.year}`}
                >
                  <span class="cd-spine-shell">
                    <span class="cd-spine-hinge" aria-hidden="true"></span>
                    <span class="cd-spine-paper">
                      <span class="cd-spine-band" aria-hidden="true"></span>
                      <span class="cd-spine-main">
                        <span class="cd-spine-code">{disc.catalog}</span>
                        <span class="cd-spine-title">{disc.title}</span>
                      </span>
                      <span class="cd-spine-year">{disc.year}</span>
                    </span>
                    <span class="cd-spine-cap" aria-hidden="true"></span>
                    <span class="cd-spine-glare" aria-hidden="true"></span>
                  </span>
                </button>
              </div>
            ))}
          </div>

          <div class="cd-plinth" aria-hidden="true"></div>

          <p class="cd-hint">
            Click a disc to load it into the bay · click the empty slot to return it
          </p>
        </div>
      </div>

      <!-- ---------------------------------------------------------------- -->
      <!-- BAY                                                               -->
      <!-- ---------------------------------------------------------------- -->
      <div class="cd-bay-col">
        <div class="cd-bay-wrap">
          <div class="cd-aura-wrap" aria-hidden="true">
            <div
              class="cd-aura cd-aura-a is-active"
              data-aura-a
              style={`background: radial-gradient(circle closest-side, rgba(${initialAvg.r}, ${initialAvg.g}, ${initialAvg.b}, 0.44) 0%, rgba(${initialAvg.r}, ${initialAvg.g}, ${initialAvg.b}, 0.22) 42%, rgba(${initialAvg.r}, ${initialAvg.g}, ${initialAvg.b}, 0.07) 72%, transparent 100%);`}
            ></div>
            <div class="cd-aura cd-aura-b" data-aura-b></div>
          </div>

          <div class="cd-bay has-disc" data-cd-bay aria-label="Display bay">
            <div class="cd-bay-spot" aria-hidden="true"></div>
            <span class="cd-bay-corner tl" aria-hidden="true"></span>
            <span class="cd-bay-corner tr" aria-hidden="true"></span>
            <span class="cd-bay-corner bl" aria-hidden="true"></span>
            <span class="cd-bay-corner br" aria-hidden="true"></span>

            <div class="cd-standby">
              <div class="cd-standby-ring">
                <div class="cd-standby-hub">
                  <div class="cd-standby-pin"></div>
                </div>
                <span class="cd-standby-label">Display Bay</span>
              </div>
              <p class="cd-standby-text">Select a disc from the tower</p>
            </div>

            <div class="cd-bay-shadow" aria-hidden="true"></div>
          </div>

          <div class="cd-transport">
            <button type="button" class="cd-tbtn" data-cd-prev aria-label="Previous disc">
              ← Prev
            </button>
            <button
              type="button"
              class="cd-tbtn"
              data-cd-return
              aria-label="Return current disc to the tower"
            >
              Return
            </button>
            <button type="button" class="cd-tbtn" data-cd-next aria-label="Next disc">
              Next →
            </button>
          </div>
        </div>
      </div>

      <aside class="cd-panel" data-cd-panel aria-label="Selected work details">
        {discs[0] && (
          <div class="cd-stagger">
            <div class="cd-kicker">
              <span style={`color:${discs[0].accent}`}>{discs[0].catalog} · {discs[0].categoryLabel} · {discs[0].year}</span>
            </div>
            <h3 class="cd-panel-title">{discs[0].title}</h3>
            <div class="cd-panel-meta">
              <p class="cd-panel-role">{discs[0].role}</p>
              <p class="cd-panel-format">{discs[0].format}</p>
            </div>
            <p class="cd-panel-desc">{discs[0].description}</p>
            <div class="cd-panel-actions">
              {discs[0].href && (
                <a class="cd-action" href={discs[0].href}>
                  Open project <span aria-hidden="true">→</span>
                </a>
              )}
              {discs[0].watchUrl && (
                <a
                  class="cd-action cd-action-ghost"
                  href={discs[0].watchUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Watch <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        )}
      </aside>
    </div>

    <p class="cd-live" data-cd-live aria-live="polite"></p>
  </div>

  <script type="application/json" data-cd-data set:html={JSON.stringify(discs)}></script>
</section>

<style is:global>
  /* ==========================================================================
     ROOT / TOKENS
     FIX: Define --cd-* tokens on BOTH .cd-archive AND .cd-flight-stage so the
     3D actors appended to <body> inherit every color and easing curve properly!
     ========================================================================== */
  .cd-archive,
  .cd-flight-stage {
    --cd-deep: #120e0c;
    --cd-surface: #1e1815;
    --cd-paper: #241d19;
    --cd-line: rgba(239, 230, 216, 0.12);
    --cd-line-soft: rgba(239, 230, 216, 0.07);
    --cd-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --slot-h: 36px;
  }

  .cd-archive {
    position: relative;
    padding-block: clamp(5rem, 9vw, 8.25rem);
    background: #15100E;
    overflow: clip;
    scroll-margin-top: 84px;
  }

  /* Warm tungsten studio light pooled behind the bay */
  .cd-archive::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 48% 46% at 62% 44%, rgba(255, 224, 185, 0.05) 0%, rgba(255, 206, 160, 0.015) 50%, transparent 76%),
      linear-gradient(180deg, rgba(18, 14, 12, 0.35) 0%, transparent 35%);
  }

  .cd-ambient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .cd-ambient-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    will-change: opacity;
    transition: opacity 1.4s var(--cd-ease);
  }
  .cd-ambient-layer.is-active {
    opacity: 1;
  }

  .cd-inner {
    position: relative;
    z-index: 2;
    max-width: 1320px;
  }

  /* Header & category filters */
  .cd-head {
    margin-bottom: var(--sp-4);
  }
  .cd-head-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }
  .cd-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 4.2vw, 2.8rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--ecru);
  }
  .cd-head h2 em {
    font-style: normal;
    color: var(--brass);
  }

  .cd-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
  }
  .cd-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.46rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--cd-line);
    background: rgba(30, 24, 21, 0.45);
    color: var(--ash);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .cd-filter:hover {
    color: var(--ecru);
    border-color: rgba(239, 230, 216, 0.3);
  }
  .cd-filter.is-active {
    color: var(--ink);
    background: var(--brass);
    border-color: var(--brass);
    font-weight: 600;
  }
  .cd-filter-count {
    opacity: 0.62;
    font-size: 0.62rem;
  }
  .cd-filter.is-active .cd-filter-count {
    opacity: 0.8;
  }

  /* ==========================================================================
     LAYOUT
     Mobile: bay, then details, then the stack.
     1024px: stack on the left, large bay above details on the right.
     1200px: stack, centerpiece bay, streamlined details side by side.
     ========================================================================== */
  .cd-layout {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'bay'
      'panel'
      'tower';
    gap: clamp(2.25rem, 5vw, 3.5rem);
    align-items: center;
  }
  .cd-tower-col {
    grid-area: tower;
    min-width: 0;
    position: relative;
    z-index: 3;
  }
  .cd-bay-col {
    grid-area: bay;
    min-width: 0;
    position: relative;
    z-index: 1;
  }
  .cd-panel {
    grid-area: panel;
    position: relative;
    z-index: 3;
  }

  @media (min-width: 1024px) {
    .cd-layout {
      grid-template-columns: 280px minmax(0, 1fr);
      grid-template-areas:
        'tower bay'
        'tower panel';
      column-gap: clamp(2rem, 4vw, 3.25rem);
      row-gap: clamp(2.25rem, 4vw, 3rem);
      align-items: start;
    }
  }

  @media (min-width: 1200px) {
    .cd-layout {
      grid-template-columns: 278px 360px minmax(260px, 1fr);
      grid-template-areas: 'tower bay panel';
      column-gap: clamp(2.25rem, 3.8vw, 3.5rem);
      align-items: center;
    }
  }

  /* ==========================================================================
     TOWER
     ========================================================================== */
  .cd-tower-frame {
    position: relative;
    width: 100%;
    max-width: 392px;
    margin: 0 auto;
  }
  .cd-tower-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-inline: 2px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .cd-tower-meta-dim {
    opacity: 0.6;
  }

  .cd-tower {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 8px 0 18px;
  }

  .cd-plinth {
    position: relative;
    height: 12px;
    margin: -6px -8px 0;
    border-radius: 4px;
    background: linear-gradient(180deg, var(--cd-surface) 0%, var(--cd-deep) 60%, #0a0806 100%);
    border-top: 1px solid rgba(239, 230, 216, 0.09);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.72), 0 4px 10px rgba(0, 0, 0, 0.6);
  }
  .cd-plinth::after {
    content: '';
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -10px;
    height: 12px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.7) 0%, transparent 72%);
    filter: blur(5px);
    pointer-events: none;
  }

  .cd-hint {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.6;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ash);
    opacity: 0.72;
    text-align: center;
  }
  @media (min-width: 1024px) {
    .cd-hint {
      text-align: left;
    }
  }

  .cd-slot {
    position: relative;
    height: var(--slot-h);
    width: 100%;
    transition: transform 0.34s var(--cd-ease);
  }
  .cd-slot.is-filtered-out {
    display: none;
  }
  .cd-slot.part-up {
    transform: translateY(-2.5px);
  }
  .cd-slot.part-down {
    transform: translateY(2.5px);
  }

  /* Recessed cavity left behind when a disc is out */
  .cd-cavity {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    border-radius: 4px;
    background: linear-gradient(180deg, #0b0806 0%, #100c0a 55%, #0c0908 100%);
    border: 1px dashed rgba(239, 230, 216, 0.09);
    box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.8), inset 0 -3px 6px rgba(0, 0, 0, 0.65);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, border-color 0.25s ease, background-color 0.25s ease;
    font: inherit;
    color: inherit;
  }
  .cd-slot.is-empty .cd-cavity {
    opacity: 1;
    pointer-events: auto;
  }
  .cd-slot.is-empty .cd-cavity:hover {
    border-color: rgba(239, 230, 216, 0.22);
    background: linear-gradient(180deg, #100c0a 0%, #15100d 100%);
  }
  .cd-cavity-mark {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(239, 230, 216, 0.3);
    user-select: none;
  }
  .cd-cavity-action {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(239, 230, 216, 0.22);
    transition: color 0.2s ease;
  }
  .cd-cavity:hover .cd-cavity-action {
    color: rgba(239, 230, 216, 0.7);
  }

  /* Seated spine */
  .cd-spine {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
    display: block;
    transform: translate3d(var(--micro-x, 0px), 0, 0);
    transition: transform 0.34s var(--cd-ease);
  }
  .cd-spine:hover,
  .cd-spine:focus-visible {
    transform: translate3d(calc(var(--micro-x, 0px) + 18px), 0, 0);
  }
  .cd-spine:focus-visible .cd-spine-shell {
    box-shadow: 0 0 0 1.5px var(--case-accent), 0 10px 22px rgba(0, 0, 0, 0.8);
  }
  .cd-slot.is-empty .cd-spine {
    visibility: hidden;
    pointer-events: none;
    transition: none;
  }

  .cd-spine-shell {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 3px;
    display: flex;
    align-items: stretch;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      rgba(239, 230, 216, 0.16) 0%,
      rgba(239, 230, 216, 0.04) 20%,
      rgba(18, 14, 12, 0.94) 50%,
      rgba(239, 230, 216, 0.06) 100%
    );
    border: 1px solid rgba(239, 230, 216, 0.15);
    border-top-color: rgba(239, 230, 216, 0.26);
    border-bottom-color: rgba(0, 0, 0, 0.8);
    box-shadow:
      inset 0 1px 0 rgba(239, 230, 216, 0.22),
      inset 0 -1px 0 rgba(239, 230, 216, 0.07),
      0 5px 12px rgba(0, 0, 0, 0.6),
      0 1px 2px rgba(0, 0, 0, 0.8);
    transition: border-color 0.25s ease, box-shadow 0.3s ease;
  }
  .cd-spine:hover .cd-spine-shell {
    border-color: rgba(239, 230, 216, 0.3);
    box-shadow:
      inset 0 1px 0 rgba(239, 230, 216, 0.36),
      inset 0 -1px 0 rgba(239, 230, 216, 0.13),
      0 12px 24px rgba(0, 0, 0, 0.7),
      0 0 18px -6px var(--case-accent);
  }

  .cd-spine-hinge {
    position: relative;
    width: 24px;
    flex-shrink: 0;
    background: repeating-linear-gradient(
      90deg,
      rgba(239, 230, 216, 0.1) 0px,
      rgba(239, 230, 216, 0.1) 2px,
      rgba(12, 9, 7, 0.88) 2px,
      rgba(12, 9, 7, 0.88) 4.5px
    );
    border-right: 1px solid rgba(239, 230, 216, 0.14);
    box-shadow: inset 2px 0 4px rgba(239, 230, 216, 0.08);
  }
  .cd-spine-hinge::before,
  .cd-spine-hinge::after {
    content: '';
    position: absolute;
    left: 4px;
    right: 4px;
    height: 2px;
    background: rgba(239, 230, 216, 0.18);
    border-radius: 1px;
  }
  .cd-spine-hinge::before {
    top: 3px;
  }
  .cd-spine-hinge::after {
    bottom: 3px;
  }

  .cd-spine-paper {
    position: relative;
    flex: 1;
    min-width: 0;
    margin: 2px 0;
    padding: 0 12px 0 13px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: linear-gradient(180deg, var(--cd-paper) 0%, var(--cd-surface) 52%, #191310 100%);
    border-top: 1px solid rgba(239, 230, 216, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .cd-spine-band {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--case-accent);
    opacity: 0.92;
  }
  .cd-spine-main {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .cd-spine-code {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--ash);
    flex-shrink: 0;
  }
  .cd-spine-title {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--ecru);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cd-spine-year {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: rgba(239, 230, 216, 0.6);
    flex-shrink: 0;
  }
  .cd-spine-cap {
    width: 12px;
    flex-shrink: 0;
    background: linear-gradient(
      90deg,
      rgba(239, 230, 216, 0.04) 0%,
      rgba(239, 230, 216, 0.15) 55%,
      rgba(239, 230, 216, 0.04) 100%
    );
    border-left: 1px solid rgba(239, 230, 216, 0.12);
  }
  .cd-spine-glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      112deg,
      transparent 14%,
      rgba(239, 230, 216, 0.09) 26%,
      rgba(239, 230, 216, 0.02) 33%,
      transparent 44%,
      rgba(239, 230, 216, 0.05) 74%,
      transparent 86%
    );
    opacity: 0.72;
    transition: opacity 0.25s ease, transform 0.35s ease;
  }
  .cd-spine:hover .cd-spine-glare {
    opacity: 1;
    transform: translateX(10px);
  }

  /* ==========================================================================
     DISPLAY BAY
     ========================================================================== */
  .cd-bay-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* Wide atmospheric background aura directly behind the CD in the bay */
  .cd-aura-wrap {
    position: absolute;
    top: 172px;
    left: 50%;
    width: clamp(560px, 78vw, 840px);
    height: clamp(560px, 78vw, 840px);
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
    overflow: visible;
  }
  @media (max-width: 1199px) and (min-width: 1024px) {
    .cd-aura-wrap {
      top: 162px;
    }
  }
  /* FIX: Align mobile breakpoint consistently at 1023px across CSS & JS */
  @media (max-width: 1023px) {
    .cd-aura-wrap {
      top: 132px;
      width: clamp(380px, 92vw, 560px);
      height: clamp(380px, 92vw, 560px);
    }
  }

  .cd-aura {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    filter: blur(52px);
    opacity: 0;
    will-change: opacity;
    transition: opacity 1.4s var(--cd-ease);
    pointer-events: none;
  }
  .cd-aura.is-active {
    opacity: 1;
  }

  .cd-bay {
    position: relative;
    width: 344px;
    height: 344px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  @media (max-width: 1199px) and (min-width: 1024px) {
    .cd-bay {
      width: 324px;
      height: 324px;
    }
  }
  @media (max-width: 1023px) {
    .cd-bay {
      width: clamp(232px, 64vw, 290px);
      height: clamp(232px, 64vw, 290px);
    }
  }

  .cd-bay-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: rgba(239, 230, 216, 0.14);
    pointer-events: none;
    transition: border-color 0.5s ease;
  }
  .cd-bay-corner.tl {
    top: -14px;
    left: -14px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .cd-bay-corner.tr {
    top: -14px;
    right: -14px;
    border-top: 1px solid;
    border-right: 1px solid;
  }
  .cd-bay-corner.bl {
    bottom: -14px;
    left: -14px;
    border-bottom: 1px solid;
    border-left: 1px solid;
  }
  .cd-bay-corner.br {
    bottom: -14px;
    right: -14px;
    border-bottom: 1px solid;
    border-right: 1px solid;
  }
  .cd-bay.has-disc .cd-bay-corner {
    border-color: rgba(239, 230, 216, 0.26);
  }

  .cd-bay-spot {
    position: absolute;
    inset: -44px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 42%,
      rgba(255, 224, 185, 0.075) 0%,
      rgba(255, 210, 170, 0.02) 45%,
      transparent 72%
    );
    pointer-events: none;
  }

  .cd-bay-shadow {
    position: absolute;
    bottom: -26px;
    left: 50%;
    width: 82%;
    height: 20px;
    transform: translateX(-50%) scale(0.75);
    border-radius: 50%;
    background: radial-gradient(
      ellipse at center,
      rgba(0, 0, 0, 0.8) 0%,
      rgba(0, 0, 0, 0.4) 46%,
      transparent 75%
    );
    filter: blur(8px);
    opacity: 0.35;
    pointer-events: none;
    transition: opacity 0.55s var(--cd-ease), transform 0.55s var(--cd-ease);
  }
  .cd-bay.has-disc .cd-bay-shadow {
    opacity: 0.95;
    transform: translateX(-50%) scale(1.06);
  }

  .cd-standby {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    pointer-events: none;
    transition: opacity 0.38s ease, transform 0.45s var(--cd-ease);
  }
  .cd-bay.has-disc .cd-standby {
    opacity: 0;
    transform: scale(0.94);
  }
  .cd-standby-ring {
    position: relative;
    width: 144px;
    height: 144px;
    margin-bottom: 1rem;
    border-radius: 50%;
    border: 1px dashed var(--cd-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cd-standby-hub {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--cd-line);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cd-standby-pin {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cd-line);
  }
  .cd-standby-label {
    position: absolute;
    bottom: -10px;
    padding: 0 10px;
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .cd-standby-text {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ash);
    opacity: 0.8;
  }

  .cd-transport {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.45rem;
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .cd-tbtn {
    padding: 0.48rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--cd-line);
    background: transparent;
    color: var(--ash);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
  }
  .cd-tbtn:hover {
    color: var(--ecru);
    border-color: rgba(239, 230, 216, 0.35);
  }
  .cd-tbtn:disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  /* ==========================================================================
     EDITORIAL PANEL
     ========================================================================== */
  .cd-panel {
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: opacity 0.24s ease, transform 0.34s var(--cd-ease);
  }
  @media (min-width: 768px) {
    .cd-panel {
      padding-left: 1.5rem;
      border-left: 1px solid var(--cd-line);
    }
  }
  /* Keep clear horizontal separation from the peeking CD on 3-column desktop */
  @media (min-width: 1200px) {
    .cd-panel {
      margin-left: clamp(5.5rem, 6.8vw, 7rem);
      padding-left: 1.75rem;
    }
  }
  .cd-panel.is-exiting {
    opacity: 0;
    transform: translateY(10px);
  }
  .cd-stagger > * {
    opacity: 0;
    transform: translateY(12px);
    animation: cdEnter 0.48s var(--cd-ease) forwards;
  }
  .cd-stagger > *:nth-child(1) { animation-delay: 0.02s; }
  .cd-stagger > *:nth-child(2) { animation-delay: 0.07s; }
  .cd-stagger > *:nth-child(3) { animation-delay: 0.12s; }
  .cd-stagger > *:nth-child(4) { animation-delay: 0.17s; }
  .cd-stagger > *:nth-child(5) { animation-delay: 0.22s; }
  @keyframes cdEnter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cd-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .cd-panel-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0 0 1rem;
  }
  .cd-panel-meta {
    padding-bottom: 0.9rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--cd-line);
  }
  .cd-panel-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(239, 230, 216, 0.9);
    margin: 0;
  }
  .cd-panel-format {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--ash);
    margin: 0.25rem 0 0;
  }
  .cd-panel-desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ash);
    margin: 0;
  }
  .cd-panel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .cd-action {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--brass);
    background: rgba(212, 162, 76, 0.08);
    color: var(--brass);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .cd-action:hover {
    background: var(--brass);
    color: var(--ink);
  }
  .cd-action-ghost {
    border-color: var(--cd-line);
    background: transparent;
    color: var(--ash);
  }
  .cd-action-ghost:hover {
    background: transparent;
    border-color: rgba(239, 230, 216, 0.35);
    color: var(--ecru);
  }

  .cd-standby-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ecru);
    margin: 0 0 0.9rem;
  }
  .cd-standby-title em {
    font-style: normal;
    color: var(--ash);
  }
  .cd-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-top: 1rem;
    margin-top: 0.5rem;
    border-top: 1px solid var(--cd-line);
  }
  .cd-stat-value {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--ecru);
  }
  .cd-stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ash);
  }

  .cd-live {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ==========================================================================
     FLIGHT STAGE + 3D JEWEL CASE (appended to <body>)
     ========================================================================== */
  .cd-flight-stage {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
    perspective: 1400px;
    perspective-origin: 50% 50%;
    overflow: visible;
  }

  .cd-actor {
    position: fixed;
    left: 0;
    top: 0;
    transform-style: preserve-3d;
    will-change: transform;
    pointer-events: none;
  }
  .cd-actor.is-docked {
    pointer-events: auto;
  }

  .jc-face {
    position: absolute;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .jc-front {
    inset: 0;
    border-radius: 5px;
    display: flex;
    overflow: hidden;
    background: var(--cd-surface);
    border: 1.5px solid rgba(239, 230, 216, 0.24);
    box-shadow:
      inset 0 1px 0 rgba(239, 230, 216, 0.4),
      inset 0 -1px 0 rgba(239, 230, 216, 0.13),
      inset 1px 0 0 rgba(239, 230, 216, 0.2),
      inset -1px 0 0 rgba(239, 230, 216, 0.16),
      0 26px 52px -12px rgba(0, 0, 0, 0.7);
  }

  .jc-hinge {
    position: relative;
    flex-shrink: 0;
    background: repeating-linear-gradient(
      180deg,
      rgba(239, 230, 216, 0.1) 0px,
      rgba(239, 230, 216, 0.1) 2px,
      rgba(14, 10, 8, 0.9) 2px,
      rgba(14, 10, 8, 0.9) 5px
    );
    border-right: 1px solid rgba(239, 230, 216, 0.18);
    box-shadow: inset 3px 0 6px rgba(239, 230, 216, 0.13), inset -2px 0 5px rgba(0, 0, 0, 0.6);
  }
  .jc-hinge::before,
  .jc-hinge::after {
    content: '';
    position: absolute;
    left: 3px;
    right: 3px;
    height: 14px;
    border-radius: 2px;
    background: linear-gradient(180deg, rgba(239, 230, 216, 0.24), rgba(239, 230, 216, 0.06));
    border: 1px solid rgba(239, 230, 216, 0.2);
  }
  .jc-hinge::before { top: 14px; }
  .jc-hinge::after { bottom: 14px; }

  .jc-window {
    position: relative;
    flex: 1;
    height: 100%;
    overflow: hidden;
    background: var(--cd-deep);
  }
  .jc-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    user-select: none;
  }

