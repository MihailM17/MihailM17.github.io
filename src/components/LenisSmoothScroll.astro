---
// LenisSmoothScroll - buttery inertia + GSAP ScrollTrigger sync
// Respects prefers-reduced-motion cleanly and guarantees keyboard-focused elements are never hidden.
---

<script>
  import Lenis from 'lenis';
  import { gsap, ScrollTrigger } from '../lib/gsap';

  let lenis: Lenis | null = null;
  let updateLenis: ((time: number) => void) | null = null;

  function revealElementImmediately(el: Element) {
    const htmlEl = el as HTMLElement;
    gsap.killTweensOf(htmlEl);
    gsap.set(htmlEl, { opacity: 1, y: 0, clearProps: 'transform,willChange' });
    htmlEl.classList.add('reveal-visible');
  }

  function initLenis() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (lenis) {
      try {
        lenis.destroy();
      } catch {}
      lenis = null;
    }
    if (updateLenis) {
      gsap.ticker.remove(updateLenis);
      updateLenis = null;
    }

    const isMobile =
      window.innerWidth < 768 ||
      window.matchMedia('(pointer: coarse)').matches ||
      window.matchMedia('(hover: none)').matches;

    if (prefersReduced) {
      document.documentElement.classList.remove('lenis', 'lenis-smooth');
      document.documentElement.style.scrollBehavior = 'auto';
      document.querySelectorAll('[data-reveal]').forEach(revealElementImmediately);
      return;
    }

    if (isMobile) {
      document.documentElement.classList.remove('lenis', 'lenis-smooth');
      document.documentElement.style.scrollBehavior = 'smooth';
      initGsapShared();
      ScrollTrigger.refresh();
      return;
    }

    lenis = new Lenis({
      duration: 1.15,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      touchMultiplier: 1.6,
      wheelMultiplier: 1.0,
      lerp: 0.078,
      infinite: false,
    });

    document.documentElement.classList.add('lenis', 'lenis-smooth');
    lenis.on('scroll', ScrollTrigger.update);

    updateLenis = (time: number) => {
      lenis?.raf(time * 1000);
    };
    gsap.ticker.add(updateLenis);
    gsap.ticker.lagSmoothing(0);

    function hijackAnchors() {
      document.querySelectorAll<HTMLAnchorElement>('a[href*="#"], a[href="/"], a[href="/#top"]').forEach((anchor) => {
        if (anchor.dataset.lenisBound === '1') return;
        anchor.dataset.lenisBound = '1';
        anchor.addEventListener('click', (e) => {
          const href = anchor.getAttribute('href');
          if (!href || href === '#') return;

          if (href === '/' || href === '/#top') {
            const isHome = window.location.pathname === '/' || window.location.pathname === '/index.html';
            if (isHome) {
              e.preventDefault();
              const topEl = document.querySelector<HTMLElement>('#top');
              if (topEl && lenis) {
                lenis.scrollTo(topEl, { offset: -72, duration: 1.0 });
              } else {
                window.scrollTo({ top: 0, behavior: 'smooth' });
              }
              history.pushState(null, '', '/');
            }
            return;
          }

          if (href.startsWith('/#')) {
            const hash = href.slice(1);
            const target = document.querySelector<HTMLElement>(hash);
            if (target && (window.location.pathname === '/' || window.location.pathname === '/index.html')) {
              e.preventDefault();
              lenis?.scrollTo(target, { offset: -72, duration: 1.1 });
              history.pushState(null, '', hash);
            }
            return;
          }

          if (href.startsWith('#')) {
            const target = document.querySelector<HTMLElement>(href);
            if (target) {
              e.preventDefault();
              lenis?.scrollTo(target, { offset: -72, duration: 1.1 });
              history.pushState(null, '', href);
            }
          }
        });
      });
    }
    hijackAnchors();

    function handleInitialHash() {
      const hash = window.location.hash;
      if (!hash || hash === '#') return;
      const target = document.querySelector<HTMLElement>(hash);
      if (!target) return;
      setTimeout(() => {
        if (lenis) {
          lenis.scrollTo(target, { offset: -72, duration: 1.0 });
        } else {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 140);
    }

    (window as any).__LENIS__ = lenis;
    (window as any).__GSAP__ = gsap;
    (window as any).__ScrollTrigger__ = ScrollTrigger;

    initGsapShared();
    setTimeout(() => {
      ScrollTrigger.refresh();
      handleInitialHash();
    }, 100);
    window.addEventListener(
      'load',
      () => {
        ScrollTrigger.refresh();
        handleInitialHash();
      },
      { once: true },
    );
  }

  function initGsapShared() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const allReveal = gsap.utils.toArray<HTMLElement>('[data-reveal]:not([data-gsap-init])');
    allReveal.forEach((el) => {
      el.setAttribute('data-gsap-init', '1');
      // Guarantee keyboard focus NEVER lands on an invisible element
      el.addEventListener('focusin', () => revealElementImmediately(el), { once: true });
    });

    // Only animate elements that are currently below the fold; anything already visible stays visible
    const belowFold = allReveal.filter((el) => el.getBoundingClientRect().top > window.innerHeight * 0.95);
    const alreadyVisible = allReveal.filter((el) => el.getBoundingClientRect().top <= window.innerHeight * 0.95);
    alreadyVisible.forEach(revealElementImmediately);

    if (belowFold.length > 0) {
      // Never set visibility:hidden (autoAlpha) on focusable sections; use opacity + gentle translate only
      gsap.set(belowFold, { opacity: 0, y: 14 });
      ScrollTrigger.batch(belowFold, {
        onEnter: (batch) =>
          gsap.to(batch, {
            opacity: 1,
            y: 0,
            duration: 0.45,
            stagger: 0.04,
            ease: 'power2.out',
            overwrite: true,
            onComplete: () =>
              batch.forEach((el) => {
                (el as HTMLElement).style.willChange = 'auto';
                el.classList.add('reveal-visible');
              }),
          }),
        start: 'top 92%',
        once: true,
      });

      // Fallback safety reveal if user jumps via scrollbar/hash
      setTimeout(() => {
        belowFold.forEach((el) => {
          if (parseFloat(window.getComputedStyle(el).opacity) < 0.2) {
            const rect = el.getBoundingClientRect();
            if (rect.top < window.innerHeight * 1.05) {
              revealElementImmediately(el);
            }
          }
        });
        ScrollTrigger.refresh();
      }, 650);
    }

    // Subtle portrait parallax on desktop only
    const isMobileParallax = window.innerWidth < 768 || window.matchMedia('(pointer: coarse)').matches;
    if (!isMobileParallax) {
      const parallaxImgs = gsap.utils.toArray<HTMLElement>('.portrait-panel img');
      parallaxImgs.forEach((img) => {
        if (img.dataset.parallaxInit) return;
        img.dataset.parallaxInit = '1';
        const triggerEl = img.closest('section') || img;
        gsap.to(img, {
          yPercent: -4,
          ease: 'none',
          scrollTrigger: {
            trigger: triggerEl,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 0.8,
          },
        });
      });
    }
  }

  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((st) => st.kill());
    if (lenis) {
      try {
        lenis.destroy();
      } catch {}
      lenis = null;
    }
    if (updateLenis) {
      gsap.ticker.remove(updateLenis);
      updateLenis = null;
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLenis);
  } else {
    initLenis();
  }
  document.addEventListener('astro:page-load', initLenis);
  document.addEventListener('astro:after-swap', () => ScrollTrigger.refresh());
</script>

<style is:global>
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis.lenis-smooth {
    scroll-behavior: auto !important;
  }
  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }
  .lenis.lenis-stopped {
    overflow: hidden;
  }
  .lenis.lenis-scrolling iframe {
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
