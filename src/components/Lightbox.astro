---
// Lightbox - click or activate any [data-lightbox] item to view fullscreen with caption
// Accessible modal dialog: toggles aria-hidden, traps Tab focus, and restores focus on close.
---

<div id="lightbox" class="lightbox" aria-hidden="true" inert role="dialog" aria-modal="true" aria-label="Image preview">
  <button type="button" class="lightbox-close" aria-label="Close image preview" data-lightbox-close>✕</button>
  <div class="lightbox-content">
    <div id="lightbox-media" class="lightbox-media"></div>
    <p id="lightbox-caption" class="lightbox-caption"></p>
  </div>
  <button type="button" class="lightbox-nav lightbox-prev" aria-label="Previous image" data-lightbox-prev>‹</button>
  <button type="button" class="lightbox-nav lightbox-next" aria-label="Next image" data-lightbox-next>›</button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(12, 10, 10, 0.96);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    padding: 2rem;
  }
  .lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }
  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    transform: scale(0.96);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .lightbox.is-open .lightbox-content {
    transform: scale(1);
  }
  .lightbox-media :global(img) {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6);
  }
  .lightbox-caption {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ecru);
    text-align: center;
    max-width: 60ch;
  }
  .lightbox-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: rgba(28, 22, 20, 0.85);
    border: 1px solid rgba(239, 230, 216, 0.22);
    color: var(--ecru);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    z-index: 10;
  }
  .lightbox-close:hover {
    border-color: var(--brass);
    background: rgba(28, 22, 20, 0.96);
    transform: scale(1.05);
  }
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    background: rgba(28, 22, 20, 0.85);
    border: 1px solid rgba(239, 230, 216, 0.22);
    color: var(--ecru);
    font-size: 1.9rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
    z-index: 10;
  }
  .lightbox-nav:hover {
    border-color: var(--brass);
    background: rgba(28, 22, 20, 0.96);
    transform: translateY(-50%) scale(1.05);
  }
  .lightbox-prev { left: 1.5rem; }
  .lightbox-next { right: 1.5rem; }
  @media (max-width: 640px) {
    .lightbox-nav { width: 44px; height: 44px; font-size: 1.5rem; }
    .lightbox-prev { left: 0.75rem; }
    .lightbox-next { right: 0.75rem; }
    .lightbox-close { top: 0.75rem; right: 0.75rem; }
    .lightbox { padding: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-content { transform: none; transition: none; }
    .lightbox { transition: opacity 0.14s ease; }
  }
</style>

<script>
  import { getSound } from '../lib/sound';

  interface LightboxItem {
    src: string;
    caption: string;
  }

  let lightboxImages: LightboxItem[] = [];
  let currentIndex = 0;
  let lastTrigger: HTMLElement | null = null;

  function initLightbox() {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLightbox, { once: true });
      return;
    }

    const lightbox = document.getElementById('lightbox');
    const lightboxMedia = document.getElementById('lightbox-media');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const closeBtn = lightbox?.querySelector('[data-lightbox-close]') as HTMLButtonElement | null;
    const prevBtn = lightbox?.querySelector('[data-lightbox-prev]') as HTMLButtonElement | null;
    const nextBtn = lightbox?.querySelector('[data-lightbox-next]') as HTMLButtonElement | null;
    if (!lightbox || !lightboxMedia || !lightboxCaption) return;

    if (lightbox.dataset.bound === '1') return;
    lightbox.dataset.bound = '1';

    let lightboxImg: HTMLImageElement | null = null;
    const focusables = [closeBtn, prevBtn, nextBtn].filter(Boolean) as HTMLElement[];

    function collectImages() {
      lightboxImages = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]')).map((el) => ({
        src: el.dataset.src || el.querySelector('img')?.currentSrc || el.querySelector('img')?.src || '',
        caption: el.dataset.caption || el.querySelector('figcaption')?.textContent?.trim() || el.querySelector('img')?.alt || '',
      }));
    }

    function updateLightbox() {
      const item = lightboxImages[currentIndex];
      if (!item || !lightboxMedia || !lightboxCaption) return;
      if (!lightboxImg) {
        lightboxImg = document.createElement('img');
        lightboxImg.id = 'lightbox-img';
        lightboxImg.decoding = 'async';
        lightboxMedia.appendChild(lightboxImg);
      }
      lightboxImg.src = item.src;
      lightboxImg.alt = item.caption || 'Gallery preview';
      lightboxCaption.textContent = item.caption || '';
      const hasMany = lightboxImages.length > 1;
      if (prevBtn) prevBtn.hidden = !hasMany;
      if (nextBtn) nextBtn.hidden = !hasMany;
    }

    function openLightbox(index: number, trigger?: HTMLElement | null) {
      collectImages();
      if (lightboxImages.length === 0 || !lightbox) return;
      lastTrigger = trigger || (document.activeElement as HTMLElement | null);
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      lightbox.removeAttribute('inert');
      document.body.style.overflow = 'hidden';
      document.addEventListener('keydown', onKeydown);
      getSound().playOpen();
      requestAnimationFrame(() => closeBtn?.focus());
    }

    function closeLightbox() {
      if (!lightbox || !lightbox.classList.contains('is-open')) return;
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      lightbox.setAttribute('inert', '');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      getSound().playClose();
      if (lastTrigger && document.contains(lastTrigger)) {
        lastTrigger.focus();
      }
      lastTrigger = null;
    }

    function navigate(dir: -1 | 1) {
      if (lightboxImages.length <= 1) return;
      currentIndex = (currentIndex + dir + lightboxImages.length) % lightboxImages.length;
      updateLightbox();
      getSound().playStep(dir);
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        navigate(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        navigate(1);
      } else if (e.key === 'Tab') {
        const activeFocusables = focusables.filter((el) => !el.hidden);
        if (activeFocusables.length === 0) return;
        const first = activeFocusables[0];
        const last = activeFocusables[activeFocusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    if (document.documentElement.dataset.lightboxDelegate !== '1') {
      document.documentElement.dataset.lightboxDelegate = '1';
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const trigger = target?.closest<HTMLElement>('[data-lightbox]');
        if (!trigger) return;
        const all = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]'));
        const index = all.indexOf(trigger);
        if (index >= 0) {
          window.dispatchEvent(new CustomEvent('portfolio:open-lightbox', { detail: { index, trigger } }));
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const target = e.target as HTMLElement | null;
        const trigger = target?.closest<HTMLElement>('[data-lightbox]');
        if (!trigger || trigger.tagName === 'A' || trigger.tagName === 'BUTTON') return;
        e.preventDefault();
        const all = Array.from(document.querySelectorAll<HTMLElement>('[data-lightbox]'));
        const index = all.indexOf(trigger);
        if (index >= 0) {
          window.dispatchEvent(new CustomEvent('portfolio:open-lightbox', { detail: { index, trigger } }));
        }
      });
    }

    const onOpenEvent = (e: Event) => {
      const detail = (e as CustomEvent<{ index: number; trigger: HTMLElement }>).detail;
      if (detail) openLightbox(detail.index, detail.trigger);
    };
    window.addEventListener('portfolio:open-lightbox', onOpenEvent);

    closeBtn?.addEventListener('click', closeLightbox);
    prevBtn?.addEventListener('click', () => navigate(-1));
    nextBtn?.addEventListener('click', () => navigate(1));
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('portfolio:open-lightbox', onOpenEvent);
        document.removeEventListener('keydown', onKeydown);
        document.body.style.overflow = '';
      },
      { once: true },
    );
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
  document.addEventListener('astro:after-swap', initLightbox);
</script>
