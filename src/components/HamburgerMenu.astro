---
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const siteContent = (await getCollection('site'))[0]?.data;

const orderPriority: Record<string, number> = {
  'silent-lifts-vitosha': 1,
  'lunen-blyasak': 2,
  'zasnet': 3,
  'remake-season-2': 4,
  'eastern-wind': 5,
};

const films = [...projects].sort((a, b) => {
  const priorityA = orderPriority[a.data.slug] ?? 999;
  const priorityB = orderPriority[b.data.slug] ?? 999;
  return priorityA - priorityB;
});

const mainLinks = siteContent?.nav || [];

const jobs = (siteContent as any)?.commercial?.jobs || [];
const companies = jobs.map((j: any) => ({
  slug:
    j.detail?.slug ||
    (j.org.includes('7Arts') ? '7arts-artportal' : j.org.includes('Timeless') ? 'timeless-production' : 'tdb-play'),
  org: j.org,
  role: j.role,
  years: j.years,
}));
---

<button
  type="button"
  id="hamburger-btn"
  class="hamburger"
  aria-label="Open navigation menu"
  aria-expanded="false"
  aria-controls="site-menu"
  data-cursor-hover
  data-cursor-label="MENU"
>
  <span class="hamburger-box" aria-hidden="true">
    <span class="hamburger-line line-1"></span>
    <span class="hamburger-line line-2"></span>
  </span>
  <span class="hamburger-text">Menu</span>
</button>

<div
  id="site-menu"
  class="site-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Site navigation"
  aria-hidden="true"
  inert
>
  <div class="menu-backdrop" data-menu-close></div>
  <div class="menu-panel">
    <div class="menu-header">
      <div class="menu-brand">
        <span class="menu-brand-dot" aria-hidden="true"></span>
        <span>Mihail Mihaylov · Index</span>
      </div>
      <button
        type="button"
        class="menu-close"
        aria-label="Close navigation menu"
        data-menu-close
        data-cursor-hover
        data-cursor-label="CLOSE"
      >
        ✕
      </button>
    </div>

    <div class="menu-body">
      <nav class="menu-sections" aria-label="Menu sections">
        <span class="menu-kicker">Jump to section</span>
        <div class="menu-pills">
          {mainLinks.map((l) => (
            <a href={l.href} class="menu-pill" data-menu-link data-cursor-hover>
              {l.label}
            </a>
          ))}
          <a href="/projects" class="menu-pill menu-pill--accent" data-menu-link data-cursor-hover>
            All work library →
          </a>
        </div>
      </nav>

      <div class="menu-columns">
        <nav class="menu-col" aria-label="Films">
          <span class="menu-kicker">Films &amp; TV</span>
          <ul>
            {films.map((f) => {
              const film = f.data;
              return (
                <li>
                  <a href={`/projects/${film.slug}`} class="menu-item" data-menu-link data-cursor-hover data-cursor-label="OPEN">
                    <span class="menu-num">{film.index}</span>
                    <span class="menu-item-body">
                      <span class="menu-item-title">
                        {film.slug === 'silent-lifts-vitosha' ? film.titleEn : film.title}
                      </span>
                      <span class="menu-item-sub">
                        {film.kicker} · {film.year}
                      </span>
                    </span>
                    <span class="menu-item-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>

        <nav class="menu-col" aria-label="Productions">
          <span class="menu-kicker">Commercial &amp; Broadcast</span>
          <ul>
            {companies.map((job: any, i: number) => (
              <li>
                <a href={`/companies/${job.slug}`} class="menu-item" data-menu-link data-cursor-hover data-cursor-label="OPEN">
                  <span class="menu-num">C{i + 1}</span>
                  <span class="menu-item-body">
                    <span class="menu-item-title">{job.org}</span>
                    <span class="menu-item-sub">
                      {job.role} · {job.years}
                    </span>
                  </span>
                  <span class="menu-item-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </div>

    <div class="menu-footer">
      <span>Sofia, Bulgaria</span>
      <div class="menu-social">
        <a href={`mailto:${siteContent?.contact?.email || 'mohailmihaylov2004@gmail.com'}`} data-cursor-hover>
          Email
        </a>
        <a
          href={siteContent?.contact?.instagram || 'https://www.instagram.com/mihail.m4307/'}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor-hover
        >
          Instagram
        </a>
        <a
          href={siteContent?.contact?.linkedin || 'https://www.linkedin.com/in/mihail-mihaylov-bb0238247/'}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor-hover
        >
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .hamburger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 44px;
    min-width: 44px;
    padding: 0 0.95rem;
    border-radius: 999px;
    background: rgba(28, 22, 20, 0.55);
    border: 1px solid var(--border-subtle);
    color: var(--ecru);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }
  .hamburger:hover {
    border-color: var(--brass);
    color: var(--brass);
  }
  .hamburger[aria-expanded='true'] {
    border-color: var(--brass);
    background: rgba(212, 162, 76, 0.12);
    color: var(--brass);
  }
  .hamburger-box {
    position: relative;
    width: 16px;
    height: 8px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .hamburger-line {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), width 0.25s ease;
    transform-origin: center;
  }
  .hamburger-line.line-2 {
    width: 11px;
    align-self: flex-end;
  }
  .hamburger:hover .hamburger-line.line-2 {
    width: 16px;
  }
  .hamburger[aria-expanded='true'] .line-1 {
    transform: translateY(3.25px) rotate(45deg);
  }
  .hamburger[aria-expanded='true'] .line-2 {
    width: 16px;
    transform: translateY(-3.25px) rotate(-45deg);
  }
  .hamburger-text {
    font-weight: 600;
  }

  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: flex-end;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .site-menu.is-open {
    pointer-events: auto;
    opacity: 1;
  }
  .menu-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 9, 8, 0.68);
    backdrop-filter: blur(8px) saturate(1.08);
  }
  .menu-panel {
    position: relative;
    width: min(720px, 95vw);
    height: 100%;
    background:
      radial-gradient(ellipse 460px 260px at 90% 4%, rgba(212, 162, 76, 0.08), transparent 64%),
      linear-gradient(175deg, #1f1916 0%, #15100e 100%);
    border-left: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.42s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow: -24px 0 60px rgba(0, 0, 0, 0.55);
  }
  .site-menu.is-open .menu-panel {
    transform: translateX(0);
  }

  .menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    position: sticky;
    top: 0;
    background: rgba(27, 21, 19, 0.92);
    backdrop-filter: blur(10px);
    z-index: 2;
  }
  .menu-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ecru);
  }
  .menu-brand-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brass);
  }
  .menu-close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(28, 22, 20, 0.65);
    border: 1px solid var(--border-subtle);
    color: var(--ecru);
    font-size: 1rem;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .menu-close:hover {
    border-color: var(--brass);
    color: var(--brass);
    background: rgba(212, 162, 76, 0.1);
  }

  .menu-body {
    flex: 1;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.85rem;
  }

  .menu-kicker {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brass);
    display: block;
    margin-bottom: 0.85rem;
  }

  .menu-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .menu-pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background: rgba(28, 22, 20, 0.55);
    color: var(--ecru);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .menu-pill:hover {
    border-color: var(--brass);
    color: var(--brass);
  }
  .menu-pill--accent {
    border-color: rgba(212, 162, 76, 0.45);
    color: var(--brass);
    background: rgba(212, 162, 76, 0.08);
  }
  .menu-pill--accent:hover {
    background: var(--brass);
    color: var(--ink);
  }

  .menu-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-soft);
  }
  @media (max-width: 680px) {
    .menu-columns {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  .menu-col {
    min-width: 0;
  }
  .menu-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 54px;
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .menu-item:hover,
  .menu-item:focus-visible {
    background: rgba(239, 230, 216, 0.045);
    border-color: var(--border-subtle);
  }
  .menu-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--brass);
    min-width: 1.85rem;
    flex-shrink: 0;
  }
  .menu-item-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .menu-item-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.94rem;
    color: var(--ecru);
    line-height: 1.2;
    transition: color 0.2s ease;
  }
  .menu-item:hover .menu-item-title {
    color: var(--brass);
  }
  .menu-item-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ash);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .menu-item-arrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ash);
    opacity: 0.55;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), color 0.2s ease, opacity 0.2s ease;
  }
  .menu-item:hover .menu-item-arrow {
    color: var(--brass);
    opacity: 1;
    transform: translateX(3px);
  }

  .menu-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.9rem 1.5rem;
    border-top: 1px solid var(--border-soft);
    background: rgba(18, 14, 12, 0.55);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .menu-social {
    display: flex;
    gap: 1.1rem;
  }
  .menu-social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ecru);
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .menu-social a:hover {
    color: var(--brass);
    border-color: var(--brass);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-panel {
      transition: none;
    }
    .site-menu {
      transition: opacity 0.14s ease;
    }
  }
</style>

<script>
  import { getSound } from '../lib/sound';

  function initHamburger() {
    const btn = document.getElementById('hamburger-btn') as HTMLButtonElement | null;
    const menu = document.getElementById('site-menu') as HTMLElement | null;
    if (!btn || !menu) return;

    if (menu.parentElement !== document.body) {
      document.body.appendChild(menu);
    }
    const cursor = document.getElementById('custom-cursor');
    if (cursor && cursor.parentElement === document.body) {
      document.body.appendChild(cursor);
    }
    if (btn.dataset.bound === '1') return;
    btn.dataset.bound = '1';

    const closeEls = menu.querySelectorAll('[data-menu-close]');
    const links = menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');

    const getFocusables = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      );

    function onKeydown(e: KeyboardEvent) {
      if (!menu || !menu.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const list = getFocusables();
        if (!list.length) return;
        const first = list[0];
        const last = list[list.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    function open() {
      if (!btn || !menu) return;
      btn.setAttribute('aria-expanded', 'true');
      menu.setAttribute('aria-hidden', 'false');
      menu.removeAttribute('inert');
      menu.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKeydown);
      getSound().playOpen();
      const first =
        menu.querySelector<HTMLElement>('.menu-close') || menu.querySelector<HTMLElement>('[data-menu-link]');
      first?.focus();
    }

    function close() {
      if (!btn || !menu || !menu.classList.contains('is-open')) return;
      btn.setAttribute('aria-expanded', 'false');
      menu.setAttribute('aria-hidden', 'true');
      menu.setAttribute('inert', '');
      menu.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      getSound().playClose();
      btn.focus();
    }

    btn.addEventListener('click', () => {
      if (menu.classList.contains('is-open')) close();
      else open();
    });
    closeEls.forEach((el) => el.addEventListener('click', close));
    links.forEach((a) =>
      a.addEventListener('click', () => {
        close();
        const href = a.getAttribute('href');
        if (href && href.startsWith('/#')) {
          const id = href.replace('/', '');
          setTimeout(() => {
            const target = document.querySelector<HTMLElement>(id);
            const lenis = (window as any).__LENIS__;
            if (target && lenis) lenis.scrollTo(target, { offset: -72 });
          }, 260);
        }
      }),
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', onKeydown);
        document.documentElement.style.overflow = '';
      },
      { once: true },
    );
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHamburger);
  else initHamburger();
  document.addEventListener('astro:page-load', initHamburger);
  document.addEventListener('astro:after-swap', initHamburger);
</script>
