---
interface ExperienceItem {
  url: string;
  thumb: string;
  label: string;
  isVertical?: boolean;
}

interface Props {
  title: string;
  meta: string;
  items: ExperienceItem[];
}

const { title, meta, items } = Astro.props;
const hasVertical = items.some(item => item.isVertical);
---
<div class="exp-card" data-reveal>
  <div class="exp-header">
    <h3 class="exp-title">{title}</h3>
    <span class="exp-meta">{meta}</span>
  </div>
  
  <div class="exp-grid" style={hasVertical ? "grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));" : ""}>
    {items.map((item) => (
      <div>
        <a href={item.url} target="_blank" rel="noopener noreferrer" class={item.isVertical ? "exp-thumb-vertical" : "exp-thumb"}>
          <img src={item.thumb} alt={item.label}>
        </a>
        <span class="exp-label">{item.label}</span>
      </div>
    ))}
  </div>
</div>