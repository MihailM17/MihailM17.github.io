---
interface Props {
  kicker: string;
  title: string;
  url: string;
  bgText: string;
  thumb: string;
  synopsis: string;
}
const { kicker, title, url, bgText, thumb, synopsis } = Astro.props;
---
<article class="case-card" data-reveal>
  <span class="case-kicker">{kicker}</span>
  <h3 class="case-title">
    <a href={url} target="_blank" rel="noopener noreferrer">{title}</a>
  </h3>
  <p class="case-title-bg">{bgText}</p>
  <div class="case-grid">
    <div class="reel-frame">
      <a href={url} target="_blank" rel="noopener noreferrer">
        <img src={thumb} alt={`${title} Thumbnail`} style="width:100%; height:100%; object-fit:cover; position:absolute; inset:0;">
      </a>
    </div>
    <div class="case-copy">
      <p class="case-synopsis">{synopsis}</p>
    </div>
  </div>
</article>